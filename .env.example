# Template for required environment variables - copy to .env and fill in
#
# LLM backend: any OpenAI-compatible chat completions endpoint. Swapping
# providers is a matter of changing these three lines, nothing in the code.
#
# --- Option A: self-hosted vLLM (e.g. SLURM job on an HPC GPU node) ---
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
LLM_API_KEY=not-needed
#
# --- Option B: Groq hosted API (its endpoint is OpenAI-compatible too) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL_NAME=llama-3.1-8b-instant
# LLM_API_KEY=<your Groq API key>
