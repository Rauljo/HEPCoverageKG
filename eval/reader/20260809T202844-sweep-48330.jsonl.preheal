{"qid": "gf-05", "paper_id": "2004.01678", "answer": true, "unanimous": true, "quote": "Hadronic decays of an ηc or of a J/ψ charmonium resonance ( Q ), or of a light spin-0 boson from an extended Higgs sector with a mass up to 4 GeV , are considered and are reconstructed as a single jet.", "answers": [], "votes": {"False": 2, "True": 1}, "escalated": true, "sections_read": [" + Body ¶1 + Body ¶2 + Body ¶3 + Body ¶4 + Body ¶5 + Body ¶6 + Body ¶7 + Body ¶8 + Body ¶9"], "verdicts": [{"paper_id": "2004.01678", "qid": "gf-05", "answer": null, "quote": "", "quote_verified": false, "reasoning": "", "answer_text": "", "section": " + Body ¶1 + Body ¶2 + Body ¶3 + Body ¶4 + Body ¶5 + Body ¶6 + Body ¶7 + Body ¶8 + Body ¶9", "window": 0, "escalated": true, "raw": "```json\n{\"answer\": \"yes\", \"quote\": \"Hadronic decays of an $\\eta_{c}$ or of a $J/\\psi$ charmonium resonance ( $Q$ ), or of a light spin-0 boson from an extended Higgs sector with a mass up to 4 GeV , are considered and are reconstructed as a single jet.\", \"why\": \"The text explicitly states that hadronic decays of certain resonances are reconstructed as a single jet.\"}\n```"}, {"paper_id": "2004.01678", "qid": "gf-05", "answer": true, "quote": "Hadronic decays of an ηc or of a J/ψ charmonium resonance ( Q ), or of a light spin-0 boson from an extended Higgs sector with a mass up to 4 GeV , are considered and are reconstructed as a single jet.", "quote_verified": true, "reasoning": "The text explicitly states that hadronic decays are reconstructed as a single jet.", "answer_text": "", "section": " + Body ¶1 + Body ¶2 + Body ¶3 + Body ¶4 + Body ¶5 + Body ¶6 + Body ¶7 + Body ¶8 + Body ¶9", "window": 0, "escalated": true, "raw": "```json\n{\"answer\": \"yes\", \"quote\": \"Hadronic decays of an ηc or of a J/ψ charmonium resonance ( Q ), or of a light spin-0 boson from an extended Higgs sector with a mass up to 4 GeV , are considered and are reconstructed as a single jet.\", \"why\": \"The text explicitly states that hadronic decays are reconstructed as a single jet.\"}\n```"}, {"paper_id": "2004.01678", "qid": "gf-05", "answer": null, "quote": "", "quote_verified": false, "reasoning": "", "answer_text": "", "section": " + Body ¶1 + Body ¶2 + Body ¶3 + Body ¶4 + Body ¶5 + Body ¶6 + Body ¶7 + Body ¶8 + Body ¶9", "window": 0, "escalated": true, "raw": "```json\n{\"answer\": \"yes\", \"quote\": \"Hadronic decays of an $\\eta_{c}$ or of a $J/\\psi$ charmonium resonance ( $Q$ ), or of a light spin-0 boson from an extended Higgs sector with a mass up to 4 GeV , are considered and are reconstructed as a single jet.\", \"why\": \"The text explicitly states that hadronic decays of resonances are reconstructed as a single jet.\"}\n```"}]}
