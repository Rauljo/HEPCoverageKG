ulation_estimate", "why": "This method provides a direct simulation-based estimate for minor backgrounds, which is not the discrete profiling method."}, {"id": "hepkg:method:misid_factor_method", "why": "This method estimates misidentification factors, which is not the discrete profiling method."}, {"id": "hepkg:method:fake-factor", "why": "This method uses fake factors, which is not the discrete profiling method."}, {"id": "hepkg:method:sim_scaled_cr_fit", "why": "This method scales simulated shapes by a simultaneous fit over background control regions, which is not the discrete profiling method."}, {"id": "hepkg:method:cr-transfer-factor-top", "why": "This method uses the R_top method, which is not the discrete profiling method."}, {"id": "hepkg:method:cr-transfer-factor-w", "why": "This method uses the R_W method, which is not the discrete profiling method."}, {"id": "hepkg:method:dedicated_control_regions", "why": "This method constrains background normalization and shape using control regions, which is not the discrete profiling method."}]}], "recovered_calls": 0, "cited": "", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 77.2312424723059, "llm_calls": 4.0, "tokens": 24768.0, "rounds": 4.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "set_precision": 0.16666666666666666, "set_recall": 1.0, "set_f1": 0.2857142857142857, "set_named_none": 0.0, "retrieval_reach": 1.0, "tool_calls": 3.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 70.0, "evidence_quotes": 5.0}}
