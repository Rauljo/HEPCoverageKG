rged", "why": "This is a different systematic uncertainty related to QCD multijet transfer factor, not color reconnection."}, {"id": "hepkg:systematic:rw-jes", "why": "This is a different systematic uncertainty related to jet energy scale, not color reconnection."}, {"id": "hepkg:systematic:qcd-normalization", "why": "This is a different systematic uncertainty related to QCD multijet normalization, not color reconnection."}, {"id": "hepkg:systematic:ww-gluon-fraction", "why": "This is a different systematic uncertainty related to the WW gluon-induced component, not color reconnection."}, {"id": "hepkg:systematic:pdf-scale-theory", "why": "This is a different systematic uncertainty related to PDF and QCD scales, not color reconnection."}, {"id": "hepkg:systematic:qcd-scale-theory", "why": "This is a QCD scale uncertainty, not related to color reconnection or MPI models."}, {"id": "hepkg:systematic:diboson_qcd_scale", "why": "This is a QCD scale uncertainty, not related to color reconnection or MPI models."}, {"id": "hepkg:systematic:deepak8-lightqg-score", "why": "This is a specific uncertainty related to the DeepAK8 algorithm, not related to CR or MPI models."}, {"id": "hepkg:systematic:signal-ggf-extrapolation", "why": "This is a theoretical uncertainty related to signal extrapolation, not related to CR or MPI models."}, {"id": "hepkg:systematic:jet_energy_scale", "why": "This is a jet energy scale uncertainty, not related to CR or MPI models."}, {"id": "hepkg:systematic:signal-jes", "why": "This is a jet energy scale uncertainty, not related to CR or MPI models."}, {"id": "hepkg:systematic:qcd_scale_ren_fact", "why": "This is a QCD scale uncertainty, not related to color reconnection or MPI models."}, {"id": "hepkg:systematic:jet_energy_corrections_fastsim", "why": "This is a jet energy scale and resolution uncertainty, not related to CR or MPI models."}, {"id": "hepkg:systematic:qcd-multijet-emu", "why": "This is a QCD multijet estimation uncertainty, not related