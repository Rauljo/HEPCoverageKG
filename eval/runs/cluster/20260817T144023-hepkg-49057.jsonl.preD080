rtainty."}, {"id": "hepkg:systematic:muon_trigger_efficiency", "why": "This is a specific systematic uncertainty related to the trigger scale factors for muons, but not directly related to the L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:ttbar-correction-merged", "why": "This is a specific systematic uncertainty related to the ttbar correction, but not directly related to the L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:charge-flip-datadriven", "why": "This is a specific systematic uncertainty related to charge-flip electron background prediction, but not directly related to the L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:pileup", "why": "This is a specific systematic uncertainty related to pileup correction, but not directly related to the L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:shower_shape_corrections", "why": "This is a specific systematic uncertainty related to shower shape correction, but not directly related to the L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:high-d0-tracking-efficiency", "why": "This is about tracking efficiency uncertainty, not L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:trigger-efficiency", "why": "This is about trigger efficiency correction uncertainty, not L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:btag_efficiency", "why": "This is about b tagging efficiency and misidentification correction uncertainty, not L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:nlo-ew-corrections", "why": "This is about NLO electroweak correction systematic uncertainty, not L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:lepton-energy-scale", "why": "This is about lepton energy scale uncertainty, not L1 ECAL/muon prefiring correction uncertainty."}, {"id": "hepkg:systematic:afp-correction-tota