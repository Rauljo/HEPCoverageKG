0, "dropped": [{"id": "hepkg:method:core-pdf-method-ggh", "why": "This is a different method, specifically a parametric fit for the ggH category."}, {"id": "hepkg:method:mc_simulation", "why": "This is a different method based on simulated events and control region normalization."}, {"id": "hepkg:method:data-mixing-background-estimation", "why": "This is a different method using a data-driven approach and event mixing."}, {"id": "hepkg:method:abcd-method", "why": "This is a different method using the ABCD technique and data-driven approach."}, {"id": "hepkg:method:data_driven_emu_cr", "why": "This is a different method using a data-driven approach and control region normalization for top background."}, {"id": "hepkg:method:matrix-method", "why": "This is a different method using a data-driven approach and matrix method for misidentified leptons."}, {"id": "hepkg:method:simulation_estimate", "why": "This is a different method using direct simulation for background estimation."}, {"id": "hepkg:method:mc-simulation-estimate", "why": "This is a different method using MC simulation for background estimation."}, {"id": "hepkg:method:simulation_based_bkg_estimate", "why": "This is a different method estimating background fraction from simulation."}, {"id": "hepkg:method:data-driven-background-fit", "why": "This is a different method using a data-driven approach and parametric fit to m_{Jγ}."}, {"id": "hepkg:method:profile-likelihood-normalization", "why": "This is a different method using a background-only profile-likelihood fit with control region normalization and event mixing."}, {"id": "hepkg:method:mc-direct-estimate", "why": "This is a different method using direct simulation with fixed normalization and no control region fit."}, {"id": "hepkg:method:template-fit-method-fakes", "why": "This is a different method using a template fit for fake-lepton background normalization."}, {"id": "hepkg:method:data_sideband_fit", "why": "This is a different method using data sidebands of mass distributions for background modeling."}, {"id": "hepkg:method:mc_simulation_estimation", "why": "Uses Monte Carlo simulation, but not specifically discrete profiling for m_gg."}, {"id": "hepkg:method:simulation_estimation", "why": "Uses MC simulation without data-driven corrections, but not discrete profiling for m_gg."}, {"id": "hepkg:method:mc-simulated-template", "why": "Constructs templates from simulation, but not specifically using discrete profiling for m_gg."}, {"id": "hepkg:method:continuum_data_fit", "why": "Models background directly from data, not using discrete profiling for m_gg."}, {"id": "hepkg:method:mc_template", "why": "Uses simulation templates and control region normalisation, but not specifically discrete profiling for m_gg."}, {"id": "hepkg:method:cr-data-driven-normalization", "why": "Data-driven normalization using control regions, not using discrete profiling for m_gg."}, {"id": "hepkg:method:spurious-signal-test", "why": "Tests background functions using spurious signals, not using discrete profiling for m_gg."}, {"id": "hepkg:method:cr_fit_normalization", "why": "Uses control region normalisation via profile likelihood fit, but not specifically discrete profiling for m_gg."}, {"id": "hepkg:method:simulation-based-background-vbf", "why": "Simulation-based background estimation, but not specifically using discrete profiling for m_gg."}, {"id": "hepkg:method:parametric-fit-tth", "why": "Uses parametric fits for background estimation, but not specifically discrete profiling for m_gg."}, {"id": "hepkg:method:mc-reweighting-correction", "why": "Uses MC-based reweighting for m_llj-M correlation, not specifically discrete profiling for m_gg."}, {"id": "hepkg:method:ancillary_category_fit_bkg_constraint", "why": "Constrains background normalization in ML fit, but not using discrete profiling for m_gg."}, {"id": "hepkg:background_method:abcd_data_driven_crs", "why": "Uses ABCD method and parametric fits, but not specifically discrete profiling for m_gg."}, {"id": "hepkg:method:background_estimated_from_data_and_simulation", "why": "Estimates background using both data and simulation, but not specifically using discrete profiling for m_gg."}, {"id": "hepkg:method:signal_analogous_parameterisation", "why": "Models background analogously to signal SMEFT parameterisation, but not specifically using discrete profiling for m_gg."}, {"id": "hepkg:method:normalization-factor-fit-to-data", "why": "This method extracts a normalisation factor but does not specify the use of discrete profiling."}, {"id": "hepkg:method:background_parametrization_fit_to_data", "why": "This method uses parametric functions for background estimation, not discrete profiling."}, {"id": "hepkg:method:parametric-fit-vh", "why": "This method uses parametric fits for background estimation, not discrete profiling."}, {"id": "hepkg:method:transfer_factor_ltau_lprime", "why": "This method uses a data-driven transfer-factor approach, not discrete profiling."}, {"id": "hepkg:method:theoretical_cross_section_normalization", "why": "This method uses theoretical cross-section predictions, not discrete profiling."}, {"id": "hepkg:method:nnlo_kfactor_hnnlo_ggzz", "why": "This method involves a K-factor for background normalization, not discrete profiling."}, {"id": "hepkg:background_method:singletop-svmass-tail-normalization", "why": "This method uses the tail of a distribution for normalization, not discrete profiling."}, {"id": "hepkg:method:data-driven-fnp", "why": "This method uses a data-driven fake-factor/matrix method, not discrete profiling."}, {"id": "hepkg:method:data-driven-fit-normalisation", "why": "This method uses a CR-based fit, which could include discrete profiling, but it is not specified."}, {"id": "hepkg:background_method:cr_normalisation_fit", "why": "This method uses a CR-based fit, which could include discrete profiling, but it is not specified."}, {"id": "hepkg:method:explicit_smeft_parameterisation", "why": "This method uses explicit SMEFT parameterisation/simulation, not discrete profiling."}, {"id": "hepkg:method:data_driven_abcd_ratio", "why": "This method uses the ABCD method, which is a different technique from discrete profiling."}, {"id": "hepkg:method:embedding", "why": "This method uses the embedding method, not discrete profiling."}, {"id": "hepkg:method:qcd_misidentification_factor", "why": "This method uses the MF method for fake lepton estimation, not discrete profiling."}, {"id": "hepkg:method:fixed-to-sm-prediction", "why": "This method uses a fixed background from SM MC with a normalisation uncertainty, which is not the discrete profiling method."}, {"id": "hepkg:method:background_particle_level_classification", "why": "This method classifies background components at the particle level, which is not related to the discrete profiling method."}, {"id": "hepkg:background_method:mc-simulation-validated-control-samples", "why": "This method evaluates background contributions using simulations validated in data control samples, which is not the discrete profiling method."}, {"id": "hepkg:method:mc-simulation-only", "why": "This method determines background from MC simulation without data-driven normalisation, which is not the discrete profiling method."}, {"id": "hepkg:method:control_region_validation", "why": "This method validates background templates and systematic uncertainties using control regions, which is not the discrete profiling method."}, {"id": "hepkg:method:dy_tf_from_z_window", "why": "This method uses data-driven transfer factors from the Z-mass window, which is not the discrete profiling method."}, {"id": "hepkg:method:analytic_background_function_fit", "why": "This method fits an analytic background function constrained by simulated events, which is not the discrete profiling method."}, {"id": "hepkg:method:rgood-cosmic-method", "why": "This method uses the R_good method, which is not the discrete profiling method."}, {"id": "hepkg:method:direct_simulation_estimate", "why": "This method provides a direct simulation-based estimate for minor backgrounds, which is not the discrete profiling method."}, {"id": "hepkg:method:misid_factor_method", "why": "This method estimates misidentification factors, which is not the discrete profiling method."}, {"id": "hepkg:method:fake-factor", "why": "This method uses fake factors, which is not the discrete profiling method."}, {"id": "hepkg:method:sim_scaled_cr_fit", "why": "This method scales simulated shapes by a simultaneous fit over background control regions, which is not the discrete profiling method."}, {"id": "hepkg:method:cr-transfer-factor-top", "why": "This method uses the R_top method, which is not the discrete profiling method."}, {"id": "hepkg:method:cr-transfer-factor-w", "why": "This method uses the R_W method, which is not the discrete profiling method."}, {"id": "hepkg:method:dedicated_control_regions", "why": "This method constrains background normalization and shape using control regions, which is not the discrete profiling method."}]}], "recovered_calls": 0, "cited": "", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 81.21185099799186, "llm_calls": 4.0, "tokens": 24768.0, "rounds": 4.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "set_precision": 0.16666666666666666, "set_recall": 1.0, "set_f1": 0.2857142857142857, "set_named_none": 0.0, "retrieval_reach": 1.0, "tool_calls": 3.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 70.0, "evidence_quotes": 5.0}}
