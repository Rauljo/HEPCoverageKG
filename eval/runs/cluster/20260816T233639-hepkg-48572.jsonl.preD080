xt{TeV}\\)*\n\nThese are the distinct papers that report the specified systematic uncertainty.", "answered": true, "papers": ["2001.06899", "2004.14060", "2006.05880", "2007.02873", "2009.04363", "2010.14293", "2012.01581", "2012.03799", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2111.08340", "2112.00895", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2211.08028", "2303.15340", "2307.01094", "2308.02285", "2309.14442", "2401.05299", "2402.08486", "2403.01556", "2404.06204", "2407.10549", "2408.03744", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044", "2605.14245"], "value": null, "steps": [{"round": 1, "tool": "search", "args": {"text": "Photon energy scale and resolution shape uncertainty", "kind": "systematic_uncertainty"}, "rows": 60, "error": null, "seconds": 30.799}, {"round": 2, "tool": "subjects_of", "args": {"predicate": "result_has_systematic", "object_set": "set_1_kept"}, "rows": 11, "error": null, "seconds": 0.037}, {"round": 3, "tool": "papers_of", "args": {"entity_ids": ["hepkg:result:f30a5987a892a17a8cd2f437", "hepkg:result:5a41a7c7c62ceaef4c046044", "hepkg:result:3ceb5926f4ce82b73c00210b", "hepkg:result:755b77b523c64332ab0fea19", "hepkg:result:c2a8c6c321f85ca4e9620c78", "hepkg:result:f8f2454a11f62d465dc04702", "hepkg:result:61bead068d7011cdb8e37e4c", "hepkg:result:6b87d4fa6369adc316efb3b5", "hepkg:result:8082f0673970bd836137f703"]}, "rows": 9, "error": null, "seconds": 0.01}], "sets": {"set_1": ["hepkg:syst:jer", "hepkg:syst:jes", "hepkg:syst:jet_energy_resolution", "hepkg:syst:jet_energy_scale", "hepkg:syst:muon_energy_scale", "hepkg:systematic:background-shape-fourier", "hepkg:systematic:conversion_normalization_unc", "hepkg:systematic:e-to-tauh-energy-scale", "hepkg:systematic:electron-energy-momentum-scale-resolution", "hepkg:systematic:electron-energy