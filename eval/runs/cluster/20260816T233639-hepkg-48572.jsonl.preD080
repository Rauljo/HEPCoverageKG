oton collisions at $\\sqrt{s}=5.02$ and 13  TeV\n- 2602.18611: Combined measurements and interpretations of Higgs boson production and decay in proton-proton collisions at $\\sqrt{s}=13\\,\\text{Te\\hskip-0.80002ptV}$\n- 2604.27044: Improved results on Higgs boson pair production in the 4 $\\mathup{{{b}}}$ final state", "answered": true, "papers": ["2004.14060", "2006.05880", "2007.02873", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.06956", "2106.01676", "2106.14246", "2109.13808", "2112.03161", "2202.08676", "2205.05120", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2304.08962", "2307.01094", "2308.02285", "2312.04450", "2401.05299", "2401.07090", "2404.06204", "2405.18661", "2408.03744", "2503.19420", "2506.13565", "2510.07527", "2511.11853", "2602.18611", "2604.27044"], "value": null, "steps": [{"round": 1, "tool": "search", "args": {"text": "Charge misidentification background, SS dilepton channel", "kind": "background"}, "rows": 44, "error": null, "seconds": 25.429}, {"round": 2, "tool": "subjects_of", "args": {"predicate": "result_estimates_background", "object_set": "set_1"}, "rows": 84, "error": null, "seconds": 0.041}, {"round": 3, "tool": "papers_of", "args": {"entity_ids": ["hepkg:result:tchannel_singletop_xsec", "hepkg:result:83e9b2efac24614b22b613d8", "hepkg:result:5a41a7c7c62ceaef4c046044", "hepkg:result:755b77b523c64332ab0fea19", "hepkg:result:bbww_lvqq_2l2nu", "hepkg:result:bbzz", "hepkg:result:multilepton", "hepkg:result:c56b160307f064d9155ebd77", "hepkg:result:b5d7a4349aed174d446f3878", "hepkg:result:c2a8c6c321f85ca4e9620c78", "hepkg:result:dbe00b660bc7b95a46e94404", "hepkg:result:c223e8afe1e53690005d65ee", "hepkg:result:8e885d9541438f775548eee6", "hepkg:result:3c55ab19d48206f55f056f4a"]}, "rows": 14, "error": null, "seconds": 0.01}], "sets": {"set_1": ["hepkg:background:bbww_dy", "hepkg:background:bbww_misid_lepton", "hepkg:background:bbzz_zplusx", "hepkg:background:charge-flip-electrons", "hepkg:background:charge-mis