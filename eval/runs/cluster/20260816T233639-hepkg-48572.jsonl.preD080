ounds": 4, "seconds": 74.87137274909765, "reviews": [{"search_text": "Secondary vertex (SV)", "tally": {"exact": 6, "broader": 0, "unrelated": 9}, "kept": 6, "candidates": 15, "defaulted": 0, "calls": 1, "errors": 0, "tail_keep_rate": 0.4, "dropped": [{"id": "hepkg:object:primary_vertex", "why": "a primary vertex | asked: Secondary vertex"}, {"id": "hepkg:object:vertex", "why": "a primary vertex | asked: Secondary vertex"}, {"id": "hepkg:object:ni_candidate_vertex", "why": "a NI vertex | asked: Secondary vertex"}, {"id": "hepkg:object:dielectron_vertex", "why": "a Dielectron vertex | asked: Secondary vertex"}, {"id": "hepkg:object:diphoton-primary-vertex", "why": "a Diphoton primary vertex | asked: Secondary vertex"}, {"id": "hepkg:object:top_quark_candidate_t2", "why": "a secondary top quark candidate | asked: Secondary vertex"}, {"id": "hepkg:object:VR-Z-2F", "why": "a VR^Z_2F | asked: Secondary vertex"}, {"id": "hepkg:object:VR-Z-VV-btag", "why": "a VR^{Z,b-tag}_VV | asked: Secondary vertex"}, {"id": "hepkg:object:VR-Z-VV-njet", "why": "a VR^{Z,n-jet}_VV | asked: Secondary vertex"}]}], "recovered_calls": 0, "cited": "", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 74.87137274909765, "llm_calls": 4.0, "tokens": 30697.0, "rounds": 4.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "set_precision": 0.2, "set_recall": 0.75, "set_f1": 0.31578947368421056, "set_named_none": 0.0, "retrieval_reach": 1.0, "tool_calls": 3.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 44.0, "evidence_quotes": 34.0}}
{"run_id": "20260816T233639-hepkg-48572", "qid": "gen-conceptset-80008fd1", "repeat": 0, "system": "hepkg", "config_hash": "92159134c9c3", "git_sha": "be3072a-dirty", "question": "Which analyses report the systematic uncertainty Color reconnection (CR) model uncertainty (MPI-early-res-on, gluon-move, QCD-inspired)?", "shape": "set", "split": "dev", "needs": ["sql", "merged_entities"], "difficulty": "hard", "answer": {"text": "<tool_call>\n{\"name\": \"answer\", \"arguments\": {\"text\": \"The following analyses report the systematic uncertainty 'Color reconnection (CR) model uncertainty (MPI-early-res-on, gluon-move, QCD-inspired)':\\n\\n- 2001.06899: Measurement of the associated production of a Z boson with charm or bottom quark jets in proton-proton collisions at √s=13 TeV\\n- 2007.02873: Measurements of WH and ZH production in the H→bb̄ decay channel in pp collisions at 13 TeV with the ATLAS detector\\n- 2009.04363: Evidence for Higgs boson decay to a pair of muons\\n- 2103.06956: Measurements of Higgs boson production cross sections and couplings in the diphoton decay channel at √s=13 TeV\\n- 2106.14246: Search for electroweak production of charginos and neutralinos in proton-proton collisions at √s=13 TeV\\n- 2107.12553: Search for chargino-neutralino production in events with Higgs and W bosons using 137 fb⁻¹ of proton-proton collisions at √s=13 TeV\\n- 2112.00895: Measurements of the associated production of a W boson and a charm quark in proton-proton collisions at √s=8 TeV\\n- 2201.11585: Search for invisible decays of the Higgs boson produced via vector boson fusion in proton-proton collisions at √s=13 TeV\\n- 2207.00348: Measurement of the properties of Higgs boson production at √s=13 TeV in the H→γγ channel using 139 fb⁻¹ of pp collision data with the ATLAS experiment\\n- 2208.12095: Evidence for the charge asymmetry in pp→tt̄ production at √s=13 TeV with the ATLAS detector\\n- 2303.15340: Inclusive and differential cross-sections for dilepton tt̄ production measured in √s=13 TeV pp collisions with the ATLAS detector\\n- 2309.14442: Inclusive and differential cross section measurements of tt̄b̄b production in the lepton+jets channel at √s=13 TeV\\n- 2312.04450: Inclusive and differential cross-section measurements of tt̄Z production in pp collisions at √s=13 TeV with the ATLAS detector, including EFT and spin-correlation interpretations\\n- 2402.08486: Differential cross section measurements for the production of top quark pairs and of additional jets using dilepton events from pp collisions at √s=13 TeV\\n- 2403.01556: Search for dark QCD with emerging jets in proton-proton collisions at √s=13 TeV\\n- 2503.19420: Measurements of the production cross-sections of a Higgs boson in association with a vector boson and decaying into WW* with the ATLAS detector at √s=13 TeV\\n- 2508.13900: General search for supersymmetric particles in scenarios with compressed mass spectra using proton-proton collisions at √", "answered": true, "papers": ["2001.06899", "2004.01678", "2004.14060", "2006.05880", "2007.02873", "2009.04363", "2010.14293", "2012.01581", "2012.03799", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2111.08340", "2112.00895", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2207.12246", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2303.15340", "2307.01094", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2403.01556", "2407.10549", "2408.03744", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044", "2605.14245"], "value": null, "steps": [{"round": 1, "tool": "search", "args": {"text": "Color reconnection (CR) model uncertainty (MPI-early-res-on, gluon-move, QCD-inspired)", "kind": "systematic_uncertainty"}, "rows": 60, "error": null, "seconds": 35.008}, {"round": 2, "tool": "subjects_of", "args": {"predicate": "result_h