 1, "tool": "search", "args": {"text": "Charge-flip electron background", "kind": "background"}, "rows": 60, "error": null, "seconds": 30.549}, {"round": 2, "tool": "subjects_of", "args": {"predicate": "result_estimates_background", "object_set": "set_1_kept"}, "rows": 5, "error": null, "seconds": 0.028}, {"round": 3, "tool": "papers_of", "args": {"entity_ids": ["hepkg:result:8e885d9541438f775548eee6", "hepkg:result:ca408cb17d5fce2b056fcc4e", "hepkg:result:8082f0673970bd836137f703", "hepkg:result:46ee77edd095181b02474a60", "hepkg:result:65e536ea4e5f3196d16e8bfc"]}, "rows": 5, "error": null, "seconds": 0.008}], "sets": {"set_1": ["hepkg:background:charge-flip-electrons", "hepkg:background:charge-misid", "hepkg:background:charge_misid", "hepkg:background:continuum_diphoton", "hepkg:background:cosmic-ray-muons-mumu", "hepkg:background:diboson", "hepkg:background:diboson-2lOS", "hepkg:background:diboson-vv", "hepkg:background:diboson_background", "hepkg:background:diboson_vv", "hepkg:background:diphoton_continuum", "hepkg:background:dpe_background", "hepkg:background:drell-yan-tautau", "hepkg:background:fake-hf-leptons", "hepkg:background:fake-nonprompt-leptons", "hepkg:background:feeddown", "hepkg:background:fnp", "hepkg:background:fnp-lepton", "hepkg:background:gamma-jets", "hepkg:background:jets-nonprompt", "hepkg:background:material-conversion", "hepkg:background:mis-id-leptons", "hepkg:background:misid-lepton", "hepkg:background:misid_hadron", "hepkg:background:misid_lepton", "hepkg:background:misid_symmetry_mc", "hepkg:background:multiboson", "hepkg:background:mw_background", "hepkg:background:nonprompt-hf", "hepkg:background:nonprompt-lepton", "hepkg:background:nonprompt-multilepton", "hepkg:background:nonprompt-ssdilepton", "hepkg:background:nonprompt_fake_leptons", "hepkg:background:nonprompt_lepton", "hepkg:background:nonprompt_photon_vh_had", "hepkg:background:partially_reconstructed", "hepkg:background:qcd-multijet-emu", "hepkg:background:qmisid", "hepkg:bac