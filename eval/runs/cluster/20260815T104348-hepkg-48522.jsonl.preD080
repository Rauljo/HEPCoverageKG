conds": 154.02174576325342, "reviews": [{"search_text": "Global Higgs boson signal strength modifier μ = σB(H→WW)/σB(H→WW)_SM", "tally": {"exact": 1, "broader": 9, "unrelated": 50}, "kept": 10, "candidates": 60, "defaulted": 0, "calls": 4, "errors": 0, "tail_keep_rate": 0.0, "dropped": [{"id": "hepkg:observable:mu_inclusive", "why": "This is a different decay channel (H→γγ) and thus not the same observable."}, {"id": "hepkg:observable:mu-inclusive-hgg", "why": "This is a different decay channel (H→γγ) and thus not the same observable."}, {"id": "hepkg:observable:mu-h-fiducial", "why": "This is a different observable, specific to a fiducial volume and not the WW decay channel."}, {"id": "hepkg:observable:observed-significance", "why": "This is a significance measure, not a signal strength modifier."}, {"id": "hepkg:observable:higgs_mass_profiled", "why": "This is a profiled Higgs boson mass, not a signal strength modifier."}, {"id": "hepkg:observable:mu-h-inclusive", "why": "This is a specific signal strength measurement for a particular kinematic region, but not the specific observable asked about."}, {"id": "hepkg:observable:mu-vbf-vh", "why": "This is a signal strength modifier for specific production modes, not the inclusive WW decay mode."}, {"id": "hepkg:observable:mu-h-differential", "why": "This is a signal strength measurement in specific pT bins, not the inclusive WW decay mode."}, {"id": "hepkg:observable:hh_incl_signal_strength", "why": "This is a signal strength for inclusive HH production, not the WW decay mode."}, {"id": "hepkg:observable:mu-z-fiducial-validation", "why": "This is a signal strength validation for Z->bb, not the WW decay mode."}, {"id": "hepkg:observable:mu_by_production_mode", "why": "This is a set of signal strength modifiers for various production modes, not the inclusive WW decay mode."}, {"id": "hepkg:observable:mu_vh_bb", "why": "This is a signal strength modifier for VH production with H→bb, not the WW decay mode."}, {"id": "hepk