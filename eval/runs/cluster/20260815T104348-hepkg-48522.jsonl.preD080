conds": 105.93248266587034, "reviews": [{"search_text": "Global Higgs boson signal strength modifier μ = σB(H→WW)/σB(H→WW)_SM", "tally": {"exact": 1, "broader": 9, "unrelated": 50}, "kept": 10, "candidates": 60, "defaulted": 0, "calls": 4, "errors": 0, "tail_keep_rate": 0.0, "dropped": [{"id": "hepkg:observable:mu_inclusive", "why": "This is a different decay channel (H→γγ) and thus not the same observable."}, {"id": "hepkg:observable:mu-inclusive-hgg", "why": "This is a different decay channel (H→γγ) and thus not the same observable."}, {"id": "hepkg:observable:mu-h-fiducial", "why": "This is a different observable, specific to a fiducial volume and not the WW decay channel."}, {"id": "hepkg:observable:observed-significance", "why": "This is a significance measure, not a signal strength modifier."}, {"id": "hepkg:observable:higgs_mass_profiled", "why": "This is a profiled Higgs boson mass, not a signal strength modifier."}, {"id": "hepkg:observable:mu-h-inclusive", "why": "This is a specific signal strength measurement for a particular kinematic region, but not the specific observable asked about."}, {"id": "hepkg:observable:mu-vbf-vh", "why": "This is a signal strength modifier for specific production modes, not the inclusive WW decay mode."}, {"id": "hepkg:observable:mu-h-differential", "why": "This is a signal strength measurement in specific pT bins, not the inclusive WW decay mode."}, {"id": "hepkg:observable:hh_incl_signal_strength", "why": "This is a signal strength for inclusive HH production, not the WW decay mode."}, {"id": "hepkg:observable:mu-z-fiducial-validation", "why": "This is a signal strength validation for Z->bb, not the WW decay mode."}, {"id": "hepkg:observable:mu_by_production_mode", "why": "This is a set of signal strength modifiers for various production modes, not the inclusive WW decay mode."}, {"id": "hepkg:observable:mu_vh_bb", "why": "This is a signal strength modifier for VH production with H→bb, not the WW decay mode."}, {"id": "hepkg:observable:kappa-lambda", "why": "This is a trilinear self-coupling modifier, not a signal strength modifier for the WW decay mode."}, {"id": "hepkg:observable:mu_wh_bb", "why": "This is a signal strength modifier for WH production with H→bb, not the WW decay mode."}, {"id": "hepkg:observable:mu_zh_bb", "why": "This is a signal strength modifier for ZH production with H→bb, not the WW decay mode."}, {"id": "hepkg:observable:coupling_modifier_effective", "why": "This is a set of effective coupling modifiers, not a signal strength modifier for the WW decay mode."}, {"id": "hepkg:observable:coupling_modifier_resolved", "why": "This is a resolved coupling modifier, not a signal strength modifier for the WW decay mode."}, {"id": "hepkg:observable:abs_y_h", "why": "This is a kinematic distribution, not a signal strength modifier for the WW decay mode."}, {"id": "hepkg:observable:mu_vz_bb", "why": "This is a signal strength for VZ, Z→bb, not the WW decay mode."}, {"id": "hepkg:observable:p-value-mu-h-compatibility", "why": "This is a p-value for the compatibility of differential signal strengths, not a signal strength modifier for the WW decay mode."}, {"id": "hepkg:observable:vhh_signal_strength", "why": "This is a signal strength for a different process (VHH), not the WW decay mode."}, {"id": "hepkg:observable:hh_vbf_signal_strength", "why": "This is a signal strength for a different process (VBF HH), not the WW decay mode."}, {"id": "hepkg:observable:br_h_to_inv", "why": "This is the branching fraction for the Higgs boson decaying invisibly, not the WW decay mode."}, {"id": "hepkg:observable:mbb-spectrum", "why": "This is a kinematic distribution for a dark Higgs boson, not the WW decay mode signal strength."}, {"id": "hepkg:observable:coupling_modifier_ratio", "why": "This is a ratio of Higgs boson coupling modifiers, not the WW decay mode signal strength."}, {"id": "hepkg:observable:mu_vh_bb_dijetmass", "why": "This is a signal strength for a different process (VH b