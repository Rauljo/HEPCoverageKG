{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-4ce2ea98", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "Which background-estimation methods does analysis 2503.19420 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2503.19420 uses the following background-estimation methods:\n\n- Binned maximum-likelihood fit over SR/CR bins with Poisson probability terms\n- Maximum-likelihood fit to determine non-prompt-lepton extrapolation factors\n- Profile likelihood method\n- Test of validity of the asymptotic approximation for confidence intervals\n\nThese methods are used to estimate and validate the background in the analysis.", "answered": true, "papers": ["2503.19420"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2503.19420"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:stat_method:asymptotic-approximation-test", "hepkg:stat_method:binned-maximum-likelihood-fit", "hepkg:stat_method:ml-fit-extrapolation-factors", "hepkg:stat_method:profile-likelihood"], "evidence_ids": ["hepkg:evidence:b3aee1d6f440e1f847560fc8", "hepkg:evidence:d4078439b13dd2c08847e233"], "seen_values": ["2503.1942", "2503.19420", "approximation", "asymptotic", "binned", "bins", "confidence", "determine", "extrapolation", "factors", "fit", "for", "hepkg:stat_method:asymptotic-approximation-test", "hepkg:stat_method:binned-maximum-likelihood-fit", "hepkg:stat_method:ml-fit-extrapolation-factors", "hepkg:stat_method:profile-likelihood", "intervals", "likelihood", "maximum-likelihood", "method", "non-prompt-lepton", "over", "poisson", "probability", "profile", "result_uses_statistical_method", "statistical_method", "terms", "test", "the", "validity", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 8954, "completion