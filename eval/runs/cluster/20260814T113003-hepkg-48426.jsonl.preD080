{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-24f96364", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "Which background-estimation methods does analysis 2004.14060 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2004.14060 uses the following background-estimation methods:\n\n- Asymptotic formulae for limit calculation\n- Binned profile likelihood fit (background-only and exclusion/discovery fits)\n- CL_s prescription for limit setting\n- Discovery fit / profile-likelihood-ratio test with free-floating signal strength\n\nThese methods are used for statistical analysis and background estimation in the paper.", "answered": true, "papers": ["2004.14060", "2012.01581", "2207.12246"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2004.14060"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:method:asymptotic_formulae", "hepkg:method:cls_prescription", "hepkg:method:discovery_fit", "hepkg:method:profile_likelihood_fit"], "evidence_ids": ["hepkg:evidence:0139a742de0beb0186d6090a", "hepkg:evidence:7258a8924d7a28227ac6f162", "hepkg:evidence:8648b5930ae6cd702905f833", "hepkg:evidence:c29ea653f230504eea27a1f4"], "seen_values": ["2004.1406", "2004.14060", "and", "asymptotic", "background-only", "binned", "calculation", "cl_s", "discovery", "exclusion", "fit", "fits", "for", "formulae", "free-floating", "hepkg:method:asymptotic_formulae", "hepkg:method:cls_prescription", "hepkg:method:discovery_fit", "hepkg:method:profile_likelihood_fit", "likelihood", "limit", "prescription", "profile", "profile-likelihood-ratio", "result_uses_statistical_method", "setting", "signal", "statistical_method", "strength", "test", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 8938, "completion_tokens": 127