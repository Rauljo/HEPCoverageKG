{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-1b116b74", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "How many statistical methods does analysis 2103.04956 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2103.04956 uses 4 statistical methods: Asymptotic approach for confidence interval estimation, One-dimensional unbinned maximum likelihood fit to m4l for fiducial cross section extraction, Profile likelihood ratio test statistic, and Two-dimensional unbinned maximum likelihood fit (m4l and kinematic discriminant D).", "answered": true, "papers": ["2103.04956", "2302.05225"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2103.04956"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.035}], "sets": {}, "entity_ids": ["hepkg:method:1d_unbinned_ml_fit_fiducial", "hepkg:method:2d_unbinned_ml_fit", "hepkg:method:asymptotic_approach", "hepkg:method:profile_likelihood_ratio_test_statistic"], "evidence_ids": ["hepkg:evidence:3ac55c46e3ca50f13cc2c347", "hepkg:evidence:70a9ab660526a264edf8997c", "hepkg:evidence:f1d6e435bb2560559987a925", "hepkg:evidence:f56aa9c76496e1c758e1e1c6"], "seen_values": ["2103.04956", "and", "approach", "asymptotic", "confidence", "cross", "discriminant", "estimation", "extraction", "fiducial", "fit", "for", "hepkg:method:1d_unbinned_ml_fit_fiducial", "hepkg:method:2d_unbinned_ml_fit", "hepkg:method:asymptotic_approach", "hepkg:method:profile_likelihood_ratio_test_statistic", "interval", "kinematic", "likelihood", "m4l", "maximum", "one-dimensional", "profile", "ratio", "result_uses_statistical_method", "section", "statistic", "statistical_method", "test", "two-dimensional", "unbinned"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 9009, "completion_tokens": 330, "rounds": 2, "seconds": 10.6342904777266