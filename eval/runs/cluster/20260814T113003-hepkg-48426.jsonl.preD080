{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-1acd791e", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "How many statistical methods does analysis 2012.01581 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2012.01581 uses 4 statistical methods: Asymptotic approximation for CLs value calculation, CL_s prescription for limit setting, Data-driven ABCD-style ratio method using eight non-overlapping regions (A-H) defined by three near-uncorrelated selection criteria, and Punzi significance figure of merit for selection optimization.", "answered": true, "papers": ["2004.14060", "2012.01581"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2012.01581"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.037}, {"round": 2, "tool": "quotes", "args": {"assertion_id": "hepkg:paper:2012.01581:hepkg:method:asymptotic_approximation"}, "rows": 0, "error": null, "seconds": 0.013}], "sets": {}, "entity_ids": ["hepkg:method:asymptotic_approximation", "hepkg:method:cls_prescription", "hepkg:method:data_driven_abcd_ratio", "hepkg:method:punzi_significance"], "evidence_ids": ["hepkg:evidence:0c254051f12f3331013f227f", "hepkg:evidence:3f5a4093116e720e3a682ce6", "hepkg:evidence:444cb7825b27448507848178", "hepkg:evidence:d70f2ed23821678f1ac86c12"], "seen_values": ["2012.01581", "a-h", "abcd-style", "approximation", "asymptotic", "background_method", "calculation", "cl_s", "cls", "criteria", "data-driven", "defined", "eight", "figure", "for", "hepkg:method:asymptotic_approximation", "hepkg:method:cls_prescription", "hepkg:method:data_driven_abcd_ratio", "hepkg:method:punzi_significance", "limit", "merit", "method", "near-uncorrelated", "non-overlapping", "optimization", "prescription", "punzi", "ratio", "regions", "result_uses_statistical_method", "selection", "setting", "significance", 