{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-5eaf8328", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "How many simulated samples does analysis 2010.14293 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2010.14293 uses 11 simulated samples, including Diboson ($VV$) background sample (Sherpa 2.2.1/2.2.2), SUSY simplified-model signal MC samples (squark/gluino/squark-gluino production), Simulated ttbar sample (POWHEG v2.0), Single top (Wt-channel) background sample, Single top (s-channel) background sample, Single top (t-channel) background sample, W(→ℓν)+jets background sample, Z/γ*(→ℓℓ)+jets background sample, ttbar+W/Z/H background sample, ttbar+WW background sample, and γ+jets background sample.", "answered": true, "papers": ["2010.14293", "2012.03799", "2205.05120", "2308.02285", "2407.10549"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2010.14293"], "predicate": "result_uses_sample"}, "rows": 11, "error": null, "seconds": 0.043}], "sets": {}, "entity_ids": ["hepkg:sample:diboson-sherpa", "hepkg:sample:gamma-jets-sherpa", "hepkg:sample:singletop-s-powheg", "hepkg:sample:singletop-t-powheg", "hepkg:sample:singletop-wt-powheg", "hepkg:sample:susy-signal-simplified", "hepkg:sample:ttbar-powheg", "hepkg:sample:ttv-mg5", "hepkg:sample:ttww-mg5", "hepkg:sample:w-jets-sherpa", "hepkg:sample:z-jets-sherpa"], "evidence_ids": ["hepkg:evidence:1c6f69a5e4d56645a186b5f7", "hepkg:evidence:2056eba2c50b69bcbc1009ad", "hepkg:evidence:3444c66c40fc8a999d8d3b81", "hepkg:evidence:37e450dd1d9152e4205c3035", "hepkg:evidence:3982cbbf2bcc2b24ab75c24f", "hepkg:evidence:39f1e4b1e86c1b6fc1dc72c4", "hepkg:evidence:ab27514009db8a993fddf2aa", "hepkg:evidence:aff4238d974e32d721dcc961", "hepkg:evidence:c494ad5adc170e3cf00822b7", "hepkg:evidence:d2e0db3c8e7f6bef7515e0b6", "hepkg:evidence:dfff2320d96317e6c25bc184", "hepkg: