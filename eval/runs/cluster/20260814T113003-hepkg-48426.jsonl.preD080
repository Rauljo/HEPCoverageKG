{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-05fc2361", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "Which background-estimation methods does analysis 2401.05299 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2401.05299 uses the following background-estimation methods:\n\n- $\\chi^{2}$ compatibility test between unfolded distributions and predictions\n- Asimov dataset closure and bias stress tests of the unfolding procedure\n- Beeston-Barlow \"lite\" technique for limited MC sample-size statistical uncertainties\n- Maximum-likelihood (profile likelihood) fit with Poisson/Gaussian terms and Beeston-Barlow-lite MC-stat nuisances\n- Profile likelihood unfolding (PLU) for particle-level differential cross-sections\n- Statistical bootstrap optimization of regularization strength $\\tau$ via global correlation coefficient\n- Tikhonov (second-derivative) regularization of unfolding\n\nThese methods are used to ensure the robustness and accuracy of the analysis.", "answered": true, "papers": ["2006.05880", "2106.01676", "2111.08340", "2312.04450", "2401.05299"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2401.05299"], "predicate": "result_uses_statistical_method"}, "rows": 7, "error": null, "seconds": 0.038}], "sets": {}, "entity_ids": ["hepkg:method:asimov-closure-test", "hepkg:method:beeston-barlow-lite", "hepkg:method:chi2-compatibility-test", "hepkg:method:profile-likelihood-fit", "hepkg:method:profile-likelihood-unfolding", "hepkg:method:tau-bootstrap-optimization", "hepkg:method:tikhonov-regularisation"], "evidence_ids": ["hepkg:evidence:100411d82a177d30f46f14d8", "hepkg:evidence:26be0dcb2530342eb9d3ab92", "hepkg:evidence:7844f18131a2163b92f29c31", "hepkg:evidence:bc43d77dc3096b1f6fdb5029", "hepkg:evidence:e367c9a2ffd7cd4e6a4383de", "hepkg:evidence:ff656cd740682d4b7fb4db4b"], "seen_values": ["2", "2401.05299", "and", "asimov", "beeston-barlow", "beeston-barlow-lite", "between", "bias", "bootstrap", "chi", "closure", "coefficient", "compatibility", "correlation", "cross-sections", "dataset", "differential", "distributions", "fit", "for", "gaussian", "global", "hepkg:method:asimov-closure-test", "hepkg:method:beeston-barlow-lite", "hepkg:method:chi2-compatibility-test", "hepkg:method:profile-likelihood-fit", "hepkg:method:profile-likelihood-unfolding", "hepkg:method:tau-bootstrap-optimization", "hepkg:method:tikhonov-regularisation", "likelihood", "limited", "lite", "maximum-likelihood", "mc-stat", "nuisances", "optimisation", "particle-level", "plu", "poisson", "predictions", "procedure", "profile", "regularisation", "result_uses_statistical_method", "sample-size", "second-derivative", "statistical", "statistical_method", "strength", "stress", "tau", "technique", "terms", "test", "tests", "the", "tikhonov", "uncertainties", "unfolded", "unfolding", "via", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 9186, "completion_tokens": 198, "rounds": 2, "seconds": 8.368409968912601, "error": ""}, "scores": {"seconds": 8.368409968912601, "llm_calls": 2.0, "tokens": 9384.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "retrieved_label_recall": 0.0, "retrieved_entities": 7.0, "mentioned_label_recall": 0.0, "truncation_loss_labels": 0.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 7.0, "evidence_quotes": 6.0}}
