{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-3fb0b67a", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "Which background-estimation methods does analysis 2201.11585 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2201.11585 uses the following background-estimation methods:\n\n- Asymptotic approximation of the CLs method for 95% CL upper limits\n- Binned maximum likelihood fit across SR and CRs\n- Profile likelihood ratio test statistic\n\nThese methods are used for statistical analysis and background estimation in the paper.", "answered": true, "papers": ["2112.03161", "2201.11585", "2604.21670"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2201.11585"], "predicate": "result_uses_statistical_method"}, "rows": 3, "error": null, "seconds": 0.033}], "sets": {}, "entity_ids": ["hepkg:method:binned_ml_fit", "hepkg:method:cls_asymptotic", "hepkg:method:profile_likelihood_ratio"], "evidence_ids": ["hepkg:evidence:a268268f760605dee91d543b"], "seen_values": ["2201.11585", "95", "across", "and", "approximation", "asymptotic", "binned", "cls", "crs", "fit", "for", "hepkg:method:binned_ml_fit", "hepkg:method:cls_asymptotic", "hepkg:method:profile_likelihood_ratio", "likelihood", "limits", "maximum", "method", "profile", "ratio", "result_uses_statistical_method", "statistic", "statistical_method", "test", "the", "upper"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 8873, "completion_tokens": 116, "rounds": 2, "seconds": 4.461671965196729, "error": ""}, "scores": {"seconds": 4.461671965196729, "llm_calls": 2.0, "tokens": 8989.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "retrieved_label_recall": 0.0, "retrieved_entities": 3.0, "mentioned_label_r