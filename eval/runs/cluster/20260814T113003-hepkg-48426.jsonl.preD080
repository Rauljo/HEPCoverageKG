{"run_id": "20260814T113003-hepkg-48426", "qid": "gen-paper-0e9f544b", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "f506821-dirty", "question": "Which statistical methods does analysis 2012.01581 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2012.01581 uses the following statistical methods:\n\n- Asymptotic approximation for CLs value calculation\n- CL_s prescription for limit setting\n- Punzi significance figure of merit for selection optimization\n\nAdditionally, it uses a data-driven ABCD-style ratio method for background estimation.\n\nThese methods were identified from the paper's content.", "answered": true, "papers": ["2004.14060", "2012.01581"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2012.01581"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:method:asymptotic_approximation", "hepkg:method:cls_prescription", "hepkg:method:data_driven_abcd_ratio", "hepkg:method:punzi_significance"], "evidence_ids": ["hepkg:evidence:0c254051f12f3331013f227f", "hepkg:evidence:3f5a4093116e720e3a682ce6", "hepkg:evidence:444cb7825b27448507848178", "hepkg:evidence:d70f2ed23821678f1ac86c12"], "seen_values": ["2012.01581", "a-h", "abcd-style", "approximation", "asymptotic", "background_method", "calculation", "cl_s", "cls", "criteria", "data-driven", "defined", "eight", "figure", "for", "hepkg:method:asymptotic_approximation", "hepkg:method:cls_prescription", "hepkg:method:data_driven_abcd_ratio", "hepkg:method:punzi_significance", "limit", "merit", "method", "near-uncorrelated", "non-overlapping", "optimization", "prescription", "punzi", "ratio", "regions", "result_uses_statistical_method", "selection", "setting", "significance", "statistical_method", "three", "using", "value"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens":