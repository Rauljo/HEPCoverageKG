{"run_id": "20260830T111332-free-sql-168561", "qid": "gabriel-gf-03", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses use the HistFitter framework for their statistical analysis?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Four analyses use the HistFitter framework for their statistical analysis: 2006.05880 (HistFitter statistical framework / profile likelihood fit in HistFitter), 2011.07812 (HistFitter package with Gaussian nuisance parameters), 2106.01676 (profile log-likelihood fit implemented in HistFitter, simultaneous on CRs and SRs; its final combination used pyhf validated against HistFitter), and 2211.08028 (profile likelihood background-only fit implemented in HistFitter).", "answered": true, "papers": ["2006.05880", "2011.07812", "2106.01676", "2211.08028"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "HistFitter"}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:method:profile-likelihood-fit | statistical_method | HistFitter fit\nhepkg:method:profile-likelihood-fit-histfitter | statistical_method | HistFitter fit\nhepkg:method:his"}, {"tool": "sql", "round": 1, "args": {"query": "SELECT kind, COUNT(*) FROM entity WHERE lower(label) LIKE '%histfitter%' GROUP BY kind"}, "rows": 1, "error": null, "truncated": false, "preview": "kind | COUNT(*)\nstatistical_method | 3\n(1 rows)"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT entity_id, label, kind FROM entity WHERE lower(label) LIKE '%histfitter%'"}, "rows": 3, "error": null, "truncated": false, "preview": "entity_id | label | kind\nhepkg:method:histfitter | HistFitter package with Gaussian nuisance parameters for systematic uncertainties | statistical_method\nhepkg:method:pyhf-combination | pyhf-based sta"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT eo.paper_id, eo.entity_id, eo.label FROM entity_occurrence eo WHERE lower(eo.label) LIKE '%histfitter%'"}, "rows": 6, "error": null, "truncated": false, "preview": "paper_id | entity_id | label\n2006.05880 | hepkg:method:profile-likelihood-fit | Profile likelihood fit implemented in HistFitter\n2006.05880 | hepkg:method:histfitter | HistFitter statistical framework"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.paper_id, a.object_id, e.label FROM assertion a JOIN entity e ON e.entity_id = a.object_id WHERE a.predicate='result_uses_statistical_method' AND (e.entity_id IN ('hepkg:method:histfitter','hepkg:method:profile-likelihood-fit-histfitter','hepkg:method:profile-likelihood-fit','hepkg:method:pyhf-combination'))"}, "rows": 7, "error": null, "truncated": false, "preview": "paper_id | object_id | label\n2006.05880 | hepkg:method:profile-likelihood-fit | Maximum-likelihood (profile likelihood) fit with Poisson/Gaussian terms and Beeston-Barlow-lite MC-stat nuisances\n2006.0"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT eo.paper_id, eo.entity_id, eo.label FROM entity_occurrence eo WHERE eo.entity_id IN ('hepkg:method:histfitter','hepkg:method:profile-likelihood-fit-histfitter')"}, "rows": 3, "error": null, "truncated": false, "preview": "paper_id | entity_id | label\n2006.05880 | hepkg:method:histfitter | HistFitter statistical framework\n2011.07812 | hepkg:method:histfitter | HistFitter package with Gaussian nuisance parameters for sys"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT eo.paper_id, eo.entity_id, eo.label FROM entity_occurrence eo WHERE eo.entity_id IN ('hepkg:method:histfitter','hepkg:method:profile-likelihood-fit-histfitter','hepkg:method:profile-likelihood-fit','hepkg:method:pyhf-combination') ORDER BY eo.paper_id"}, "rows": 7, "error": null, "truncated": false, "preview": "paper_id | entity_id | label\n2006.05880 | hepkg:method:profile-likelihood-fit | Profile likelihood fit implemented in HistFitter\n2006.05880 | hepkg:method:histfitter | HistFitter statistical framework"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id, a.assertion_id, e.label, a.notes FROM assertion a JOIN entity e ON e.entity_id = a.object_id WHERE a.predicate='result_uses_statistical_method' AND (lower(e.label) LIKE '%histfitter%' OR lower(COALESCE(a.notes,'')) LIKE '%histfitter%')"}, "rows": 5, "error": null, "truncated": false, "preview": "paper_id | assertion_id | label | notes\n2006.05880 | hepkg:assertion:9e57c68e01a5b7fcd7e517a5 | HistFitter package with Gaussian nuisance parameters for systematic uncertainties | Matches HistFitter f"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT b.paper_id, COUNT(*) AS n FROM evidence e JOIN bundle_import b ON b.bundle_id = e.bundle_id WHERE lower(e.quote) LIKE '%histfitter%' GROUP BY b.paper_id"}, "rows": 0, "error": "no such column: b.paper_id", "truncated": false, "preview": "ERROR: no such column: b.paper_id"}], "sets": {}, "entity_ids": ["hepkg:assertion:2371ab50d18ce9500df37aeb", "hepkg:assertion:9e57c68e01a5b7fcd7e517a5", "hepkg:assertion:c8550f45f49383ac2a1dbe6b", "hepkg:assertion:e3caa182f9c12ba0ef47e3c3", "hepkg:assertion:f66a71f2b5d3c91cdc662644", "hepkg:generator:herwig-7-0-4", "hepkg:generator:herwig-7-2-1", "hepkg:generator:herwig7", "hepkg:generator:herwig7_1_3", "hepkg:generator:herwigpp", "hepkg:generator:powheg_herwigpp", "hepkg:method:histfitter", "hepkg:method:profile-likelihood-fit", "hepkg:method:profile-likelihood-fit-histfitter", "hepkg:method:pyhf-combination", "hepkg:model:heft", "hepkg:object:VR-Z-ttZ", "hepkg:parameter:c_hw", "hepkg:parameter:c_hw_tilde", "hepkg:parameter:kappa-tau", "hepkg:process:th", "hepkg:process:thw", "hepkg:process:tth-th-production", "hepkg:region:SR-bffN_btag", "hepkg:region:htautau-tautau-fiducial"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 25252, "completion_tokens": 2791, "rounds": 6, "seconds": 17.207268476486206, "reviews": [], "recovered_calls": 0, "cited": "