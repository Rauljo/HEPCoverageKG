{"run_id": "20260830T111332-free-sql-168561", "qid": "gabriel-gf-01-condition", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses use b-tagged jets (jets identified as containing a b-hadron) in their event selection?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "48 analyses in the graph use b-tagged jets in their event selection. This was determined by combining three lines of evidence: (a) entity_occurrence rows where a b-tagged jet appears as a detector_object (the direct signal that the analysis uses b-tagged jets), (b) assertion-graph rows where a signal/control/validation region requires a b-tagged jet (predicate region_requires_object with a b-tagged-jet object), and (c) event regions/channels/selection requirements whose labels contain b-tagging (e.g. \"exactly 1 b-tagged jet\" channels, b-tag multiplicity requirements). The full list of arXiv ids is below.", "answered": true, "papers": ["2001.06899", "2004.04545", "2004.14060", "2006.05880", "2007.02873", "2008.05928", "2009.04363", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2111.08340", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2303.15340", "2307.01094", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2403.01556", "2405.18661", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044", "2605.14245"], "value": null, "steps": [{"tool": "sql", "round": 1, "args": {"query": "SELECT kind, COUNT(*) AS n FROM entity WHERE lower(label) LIKE '%b-tag%' GROUP BY kind ORDER BY n DESC"}, "rows": 8, "error": null, "truncated": false, "preview": "kind | n\ndetector_object | 19\nevent_region | 16\nsystematic_uncertainty | 12\nchannel | 11\nselection_requirement | 1\nobservable | 1\nbackground_method | 1\nbackground | 1\n(8 rows)"}, {"tool": "search", "round": 1, "args": {"text": "b-tagged jet", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:object:b-jet | detector_object | b-tagged jet\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-tight | detector_object | leading b-tagged jet\nhe"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT eo.paper_id FROM entity_occurrence eo WHERE eo.kind='detector_object' AND lower(eo.label) LIKE '%b%tag%' ORDER BY eo.paper_id"}, "rows": 44, "error": null, "truncated": false, "preview": "paper_id\n2001.06899\n2004.04545\n2004.14060\n2006.05880\n2007.02873\n2009.04363\n2010.14293\n2012.03799\n2012.08600\n2102.01444\n2103.04956\n2103.06956\n2106.14246\n2107.12553\n2109.13808\n2110.11231\n2111.08340\n2112"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT eo.paper_id FROM entity_occurrence eo WHERE lower(eo.label) LIKE '%b%tag%' AND eo.kind IN ('event_region','selection_requirement','channel') ORDER BY eo.paper_id"}, "rows": 20, "error": null, "truncated": false, "preview": "paper_id\n2001.06899\n2004.14060\n2006.05880\n2008.05928\n2009.04363\n2012.03799\n2012.08600\n2103.04956\n2103.06956\n2111.08340\n2207.00348\n2208.12095\n2211.08028\n2303.15340\n2402.08486\n2403.01556\n2506.13565\n2509"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT entity_id, label FROM entity WHERE kind='detector_object' AND lower(label) LIKE '%b%tag%'"}, "rows": 24, "error": null, "truncated": false, "preview": "entity_id | label\nhepkg:object:b_jet | b-tagged jet\nhepkg:object:bjet | b-tagged jet\nhepkg:object:btrackjet | $b$-tagged track-jet\nhepkg:object:isr_jet_srd | ISR jet (SRD, leading non-$b$-tagged jet)\n"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.predicate, a.paper_id, e.label AS obj_label, sub.label AS subj_label FROM assertion a JOIN entity e ON e.entity_id = a.object_id JOIN entity sub ON sub.entity_id = a.subject_id WHERE lower(e.label) LIKE '%b%tag%' AND a.predicate IN ('region_requires_object','object_has_selection','region_has_selection','result_defines_region','result_defines_object') ORDER BY a.paper_id LIMIT 100"}, "rows": 100, "error": null, "truncated": false, "preview": "predicate | paper_id | obj_label | subj_label\nresult_defines_object | 2001.06899 | b-tagged jet | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets i"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT DISTINCT a.paper_id FROM assertion a JOIN entity e ON e.entity_id = a.object_id WHERE a.predicate = 'region_requires_object' AND lower(e.label) LIKE '%b%tag%' ORDER BY a.paper_id"}, "rows": 39, "error": null, "truncated": false, "preview": "paper_id\n2004.04545\n2004.14060\n2006.05880\n2007.02873\n2009.04363\n2010.14293\n2012.03799\n2012.08600\n2102.01444\n2103.04956\n2103.06956\n2106.01676\n2106.14246\n2107.12553\n2109.13808\n2110.11231\n2111.08340\n2112"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT DISTINCT a.paper_id FROM assertion a JOIN entity e ON e.entity_id = a.object_id WHERE a.predicate IN ('object_has_selection','region_has_selection') AND (lower(e.label) LIKE '%b%tag%' OR EXISTS (SELECT 1 FROM assertion a2 JOIN entity e2 ON e2.entity_id=a2.object_id WHERE a2.predicate='region_requires_object' AND lower(e2.label) LIKE '%b%tag%' AND a2.subject_id=a.object_id)) ORDER BY a.paper_id"}, "rows": 2, "error": null, "truncated": false, "preview": "paper_id\n2207.00348\n2509.22535\n(2 rows)"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT a.paper_id, a.predicate, sub.label AS subj, e.label AS obj FROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN entity sub ON sub.entity_id=a.subject_id WHERE a.paper_id IN ('2106.01676','2509.22535') AND lower(e.label) LIKE '%b%tag%' ORDER BY a.paper_id LIMIT 50"}, "rows": 27, "error": null, "truncated": false, "preview": "paper_id | predicate | subj | obj\n2106.01676 | result_defines_object | Search for chargino–neutralino pair production in final states with three leptons and missing transverse momentum\nin $\\sqrt{s}=13"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT eo.paper_id, eo.kind, eo.label FROM entity_occurrence eo WHERE eo.paper_id IN ('2001.06899','2201.11585','2205.05120','2207.00348','2308.02285','2403.01556','2503.19420') AND lower(eo.label) LIKE '%b%tag%' ORDER BY eo.paper_id, eo.kind"}, "rows": 21, "error": null, "truncated": false, "preview": "paper_id | kind | label\n2001.06899 | detector_object | Bottom (b)-tagged jet\n2001.06899 | event_region | High-purity ttbar control region for b jet M_SV template (lepton+>=2 jets, >=1 b-tagged jet)\n20"}], "sets": {}, "entity_ids": ["hepkg:final-state:dilepton-0b", "hepkg:final-state:dilepton-1b", "hepkg:final-state:dilepton-2b", "hepkg:final_state:bb-large-R-jet", "hepkg:final_state:tth-dimuon-bjets", "hepkg:object:VR-Z-VV-btag", "hepkg:object:ak4_b_jet", "hepkg:object:anti-tagged-candidate-jet", "hepkg:object:b-jet", "hepkg:object:b-tagged-ak4-jet", "hepkg:object:b-tagged-jet", "hepkg:object:b_jet", "hepkg:object:b_jet_reco", "hepkg:object:b_tagged_jet", "hepkg:object:bb-tagged-ak8-jet", "hepkg:object:bjet", "hepkg:object:bjet-reco", "hepkg:object:bjet-relaxed", "hepkg:object:bjet-tight", "hepkg:object:bjet_medium_detector", "hepkg:object:bjet_reco", "hepkg:object:bjet_tight_detector", "hepkg:object:btrackjet", "hepkg:object:c_jet", "hepkg:object:double-tagged-candidate-jet", "hepkg:object:emerging_jet", "hepkg:object:h-candidate-resolved", "hepkg:object:h-tagged-jet", "hepkg:object:hf_jet", "hepkg:object:higgs-boson-candidate", "hepkg:object:isr_jet_srd", "hepkg:object:non_b_tagged_jet", "hepkg:object:soft-b-tag", "hepkg:object:vbf-jet", "hepkg:object_selection:bjet_count_baseline", "hepkg:region:SR_b", "hepkg:region:SR_b_j_b", "hepkg:region:sr-0b", "hepkg:region:sr-1b", "hepkg:region:sr-2b"