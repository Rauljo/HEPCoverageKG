{"run_id": "20260830T111332-free-sql-168561", "qid": "gabriel-gf-01", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses are searches (rather than measurements) whose event selection uses both b-tagged jets and missing transverse momentum?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2004.04545", "2004.14060", "2006.05880", "2007.02873", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2111.08340", "2112.00895", "2112.03161", "2201.11585", "2202.08676", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2303.15340", "2312.04450", "2401.05299", "2402.08486", "2404.06204", "2405.18661", "2408.03744", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044", "2605.14245"], "value": null, "steps": [{"tool": "sql", "round": 1, "args": {"query": "SELECT kind, COUNT(*) AS n FROM entity WHERE lower(label) LIKE '%b%tag%' GROUP BY kind ORDER BY n DESC"}, "rows": 13, "error": null, "truncated": false, "preview": "kind | n\nevent_region | 41\nsystematic_uncertainty | 36\ndetector_object | 24\nchannel | 15\nselection_requirement | 4\nobservable | 4\nbackground_method | 3\nstatistical_method | 1\nresult | 1\npaper | 1\nobje"}, {"tool": "sql", "round": 1, "args": {"query": "SELECT kind, COUNT(*) AS n FROM entity WHERE lower(label) LIKE '%missing transverse momentum%' OR lower(label) LIKE '%met%' OR lower(label) LIKE '%e%miss%' GROUP BY kind ORDER BY n DESC"}, "rows": 17, "error": null, "truncated": false, "preview": "kind | n\nsystematic_uncertainty | 59\nstatistical_method | 59\nbackground_method | 53\nchannel | 28\nobservable | 27\nresult | 22\nevent_region | 21\ndetector_object | 16\nbsm_model | 15\npaper | 10\nbackground"}, {"tool": "search", "round": 2, "args": {"text": "b-tagged jet", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:b-jet | detector_object | b-tagged jet\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-tight | detector_object | leading b-tagged jet\nhe"}, {"tool": "search", "round": 2, "args": {"text": "missing transverse momentum", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:met | detector_object | Missing transverse momentum\nhepkg:object:missing_et | detector_object | missing transverse momentum\nhepkg:object:met-particle | object_def"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.predicate, a.subject_id, a.object_id, e.label, COUNT(*) n\nFROM assertion a JOIN entity e ON e.entity_id = a.object_id\nWHERE a.predicate IN ('region_requires_object','region_has_selection','object_has_selection')\n  AND (lower(e.label) LIKE '%b%tag%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%met%' OR lower(e.label) LIKE '%e%miss%')\nGROUP BY a.predicate, a.subject_id, a.object_id, e.label\nORDER BY a.predicate, n DESC\nLIMIT 100"}, "rows": 100, "error": null, "truncated": false, "preview": "predicate | subject_id | object_id | label | n\nobject_has_selection | hepkg:object:b-jet | hepkg:selection:bjet-eta-tagging | b-jet eta acceptance and DL1r tagging working points | 1\nobject_has_select"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.subject_id AS region, e.label AS obj, a.paper_id\nFROM assertion a JOIN entity e ON e.entity_id = a.object_id\nWHERE a.predicate='region_requires_object'\n  AND (lower(e.label) LIKE '%b%tag%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%met%' OR lower(e.label) LIKE '%e%miss%')\nORDER BY a.subject_id"}, "rows": 200, "error": null, "truncated": true, "preview": "region | obj | paper_id\nhepkg:final_state:0L_fully_hadronic | b-tagged jet | 2509.22535\nhepkg:final_state:0L_ful