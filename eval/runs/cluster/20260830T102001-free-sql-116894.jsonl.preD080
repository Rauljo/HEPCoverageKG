n:vr-ttbar-offwz", "hepkg:region:vr-ttbar-onshell"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 34050, "completion_tokens": 1194, "rounds": 6, "seconds": 26.581453561782837, "reviews": [], "recovered_calls": 0, "cited": "answer.papers", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 26.581453561782837, "llm_calls": 6.0, "tokens": 35244.0, "rounds": 6.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "judged_precision": 0.875, "judged_recall": 0.7777777777777778, "judged_f1": 0.823529411764706, "judged_named_none": 0.0, "judged_coverage": 0.65, "retrieval_reach": 0.6666666666666666, "tool_calls": 7.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 87.0, "evidence_quotes": 0.0}}
{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-08", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses require exactly two electrons OR exactly two muons as alternative selections -- parallel ee and mumu channels, rather than requiring both?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The analyses with parallel same-flavour dilepton selections—an **ee channel OR a μμ channel**, not both simultaneously—are arXiv:2007.02873, arXiv:2112.03161, arXiv:2206.09466, arXiv:2404.06204, arXiv:2506.13565, and arXiv:2602.18611.", "answered": true, "papers": ["2007.02873", "2112.03161", "2206.09466", "2404.06204", "2506.13565", "2602.18611"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "exactly two electrons selection requirement", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:channel:two-body-selection | channel | Two-body selection\nhepkg:object:electron | detector_object | Electrons\nhepkg:channel:1l2t | channel | 1L2T channel (exactly 1 ligh"}, {"tool": "search", "round": 1, "args": {"text": "exactly two muons selection requirement", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:final_state:dimuon | channel | Two prompt, isolated, oppositely charged muons\nhepkg:selection:muon-isolation | selection_requirement | Muon isolation efficiency requirem"}, {"tool": "search", "round": 1, "args": {"text": "dielectron ee channel and dimuon mumu channel alternative selections", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:channel:dimuon | channel | Dimuon (mu+mu-) channel\nhepkg:channel:dilepton_plus_jets | channel | dielectron/dimuon + jets\nhepkg:channel:dielectron | channel | Dielectron "}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT eo.paper_id, eo.kind, eo.entity_id, eo.label FROM entity_occurrence eo WHERE (lower(eo.label) LIKE '%exactly two%electron%' OR lower(eo.label) LIKE '%exactly two%muon%' OR lower(eo.label) LIKE '%two electron%' OR lower(eo.label) LIKE '%two muon%' OR lower(eo.label) LIKE '%dielectron%' OR lower(eo.label) LIKE '%dimuon%' OR lower(eo.label) LIKE '%ee/mu%' OR lower(eo.label) LIKE '%ee and mu%') ORDER BY eo.paper_id, eo.kind, eo.label LIMIT 200"}, "rows": 21, "error": null, "truncated": false, "preview": "paper_id | kind | entity_id | label\n2009.04363 | channel | hepkg:final_state:vh-dimuon-multilepton | Dimuon pair plus additional charged lepton(s) from leptonic W/Z decay (VH category)\n2009.04363 | ch"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT ss.paper_id, sb.section_title, substr(sb.text,1,1000) AS text FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash WHERE (lower(sb.text) LIKE '%exactly two electrons%' OR lower(sb.text) LIKE '%exactly two muons%') ORDER BY ss.paper_id, sb.block_order LIMIT 100"}, "rows": 1, "error": null, "truncated": false, "preview": "paper_id | section_title | text\n2009.04363 | The ${\\mathup{{{g}}}}{\\mathup{{{g}}}}{\\mathup{{{H}}}}$ production category | An event is considered in the ${\\mathup{{{g}}}}{\\mathup{{{g}}}}{\\mathup{{{H}}}"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT ss.paper_id, sb.section_title, substr(sb.text,1,1400) AS text FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash WHERE (lower(sb.text) LIKE '%two electrons or two muons%' OR lower(sb.text) LIKE '%two muons or two electrons%' OR lower(sb.text) LIKE '%exactly two same-flavour%' OR lower(sb.text) LIKE '%exactly two same flavor%' OR lower(sb.text) LIKE '%exactly two leptons%' OR lower(sb.text) LIKE '%exactly two charged leptons%') AND (lower(sb.text) LIKE '%electron%' AND lower(sb.text) LIKE '%muon%') ORDER BY ss.paper_id, sb.block_order LIMIT 200"}, "rows": 9, "error": null, "truncated": false, "preview": "paper_id | section_title | text\n2007.02873 |  | The trigger selection in the electron sub-channel is the same\nas in the 1-lepton channel. In the muon sub-channel, an OR of single-muon triggers\nis used"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT DISTINCT ss.paper_id, p.title FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id WHERE (lower(sb.text) LIKE '%exactly two same-flavour%' OR lower(sb.text) LIKE '%exactly two same flavor%' OR lower(sb.text) LIKE '%exactly two electrons or two muons%' OR lower(sb.text) LIKE '%either two electrons or two muons%' OR lower(sb.text) LIKE '%two electrons or two muons%') AND sb.section_title NOT LIKE '%Reference%' ORDER BY ss.paper_id"}, "rows": 7, "error": null, "truncated": false, "preview": "paper_id | title\n2007.02873 | Measurements of $WH$ and $ZH$ production in the $H\\rightarrow b\\bar{b}$ decay channel in $pp$ collisions at $13\\,\\text{Te\\kern-1.00006ptV}$ with the ATLAS detector\n2112.0"}], "sets": {}, "entity_ids": ["hepkg:background:other-minor-backgrounds", "hepkg:channel:1l2t", "hepkg:channel:2l1t", "hepkg:channel:2l2t", "hepkg:channel:dielectron", "hepkg:channel:dilepton_plus_jets", "hepkg:channel:dimuon", "hepkg:channel:four-body-selection", "hepkg:channel:three-body-selection", "hepkg:channel:ttbar_emu", "hepkg:channel:two-body-selection", "hepkg:final_state:0L_fully_hadronic", "hepkg:final_state:1lepton-4b-higgs-met", "hepkg:final_state:3lepton-Z-jets-met", "hepkg:final_state:dilepton_ttbar", "hepkg:final_state:dimuon", "hepkg:final_state:displaced-dilepton", "hepkg:final_state:ee-plus-p", "hepkg:final_state:emu_ss_1or2_bjets_reco", "hepkg:final_state:ggh-dimuon-untagged", "hepkg:final_state:h_to_mumu", "hepkg:final_state:multilepton", "hepkg:final_state:ss2l-jets-rpv", "hepkg:final_state:three_lepton", "hepkg:final_state:tth-dimuon-bjets", "hepkg:final_state:vbf-dimuon-dijet", "hepkg:final_state:vh-dimuon-multilepton", "hepkg:object:dielectron_vertex", "hepkg:object:dimuon_resonance", "hepkg:object:electron", "hepkg:object:electron_reco", "hepkg:object:lepton", "hepkg:object:muon", "hepkg:object:signal-lepton", "hepkg:object_selection:electron_1L", "hepkg:object_selection:electron_2L", "hepkg:object_selection:jet_count_0L", "hepkg:object_selection:lepton_req_1L", "hepkg:object_selection:lepton_req_2L", "hepkg:object_selection:lepton_veto_0L", "hepkg:object_selection:muon_1L", "hepkg:object_selection:muon_2L", "hepkg:observable:dilepton-mass-spectrum", "hepkg:observable:xsec_br_acc_eff_limit", "hepkg:region:CR_2j", "hepkg:region:CR_2j_ee", "hepkg:region:CR_b_ee", "hepkg:region:CR_b_j_b_ee", "hepkg:region:CR_j", "hepkg:region:CR_j_ee", "hepkg:region:SR_b", "hepkg:region:SR_b_j_b", "hepkg:region:detector_sr_dilepton", "hepkg:region:preselection_muon", "hepkg:region:same_sign_cr", "hepkg:region:z-mumu-detector-sr", "hepkg:sample:zjets-ee-mumu-madgraph", "hepkg:selection:muon-isolation", "hepkg:selection:photon-pt-mgg-cuts", "hepkg:systematic:electron-selection-efficiency-uncertainty", "hepkg:systematic:electron_efficiency", "hepkg:systematic:lepton_reco_id_trigger", "hepkg:systematic:muon-selection-trigger-efficiency-uncertainty"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 32573, "completion_tokens": 1486, "rounds": 6, "seconds": 23.911715745925903, "reviews": [], "recovered_calls": 0, "cited": "answer.papers", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 23.911715745925903, "llm_calls": 6.0, "tokens": 34059.0, "rounds": 6.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "judged_precision": 1.0, "judged_recall": 0.15384615384615385, "judged_f1": 0.2666666666666667, "judged_named_none": 0.0, "judged_coverage": 0.38333333333333336, "retrieval_reach": 0.15384615384615385, "tool_calls": 7.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 63.0, "evidence_quotes": 0.0}}
{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-01", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses are searches (rather than measurements) whose event selection uses both b-tagged jets and missing transverse momentum?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The graph identifies eight search analyses whose event-region selections require both b-tagged jets and missing transverse momentum:\n\n- **2006.05880** — Search for top squarks in events with a Higgs or Z boson\n- **2106.01676** — Search for chargino–neutralino pair production in three-lepton + missing-transverse-momentum final states\n- **2106.14246** — Search for electroweak chargino and neutralino production\n- **2107.12553** — Search for chargino–neutralino production in events with Higgs and W bosons\n- **2112.03161** — Search for heavy resonances decaying to boosted Higgs-boson pairs in leptonic and bottom-quark final states\n- **2209.07327** — Search for pair-produced vector-like quarks in leptonic final states\n- **2211.08028** — Search for supersymmetry with missing transverse momentum and at least three b-jets\n- **2508.13900** — General search for supersymmetry in compressed-mass-spectrum scenarios", "answered": true, "papers": ["2006.05880", "2106.01676", "2106.14246", "2107.12553", "2112.03161", "2209.07327", "2211.08028", "2508.13900"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets used in event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:bjet | detector_object | b-tagged jets\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-relaxed | detector_object | subleading b-tagged j"}, {"tool": "search", "round": 1, "args": {"text": "missing transverse momentum MET missing ET used in event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:systematic:met_selection_efficiency | systematic_uncertainty | Missing transverse momentum (p_T^miss) selection efficiency uncertainty\nhepkg:object_selection:met_1L2L | "}, {"tool": "sql", "round": 1, "args": {"query": "SELECT kind, label, entity_id FROM entity WHERE lower(label) LIKE '%b-tag%' OR lower(label) LIKE '%b tag%' OR lower(label) LIKE '%missing transverse%' OR lower(label) LIKE '%e_t^miss%' OR lower(label) LIKE '%etmiss%' LIMIT 100"}, "rows": 100, "error": null, "truncated": false, "preview": "kind | label | entity_id\ndetector_object | Missing transverse momentum (p_T^miss) | hepkg:object:met\ndetector_object | b-tagged jet | hepkg:object:b_jet\nevent_region | High-purity ttbar control region"}, {"tool": "sql", "round": 2, "args": {"query": "WITH obj AS (SELECT entity_id, lower(label) lbl FROM entity WHERE kind='detector_object'), hits AS (SELECT a.paper_id,a.predicate,e.entity_id,e.label FROM assertion a JOIN obj o ON o.entity_id=a.object_id JOIN entity e ON e.entity_id=a.object_id WHERE (o.lbl LIKE '%b-tag%' OR o.lbl LIKE '%b tag%' OR o.lbl IN ('b jet','b jets','b-jet','b-jets','b-tagged jet','b-tagged jets') OR o.lbl LIKE '%missing transverse momentum%' OR o.lbl LIKE '%missing transverse energy%')) SELECT p.category,h.predicate,h.label,COUNT(*) n FROM hits h JOIN paper p ON p.arxiv_id=h.paper_id GROUP BY p.category,h.predicate,h.label ORDER BY h.predicate,h.label LIMIT 200"}, "rows": 48, "error": null, "truncated": false, "preview": "category | predicate | label | n\nsearch | channel_has_region | Validation region VR^{Z,b-tag}_VV for multi-boson background (b-tag veto released) | 1\nsearch | region_requires_object | AK4 b-tagged jet"}, {"tool": "sql", "round": 3, "args": {"query": "WITH req AS (SELECT DISTINCT a.paper_id, a.subject_id AS region_id, lower(e.label) AS obj_label FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.predicate='region_requires_object' AND e.kind='detector_object'), flags AS (SELECT paper_id, MAX(CASE WHEN (obj_label LIKE '%b-tagged jet%' OR obj_label LIKE '%b tagged jet%' OR obj_label LIKE '%b-jet%' OR obj_label IN ('b jet','b jets')) AND obj_label NOT LIKE '%non-b%' THEN 1 ELSE 0 END) has_b, MAX(CASE WHEN obj_label LIKE '%missing transverse momentum%' OR obj_label LIKE '%missing transverse energy%' OR obj_label LIKE '%e_t^miss%' THEN 1 ELSE 0 END) has_met FROM req GROUP BY paper_id) SELECT p.arxiv_id,p.title, f.has_b,f.has_met FROM flags f JOIN paper p ON p.arxiv_id=f.paper_id WHERE p.category='search' AND f.has_b=1 AND f.has_met=1 ORDER BY p.arxiv_id"}, "rows": 8, "error": null, "truncated": false, "preview": "arxiv_id | title | has_b | has_met\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector | 1 | 1\n2"}, {"tool": "sql", "round": 4, "args": {"query": "WITH req AS (SELECT DISTINCT a.paper_id, a.subject_id region_id, lower(e.label) obj_label FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.predicate='region_requires_object' AND e.kind='detector_object'), rf AS (SELECT paper_id,region_id, MAX(CASE WHEN (obj_label LIKE '%b-tagged jet%' OR obj_label LIKE '%b tagged jet%' OR obj_label LIKE '%b-jet%' OR obj_label IN ('b jet','b jets')) AND obj_label NOT LIKE '%non-b%' THEN 1 ELSE 0 END) has_b, MAX(CASE WHEN obj_label LIKE '%missing transverse momentum%' OR obj_label LIKE '%missing transverse energy%' OR obj_label LIKE '%e_t^miss%' THEN 1 ELSE 0 END) has_met FROM req GROUP BY paper_id,region_id) SELECT DISTINCT p.arxiv_id,p.title FROM rf JOIN paper p ON p.arxiv_id=rf.paper_id WHERE p.category='search' AND has_b=1 AND has_met=1 ORDER BY p.arxiv_id"}, "rows": 4, "error": null, "truncated": false, "preview": "arxiv_id | title\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2107.12553 | Search for cha"}], "sets": {}, "entity_ids": ["hepkg:background:total-smooth-mJgamma", "hepkg:final-state:dilepton-0b", "hepkg:final-state:dilepton-2b", "hepkg:final_state:1lep-hbb-met", "hepkg:final_state:1lep-jets-met", "hepkg:final_state:1lepton-4b-higgs-met", "hepkg:final_state:2l-os-jets-met", "hepkg:final_state:3l-met", "hepkg:final_state:3lepton-Z-jets-met", "hepkg:final_state:alljets_met_0lepton", "hepkg:final_state:bb-large-R-jet", "hepkg:final_state:bb_l_qqprime_met", "hepkg:final_state:bb_ll_met", "hepkg:final_state:dilepton-dijet-met-vh2j", "hepkg:final_state:dilepton-met", "hepkg:final_state:fourlepton-met", "hepkg:final_state:ggh-dimuon-untagged", "hepkg:final_state:jets-met-0lepton", "hepkg:final_state:jets_met", "hepkg:final_state:lepton_nu_charm", "hepkg:final_state:met-4jets-3bjets-0or1lepton", "hepkg:final_state:samesign-dilepton-met-dijet", "hepkg:final_state:ss2l-or-3l-jets-met", "hepkg:final_state:trilepton-met", "hepkg:final_state:trilepton-met-dijet", "hepkg:final_state:tth-dimuon-bjets", "hepkg:finalstate:diphoton_tHq_leptonic", "hepkg:finalstate:diphoton_ttH_hadronic", "hepkg:finalstate:diphoton_zero_lepton_met", "hepkg:method:ancillary_category_fit_bkg_constraint", "hepkg:object:VR-Z-VV-btag", "hepkg:object:ak4_b_jet", "hepkg:object:b-jet", "hepkg:object:b-tagged-ak4-jet", "hepkg:object:b-tagged-jet", "hepkg:object:b_jet", "hepkg:object:b_jet_reco", "hepkg:object:b_tagged_jet", "hepkg:object:bjet", "hepkg:object:bjet-reco", "hepkg:object:bjet-relaxed", "hepkg:object:bjet-tight", "hepkg:object:bjet_medium_detector", "hepkg:object:bjet_reco", "hepkg:object:bjet_tight_detector", "hepkg:object:btrackjet", "hepkg:object:etmiss", "hepkg:object:met", "hepkg:object:met-particle", "hepkg:object:met-reco", "hepkg:object:met_reco", "hepkg:object:met_track", "hepkg:object:missing-transverse-momentum", "hepkg:object:missing_et", "hepkg:object:missing_transverse_momentum", "hepkg:object:neutrino", "hepkg:object:soft-b-tag", "hepkg:object:tr