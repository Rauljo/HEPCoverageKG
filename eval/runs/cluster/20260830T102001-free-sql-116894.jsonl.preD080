{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-05", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses reconstruct a Higgs-boson candidate as a physical object they select on (rather than merely studying Higgs production or decay)?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The graph explicitly represents reconstructed Higgs candidates as selected objects in six analyses:\n\n- **2006.05880** — NN-tagged resolved $h\\to b\\bar b$ jet-pair candidate\n- **2008.05928** — large-$R$ jet used as an $H\\to b\\bar b$ candidate\n- **2012.08600** — selected large-radius jet in the boosted-Higgs reconstruction\n- **2103.04956** — four-lepton $ZZ$ candidate reconstructed as the Higgs candidate\n- **2504.13081** — explicitly defined reconstructed Higgs-boson candidate\n- **2605.14245** — selected diphoton system serving as the Higgs candidate\n\nI excluded papers that only target Higgs production/decay or define a Higgs-related object without an explicit selection link in the graph.", "answered": true, "papers": ["2006.05880", "2008.05928", "2012.08600", "2103.04956", "2504.13081", "2605.14245"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "reconstructed Higgs boson candidate physical detector object selected in event selection, such as Higgs candidate", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:higgs_boson | detector_object | Higgs boson (reconstructed candidate)\nhepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate\nhepkg:object:di"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT eo.paper_id, eo.entity_id, eo.kind, eo.label FROM entity_occurrence eo WHERE eo.entity_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:diphoton','hepkg:object:zz_candidate','hepkg:object:H-jet') ORDER BY eo.paper_id, eo.entity_id"}, "rows": 5, "error": null, "truncated": false, "preview": "paper_id | entity_id | kind | label\n2006.05880 | hepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate (h->bb jet pair, NN-tagged)\n2103.04956 | hepkg:object:zz_candidate | detec"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id,a.predicate,a.subject_id,es.label AS subject_label,a.object_id,eo.label AS object_label,a.object_value FROM assertion a LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE a.subject_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:diphoton','hepkg:object:zz_candidate','hepkg:object:H-jet') OR a.object_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:diphoton','hepkg:object:zz_candidate','hepkg:object:H-jet') ORDER BY a.paper_id,a.predicate LIMIT 200"}, "rows": 23, "error": null, "truncated": false, "preview": "paper_id | predicate | subject_id | subject_label | object_id | object_label | object_value\n2006.05880 | object_has_selection | hepkg:object:higgs-boson-candidate | Higgs boson candidate (h->bb jet pa"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT entity_id,kind,label FROM entity WHERE lower(label) LIKE '%higgs%candidate%' OR lower(label) LIKE '%h boson candidate%' OR lower(label) LIKE '%higgs boson (reconstructed%' OR lower(label) LIKE '%h-jet%' ORDER BY kind,label LIMIT 200"}, "rows": 11, "error": null, "truncated": false, "preview": "entity_id | kind | label\nhepkg:model:higgs_portal_fermion_dm | bsm_model | Higgs-portal model with Majorana fermion dark matter candidate\nhepkg:model:higgs_portal_scalar_dm | bsm_model | Higgs-portal "}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, eo.entity_id, eo.label, a.predicate FROM assertion a JOIN entity eo ON eo.entity_id=CASE WHEN a.predicate='object_has_selection' THEN a.subject_id ELSE a.object_id END JOIN paper p ON p.arxiv_id=a.paper_id WHERE a.predicate IN ('object_has_selection','region_requires_object') AND (lower(eo.label) LIKE '%higgs%candidate%' OR lower(eo.label) LIKE '%h boson candidate%' OR lower(eo.label) LIKE '%higgs boson (reconstructed%' OR lower(eo.label) LIKE '%h-jet%') ORDER BY a.paper_id,eo.label,a.predicate"}, "rows": 6, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label | predicate\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS dete"}, {"tool": "search", "round": 4, "args": {"text": "large radius jet reconstructed as Higgs candidate H jet selected candidate boosted Higgs to bb", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:large_radius_jet | detector_object | Large-radius jet (boosted H->bb analysis)\nhepkg:final_state:gamma-Hbb-largeRjet | channel | photon + large-R jet (H -> bb rec"}, {"tool": "sql", "round": 5, "args": {"query": "WITH objs(entity_id) AS (VALUES ('hepkg:object:large_radius_jet'),('hepkg:object:candidate-jet'),('hepkg:object:largeR-jet'),('hepkg:object:higgs-boson-candidate'),('hepkg:object:h-tagged-jet'),('hepkg:object:H-jet'),('hepkg:object:bb_jet'),('hepkg:object:higgs_boson'),('hepkg:object:diphoton'),('hepkg:object:h-candidate-resolved'),('hepkg:object:zz_candidate')) SELECT DISTINCT a.paper_id,p.title,e.entity_id,e.label,a.predicate,a.object_value FROM assertion a JOIN entity e ON e.entity_id=CASE WHEN a.predicate='object_has_selection' THEN a.subject_id ELSE a.object_id END JOIN objs o ON o.entity_id=e.entity_id JOIN paper p ON p.arxiv_id=a.paper_id WHERE a.predicate IN ('object_has_selection','region_requires_object','region_vetoes_object') ORDER BY a.paper_id,e.entity_id,a.predicate"}, "rows": 36, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label | predicate | object_value\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with"}], "sets": {}, "entity_ids": ["hepkg:background:vbf_production", "hepkg:final_state:1lepton-4b-higgs-met", "hepkg:final_state:bb-large-R-jet", "hepkg:final_state:gamma-Hbb-largeRjet", "hepkg:model:higgs_portal_fermion_dm", "hepkg:model:higgs_portal_scalar_dm", "hepkg:model:higgs_portal_vector_dm", "hepkg:object:H-jet", "hepkg:object:SR-h-1A", "hepkg:object:SR-h-1AB", "hepkg:object:SR-h-1B", "hepkg:object:ak8-jet", "hepkg:object:alfa_track", "hepkg:object:bb_jet", "hepkg:object:candidate-jet", "hepkg:object:diphoton", "hepkg:object:elastic_event_candidate", "hepkg:object:h-candidate-resolved", "hepkg:object:h-tagged-jet", "hepkg:object:higgs-boson-candidate", "hepkg:object:higgs_boson", "hepkg:object:largeR-jet", "hepkg:object:large_radius_jet", "hepkg:object:lepton", "hepkg:object:reclustered-large-R-jet", "hepkg:object:zz_candidate", "hepkg:observable:mbb-spectrum", "hepkg:observable:mu-h-inclusive", "hepkg:region:baseline_4l_selection", "hepkg:region:cat_tth_hadronic_tagged", "hepkg:region:cat_tth_leptonic_tagged", "hepkg:region:cat_vbf_1jet_tagged", "hepkg:region:cat_vh_hadronic_tagged", "hepkg:region:cat_vh_leptonic_tagged", "hepkg:region:detector_sr_dilepton", "hepkg:region:diphoton_preselection", "hepkg:region:ditau-baseline-selection", "hepkg:region:hbb_boosted_ggh", "hepkg:region:sl_electron", "hepkg:region:sv_electron", "hepkg:region:w-enu-detector-sr", "hepkg:region:w-munu-detector-sr", "hepkg:result:3ceb5926f4ce82b73c00210b", "hepkg:result:c77dc93c4243dc6282c1e450", "hepkg:result:c8ed964b14b2b37812ff8556", "hepkg:result:f5b1d9536f2db25c7969a697", "hepkg:systematic:jms-jmr", "hepkg:systematic:large_R_jet_scale_resolution"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 31460, "completion_tokens": 2259, "rounds": 6, "seconds": 31.358612060546875, "review