{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-05", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses reconstruct a Higgs-boson candidate as a physical object they select on (rather than merely studying Higgs production or decay)?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "Three analyses explicitly reconstruct and select a Higgs-boson candidate as an object:\n\n- **2006.05880** — ATLAS top-squark search; selects an NN-tagged **H→bb jet-pair candidate**.\n- **2103.04956** — CMS H→ZZ→4ℓ measurement; selects a **four-lepton Higgs/ZZ candidate**, including four-lepton mass requirements.\n- **2504.13081** — CMS differential Higgs cross-section combination; defines a **reconstructed Higgs candidate** with an explicit selection threshold.\n\nI excluded papers that only target Higgs production/decay or define a Higgs-related object without an explicit object-selection relation in the graph.", "answered": true, "papers": ["2006.05880", "2103.04956", "2504.13081"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "reconstructed Higgs boson candidate selected as detector object in event selection", "kind": "detector_object", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:higgs_boson | detector_object | Higgs boson (reconstructed candidate)\nhepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate\nhepkg:object:el"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT eo.paper_id, eo.entity_id, eo.label, a.predicate, a.subject_id, a.object_id, a.object_value FROM entity_occurrence eo LEFT JOIN assertion a ON a.paper_id=eo.paper_id AND (a.subject_id=eo.entity_id OR a.object_id=eo.entity_id) WHERE eo.entity_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:H-jet','hepkg:object:zz_candidate') ORDER BY eo.paper_id, eo.entity_id, a.predicate LIMIT 200"}, "rows": 18, "error": null, "truncated": false, "preview": "paper_id | entity_id | label | predicate | subject_id | object_id | object_value\n2006.05880 | hepkg:object:higgs-boson-candidate | Higgs boson candidate (h->bb jet pair, NN-tagged) | object_has_select"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, e.entity_id, e.label, e.kind, a.predicate, a.object_value FROM assertion a JOIN entity e ON e.entity_id=CASE WHEN a.predicate='object_has_selection' THEN a.subject_id ELSE a.object_id END WHERE a.predicate IN ('object_has_selection','region_requires_object') AND e.kind='detector_object' AND (lower(e.label) LIKE '%higgs%' OR lower(e.label) LIKE '%h boson%' OR lower(e.label) LIKE '%h-jet%') ORDER BY a.paper_id,e.entity_id,a.predicate LIMIT 200"}, "rows": 12, "error": null, "truncated": false, "preview": "paper_id | entity_id | label | kind | predicate | object_value\n2006.05880 | hepkg:object:higgs-boson-candidate | Higgs boson candidate (h->bb jet pair, NN-tagged) | detector_object | object_has_select"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT arxiv_id,title,category,experiments FROM paper WHERE arxiv_id IN ('2006.05880','2103.04956','2504.13081') ORDER BY arxiv_id"}, "rows": 3, "error": null, "truncated": false, "preview": "arxiv_id | title | category | experiments\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector | "}, {"tool": "search", "round": 5, "args": {"text": "Higgs candidate H candidate reconstructed from decay products object selection", "kind": "", "limit": 50}, "rows": 50, "error": null, "preview": "entity_id | kind | label\nhepkg:object:H-jet | detector_object | H-jet (jet reconstructed to contain the Higgs boson decay products)\nhepkg:object:higgs_boson | detector_object | Higgs boson (reconstruc"}], "sets": {}, "entity_ids": ["hepkg:background:sm_higgs_decays", "hepkg:method:background_particle_level_classification", "hepkg:model:higgs_characterization", "hepkg:object:CR-Z-VV", "hepkg:object:H-jet", "hepkg:object:SR-h-1A", "hepkg:object:SR-h-1AB", "hepkg:object:SR-h-1B", "hepkg:object:alfa_track", "hepkg:object:candidate-jet", "hepkg:object:diphoton", "hepkg:object:elastic_event_candidate", "hepkg:object:electron", "hepkg:object:electron_w", "hepkg:object:etmiss-significance", "hepkg:object:extra_jet_reco", "hepkg:object:hadronic-tau", "hepkg:object:higgs-boson-candidate", "hepkg:object:higgs_boson", "hepkg:object:largeR-jet", "hepkg:object:large_radius_jet", "hepkg:object:lepton", "hepkg:object:muon", "hepkg:object:muon-reco", "hepkg:object:muon_w", "hepkg:object:second_lepton_veto", "hepkg:object:tau-h", "hepkg:object:tau_had", "hepkg:object:w-boson", "hepkg:object:w_boson_candidate", "hepkg:object:z-boson", "hepkg:object:z-candidate-reco", "hepkg:object:z_boson_candidate", "hepkg:object:z_candidate", "hepkg:object:zz_candidate", "hepkg:observable:fit_basis_linear_with_dihiggs", "hepkg:observable:higgs_branching_fraction_ratio", "hepkg:observable:higgs_mass_profiled", "hepkg:observable:higgs_signal_strength_per_decay", "hepkg:observable:higgs_signal_strength_per_prod_decay", "hepkg:observable:mbb-spectrum", "hepkg:observable:mu-h-inclusive", "hepkg:process:h-to-mumu", "hepkg:process:h-to-tautau-decay", "hepkg:process:h_to_diphoton", "hepkg:process:h_to_invisible", "hepkg:process:higgs_stxs", "hepkg:region:baseline_4l_selection", "hepkg:region:diphoton-baseline-sr", "hepkg:region:ditau-baseline-selection", "hepkg:region:elastic_candidate_selection", "hepkg:region:sl_electron", "hepkg:region:sl_muon", "hepkg:region:sv_electron", "hepkg:region:sv_muon", "hepkg:result:116cfef0a2431c2e58b354ad", "hepkg:result:c77dc93c4243dc6282c1e450", "hepkg:result:c8ed964b14b2b37812ff8556", "hepkg:result:coupling_resolved", "hepkg:result:dd53bd1f0b8e16150e060072", "hepkg:result:excl-higgsino-compressed-dm2", "hepkg:result:f5b1d9536f2db25c7969a697", "hepkg:result:per_decay_signal_strength", "hepkg:result:per_prod_decay_signal_strength", "hepkg:result:per_production_signal_strength", "hepkg:sample:vbf_powheg_training", "hepkg:systematic:lepton-eff-scale-factor", "hepkg:systematic:lepton_reco_efficiency", "hepkg:systematic:tauh-id"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 26043, "completion_tokens": 902, "rounds": 6, "seconds": 20.441203117370605, "reviews": [], "recovered_calls": 0, "cited": "answer.papers", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 20.441203117370605, "llm_calls": 6.0, "tokens": 26945.0, "rounds": 6.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "judged_precision": 0.3333333333333333, "judged_recall": 0.06666666666666667, "judged_f1": 0.1111111111111111, "judged_named_none": 0.0, "judged_coverage": 0.48333333333333334, "retrieval_reach": 0.06666666666666667, "tool_calls": 5.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 69.0, "evidence_quotes": 0.0}}
{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-07", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses have a ttZ background and a control region used to normalise that background?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The analyses are arXiv:2004.14060, 2006.05880, 2012.03799, 2012.08600, 2102.01444, 2110.11231, 2202.08676, and 2401.05299. In 2012.08600, ttZ is included within the combined Z+X background category whose normalization is determined with dedicated control regions; in 2110.11231, ttZ and tZq are normalized together.", "answered": true, "papers": ["2004.14060", "2006.05880", "2012.03799", "2012.08600", "2102.01444", "2110.11231", "2202.08676", "2401.05299"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ttZ background", "kind": "background", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background:ttz | background | ttZ irreducible background\nhepkg:background:ttz-tzq | background | ttZ and tZq irreducible background\nhepkg:background:ttx_prompt | backgro"}, {"tool": "search", "round": 1, "args": {"text": "control region used to normalize a background", "kind": "background_method", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background_method:cr_normalisation_fit | background_method | Control-region-based background normalisation fit\nhepkg:method:cr-normalization | background_method | Normal"}, {"tool": "search", "round": 1, "args": {"text": "ttZ control region", "kind": "event_region", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:region:3l-ttz-cr | event_region | 3L ttZ control region\nhepkg:region:cr-ttz | event_region | ttZ/tZq control region (CR-ttZ)\nhepkg:region:cr_zee | event_region | Z(ee) c"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, a.subject_id, a.predicate, a.object_id, es.label AS subject_label, eo.label AS object_label FROM assertion a LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE (a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ') OR a.object_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ')) ORDER BY a.paper_id, a.subject_id, a.predicate LIMIT 200"}, "rows": 13, "error": null, "truncated": false, "preview": "paper_id | subject_id | predicate | object_id | subject_label | object_label\n2004.14060 | hepkg:background:ttbarZ | background_uses_method | hepkg:method:cr_fit_normalization | $t\\bar{t}+Z$ background"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, b.entity_id AS background_id, b.label AS background_label, m.entity_id AS method_id, m.label AS method_label FROM assertion a JOIN entity b ON b.entity_id=a.subject_id JOIN entity m ON m.entity_id=a.object_id WHERE a.predicate='background_uses_method' AND b.kind='background' AND (lower(b.label) LIKE '%ttz%' OR lower(b.label) LIKE '%ttbarz%' OR lower(b.label) LIKE '%t̄t%z%' OR lower(b.label) LIKE '%t\\bar{t}%z%' OR lower(b.label) LIKE '%t{t}%z%') AND (lower(m.label) LIKE '%control region%' OR lower(m.label) LIKE '%control-region%' OR lower(m.label) LIKE '%dedicated control%') ORDER BY a.paper_id"}, "rows": 11, "error": null, "truncated": false, "preview": "paper_id | background_id | background_label | method_id | method_label\n2004.14060 | hepkg:background:ttbarZ | $t\\bar{t}+Z$ background | hepkg:method:cr_fit_normalization | Control-region-based backgro"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id, b.label AS background, m.label AS method, ev.quote FROM assertion a JOIN entity b ON b.entity_id=a.subject_id JOIN entity m ON m.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.predicate='background_uses_method' AND a.paper_id IN ('2004.14060','2006.05880','2012.03799','2012.08600','2102.01444','2110.11231','2202.08676','2401.05299') AND (lower(b.label) LIKE '%ttz%' OR lower(b.label) LIKE '%ttbarz%' OR lower(b.label) LIKE '%\\bar{t}%z%' OR lower(b.label) LIKE '%tt{z}%') ORDER BY a.paper_id, b.label LIMIT 100"}, "rows": 18, "error": null, "truncated": false, "preview": "paper_id | background | method | quote\n2004.14060 | $t\\bar{t}+Z$ background | Control-region-based background normalisation via simultaneous profile likelihood fit | the normalisations of these backgr"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT a.paper_id, b.entity_id AS background_id, b.label AS background, m.label AS method, ev.quote FROM assertion a JOIN entity b ON b.entity_id=a.subject_id JOIN entity m ON m.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.predicate='background_uses_method' AND a.paper_id='2401.05299' ORDER BY b.label LIMIT 100"}, "rows": 14, "error": null, "truncated": false, "preview": "paper_id | background_id | background | method | quote\n2401.05299 | hepkg:background:diboson-vv | $VV$ (diboson) background | MC-simulation-based background estimation | All backgrounds with the excep"}], "sets": {}, "entity_ids": ["hepkg:background:Wt", "hepkg:background:bbtautau_ttbar", "hepkg:background:diboson-vv", "hepkg:background:internal-conversion", "hepkg:background:material-conversion", "hepkg:background:nonprompt-hf", "hepkg:background:nonprompt_wz_ttz", "hepkg:background:other_ttx_ttz", "hepkg:background:others-minor", "hepkg:background:qmisid", "hepkg:background:rare-processes", "hepkg:background:singletop", "hepkg:background:top-quark", "hepkg:background:ttZ-3l", "hepkg:background:ttbar", "hepkg:background:ttbar-gamma", "hepkg:background:ttbarZ", "hepkg:background:tt