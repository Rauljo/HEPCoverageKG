'))) GROUP BY a.predicate,e.kind,e.label ORDER BY n DESC LIMIT 100"}, "rows": 11, "error": null, "truncated": false, "preview": "predicate | kind | label | n\nregion_requires_object | detector_object | Missing transverse momentum (p_T^miss) | 49\nresult_defines_object | detector_object | Missing transverse momentum (p_T^miss) | 1"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT p.arxiv_id,p.title, eo.kind,eo.label FROM paper p JOIN entity_occurrence eo ON eo.paper_id=p.arxiv_id WHERE p.category='search' AND eo.kind='detector_object' AND (lower(eo.label) LIKE '%b-tag%' OR lower(eo.label) LIKE '%b tag%') ORDER BY p.arxiv_id"}, "rows": 23, "error": null, "truncated": false, "preview": "arxiv_id | title | kind | label\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector | detector_o"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT p.arxiv_id,p.title, eo.kind,eo.label FROM paper p JOIN entity_occurrence eo ON eo.paper_id=p.arxiv_id WHERE p.category='search' AND eo.kind='detector_object' AND (lower(eo.label) LIKE '%missing transverse%' OR lower(eo.label) LIKE '%e_t%miss%' OR lower(eo.label) LIKE '%etmiss%' OR lower(eo.label)='met') ORDER BY p.arxiv_id"}, "rows": 26, "error": null, "truncated": false, "preview": "arxiv_id | title | kind | label\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV with the ATLA"}, {"tool": "sql", "round": 3, "args": {"query": "WITH b AS (SELECT DISTINCT a.paper_id FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.predicate IN ('region_requires_object','object_has_selection','region_has_selection') AND ((e.kind='detector_object' AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tag%' OR lower(e.label) LIKE '%b-jet%' OR lower(e.label) LIKE '%b jet%')) OR (e.kind='selection_requirement' AND lower(e.label) LIKE '%b-tag%'))), m AS (SELECT DISTINCT a.paper_id FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.predicate IN ('region_requires_object','object_has_selection','region_has_selection') AND e.kind='detector_object' AND (lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%p_t^miss%' OR lower(e.label) LIKE '%e_t^miss%' OR lower(e.label) LIKE '%met%')) SELECT p.arxiv_id,p.title FROM paper p JOIN b ON b.paper_id=p.arxiv_id JOIN m ON m.paper_id=p.arxiv_id WHERE p.category='search' ORDER BY p.arxiv_id"}, "rows": 9, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2006"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id,a.predicate,e.entity_id,e.kind,e.label FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.paper_id IN ('2004.14060','2006.05880','2010.14293','2012.03799','2012.08600','2102.01444','2106.01676','2106.14246','2107.12553','2112.03161','2201.11585','2202.08676','2209.07327','2211.08028','2302.05225','2307.01094','2403.01556','2407.10549','2506.13565','2508.13900','2510.07527') AND a.predicate IN ('region_requires_object','region_vetoes_object','region_has_selection','object_has_selection') AND ((e.kind='detector_object' AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tag%' OR lower(e.label) LIKE '%b-jet%' OR lower(e.label) LIKE '%b jet%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%met%')) OR e.kind='selection_requirement') ORDER BY a.paper_id,a.predicate,e.label LIMIT 200"}, "rows": 200, "error": null, "truncated": false, "preview": "paper_id | predicate | entity_id | kind | label\n2004.14060 | region_requires_object | hepkg:object:jet_r04 | detector_object | Calorimeter jet (anti-$k_t$, R=0.4)\n2004.14060 | region_requires_object |"}, {"tool": "sql"