{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-04", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses unfold their measured distributions -- that is, correct them back to particle level or truth level?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "I found 17 analyses that explicitly unfold distributions or cross sections to particle, parton, generator, or truth level:\n\n- **2001.06899** — Z + charm/bottom jets differential cross sections\n- **2103.04956** — Higgs → 4ℓ fiducial/differential cross sections\n- **2110.11231** — inclusive and differential WZ production\n- **2112.00895** — W + charm production at 8 TeV\n- **2206.09466** — Higgs → WW cross sections and STXS measurements\n- **2207.12246** — elastic pp scattering total cross section and ρ parameter\n- **2208.12095** — tt̄ charge asymmetry\n- **2303.15340** — dilepton tt̄ differential cross sections\n- **2308.02285** — W + charm production at 13 TeV\n- **2309.14442** — tt̄bb differential cross sections\n- **2312.04450** — tt̄Z differential cross sections\n- **2401.05299** — tt̄W differential cross sections\n- **2402.08486** — tt̄ and additional-jet differential cross sections\n- **2404.06204** — W- and Z-boson transverse-momentum spectra\n- **2408.03744** — inclusive W and Z cross sections\n- **2504.13081** — combined differential Higgs cross sections\n- **2506.13565** — high-mass dilepton + b-tagged-jet analysis, including an unfolded lepton-flavor-ratio distribution", "answered": true, "papers": ["2001.06899", "2103.04956", "2110.11231", "2112.00895", "2206.09466", "2207.12246", "2208.12095", "2303.15340", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2404.06204", "2408.03744", "2504.13081", "2506.13565"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "unfolding measured distributions corrected to particle level or truth level", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:method:unfolding-particle-parton | statistical_method | Unfolding of measurements to particle and parton levels\nhepkg:method:profile-likelihood-unfolding | statistical_m"}, {"tool": "search", "round": 1, "args": {"text": "particle-level unfolded differential cross section", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:result:wz-differential-xsec | result | Unfolded differential WZ cross section measurements\nhepkg:observable:dsigma-dpt-particle | observable | Differential cross section"}, {"tool": "search", "round": 1, "args": {"text": "truth-level correction unfolding iterative Bayesian matrix inversion", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:statmethod:iterative-bayesian-unfolding | statistical_method | Iterative Bayesian unfolding\nhepkg:method:fully_bayesian_unfolding | statistical_method | Fully Bayesian U"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, e.entity_id, e.label, a.predicate\nFROM assertion a\nJOIN entity e ON e.entity_id=a.object_id\nJOIN paper p ON p.arxiv_id=a.paper_id\nWHERE (a.predicate='result_uses_statistical_method' AND (lower(e.label) LIKE '%unfold%' OR lower(e.label) LIKE '%truth%' OR lower(e.label) LIKE '%particle%level%'))\n   OR (e.kind='result' AND lower(e.label) LIKE '%unfold%')\nORDER BY a.paper_id, e.label\nLIMIT 200"}, "rows": 22, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label | predicate\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, p.title\nFROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id\nWHERE a.predicate='result_uses_statistical_method' AND lower(e.label) LIKE '%unfold%'\nORDER BY a.paper_id"}, "rows": 12, "error": null, "truncated": false, "preview": "paper_id | title\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   TeV\n2110.11231 | Measu"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT ss.paper_id, p.title, COUNT(*) AS blocks\nFROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id\nWHERE lower(sb.text) LIKE '%unfold%'\nGROUP BY ss.paper_id,p.title ORDER BY ss.paper_id"}, "rows": 20, "error": null, "truncated": false, "preview": "paper_id | title | blocks\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   TeV | 15\n2103"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT eo.paper_id, p.title, eo.kind, eo.entity_id, eo.label\nFROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id\nWHERE lower(eo.label) LIKE '%unfold%'\nORDER BY eo.paper_id, eo.kind, eo.label\nLIMIT 200"}, "rows": 38, "error": null, "truncated": false, "preview": "paper_id | title | kind | entity_id | label\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=1"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT eo.paper_id,p.title,eo.entity_id,eo.label\nFROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id\nWHERE eo.entity_id IN ('hepkg:statmethod:iterative-bayesian-unfolding','hepkg:method:profile-likelihood-unfolding','hepkg:method:fully_bayesian_unfolding','hepkg:method:unfolding-particle-parton','hepkg:method:tunfold_least_squares_unfolding','hepkg:method:iterative_unfolding')\nORDER BY eo.paper_id"}, "rows": 7, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   Te"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT ss.paper_id,p.title,sb.section_title,substr(sb.text,1,700) AS text\nFROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id\nWHERE ss.paper_id IN ('2103.04956','2112.00895','2303.15340','2504.13081','2506.13565') AND lower(sb.text) LIKE '%unfold%'\nORDER BY ss.paper_id,sb.block_order LIMIT 50"}, "rows": 9, "error": null, "truncated": false, "preview": "paper_id | title | section_title | text\n2103.04956 | Measurements of production cross sections of the Higgs boson in the four-lepton final state in proton-proton collisions at $\\sqrt{s}=13\\,\\text{Te\\h"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT DISTINCT eo.paper_id,p.title,eo.kind,eo.entity_id,eo.label\nFROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id\nWHERE (lower(eo.label) LIKE '%particle level%' OR lower(eo.label) LIKE '%particle-level%' OR lower(eo.label) LIKE '%truth level%' OR lower(eo.label) LIKE '%truth-level%')\nAND eo.kind IN ('result','observable','statistical_method')\nORDER BY eo.paper_id,eo.kind LIMIT 200"}, "rows": 5, "error": null, "truncated": false, "preview": "paper_id | title | kind | entity_id | label\n2110.11231 | Measurement of the inclusive and differential ${\\mathup{{{W}}}}{\\mathup{{{Z}}}}$ production cross sections, polarization angles, and triple gau"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT ss.paper_id,p.title,sb.section_title,substr(sb.text,1,1200) AS text\nFROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id\nWHERE ss.paper_id IN ('2408.03744','2506.13565','2206.09466') AND lower(sb.text) LIKE '%unfold%'\nORDER BY ss.paper_id,sb.block_order LIMIT 30"}, "rows": 3, "error": null, "truncated": false, "preview": "paper_id | title | section_title | text\n2206.09466 | Measurements of the Higgs boson production cross section and couplings in the $\\mathup{{{W}}}$ boson pair decay channel in proton-proton collisions"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT DISTINCT a.paper_id,p.title,e.entity_id,e.label,a.predicate\nFROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id\nWHERE a.paper_id IN ('2103.04956','2112.00895','2303.15340','2504.13081','2408.03744','2506.13565')\nAND (lower(e.label) LIKE '%unfold%' OR lower(e.label) LIKE '%particle level%' OR lower(e.label) LIKE '%generator-level%')\nORDER BY a.paper_id,e.label LIMIT 100"}, "rows": 12, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label | predicate\n2103.04956 | Measurements of production cross sections of the Higgs boson in the four-lepton final state in proton-proton collisions at $\\sqrt{s}=13\\,\\"}], "sets": {}, "entity_ids": ["hepkg:final_state:emu_fiducial_particle_level", "hepkg:generator:powheg", "hepkg:generator:powheg-v2", "hepkg:generator:powheg2", "hepkg:generator:powheg_box", "hepkg:method:asimov-closure-test", "hepkg:method:bayesian-eftfitter-batjl", "hepkg:method:bayesian-pdf-reweighting", "hepkg:method:binned-ml-fit-simultaneous", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2-compatibility-test", "hepkg:method:data_driven_closure_test", "hepkg:method:fully_bayesian_unfolding", "hepkg:method:iterative_unfolding", "hepkg:method:matrix-method", "hepkg:method:profile-likelihood-unfolding", "hepkg:method:statistical_covariance_matrix", "hepkg:method:svd_unfolding_crosscheck", "hepkg:method:tikhonov-regularisation", "hepkg:method:tunfold-least-squares-unfolding", "hepkg:method:tunfold-unfolding", "hepkg:method:tunfold_least_squares_unfolding", "hepkg:method:unfolding-particle-parton", "hepkg:object:jet_particle", "hepkg:object:lepton_particle", "hepkg:object:muon_particle", "hepkg:object:pseudo-top-particle-4l", "hepkg:observable:diff_el_cross_section", "hepkg:observable:dsigma-deta-particle", "hepkg:observable:dsigma-dpt-particle", "hepkg:observable:sigma-wc-particle-inclusive", "hepkg:observable:stxs-xsec", "hepkg:observable:wz-fiducial-xsec", "hepkg:region:emu_fiducial_particle", "hepkg:region:fiducial-3l-particle", "hepkg:region:fiducial-4l-particle", "hepkg:region:fiducial-particle", "hepkg:region:fiducial-region", "hepkg:region:fiducial_phase_space", "hepkg:region:w_fiducial", "hepkg:region:z-ll-fiducial", "hepkg:result:ttbar_differential_xsec_generic", "hepkg:result:wminus-pt-13tev", "hepkg:result:wminus-pt-5p02tev", "hepkg:result:wplus-pt-13tev", "hepkg:result:wplus-pt-5p02tev", "hepkg:result:wz-differential-xsec", "hepkg:result:z-pt-ll-13tev", "hepkg:result:z-pt-ll-5p02tev", "hepkg:result:z-pt-ut-13tev", "hepkg:result:z-pt-ut-5p02tev", "hepkg:sample:ttbar_signal", "hepkg:statmethod:iterative-bayesian-unfolding", "hepkg:statmethod:principal-component-analysis", "hepkg:statmethod:pseudodata_closure_test", "hepkg:statmethod:tunfold_regularized_unfolding", "hepkg:systematic:background-related-uncertainty-differential", "hepkg:systematic:pdf_scale_variation", "hepkg:systematic:signal-generator-modelling", "hepkg:systematic:unfolding-prior-uncertainty", "hepkg:systematic:unfolding-uncertainty", "hepkg:systematic:unfolding_bias", "hepkg:systematic:unfolding_closure"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 50183, "completion_tokens": 2227, "rounds": 6, "seconds": 27.13956928253174, "reviews": [], "recovered_calls": 0, "cited": "answer.papers", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 27.13956928253174, "llm_calls": 6.0, "tokens": 52410.0, "rounds": 6.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_i