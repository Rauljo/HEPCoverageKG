{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-01-condition", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses use b-tagged jets (jets identified as containing a b-hadron) in their event selection?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The graph identifies 39 analyses that use b-tagged jets in their event selection: arXiv:2006.05880, 2007.02873, 2009.04363, 2010.14293, 2012.03799, 2012.08600, 2102.01444, 2103.04956, 2103.06956, 2106.01676, 2106.14246, 2107.12553, 2109.13808, 2110.11231, 2111.08340, 2112.03161, 2201.11585, 2202.08676, 2205.05120, 2206.09466, 2207.00348, 2209.07327, 2211.08028, 2302.05225, 2307.01094, 2308.02285, 2309.14442, 2312.04450, 2401.05299, 2402.08486, 2403.01556, 2503.19420, 2506.13565, 2508.13900, 2510.07527, 2511.11853, 2602.18611, 2604.21670, and 2604.27044.", "answered": true, "papers": ["2006.05880", "2007.02873", "2009.04363", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2111.08340", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2209.07327", "2211.08028", "2302.05225", "2307.01094", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2403.01556", "2503.19420", "2506.13565", "2508.13900", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets, jets identified as containing a b-hadron, used in event selection", "kind": "", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:object:b_jet | detector_object | b-hadron-containing jet\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-relaxed | detector_object | b-tagged j"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT e.kind, e.entity_id, e.label, COUNT(DISTINCT eo.paper_id) AS papers FROM entity e LEFT JOIN entity_occurrence eo ON eo.entity_id=e.entity_id WHERE lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tag%' OR lower(e.label) LIKE '%b-hadron-containing jet%' OR lower(e.label) LIKE '%b jet%' OR lower(e.label) LIKE '%b-jet%' GROUP BY e.kind,e.entity_id,e.label ORDER BY e.kind,e.label LIMIT 200"}, "rows": 150, "error": null, "truncated": false, "preview": "kind | entity_id | label | papers\nbackground | hepkg:background:total-smooth-mJgamma | Total SM background in m_{Jγ} spectrum (single- and double-b-tagged categories) | 1\nbackground | hepkg:background"}, {"tool": "sql", "round": 3, "args": {"query": "WITH bobj AS (SELECT entity_id FROM entity WHERE kind='detector_object' AND (lower(label) LIKE '%b-tag%' OR lower(label) LIKE '%b tag%' OR lower(label) LIKE '%b jet%' OR lower(label) LIKE '%b-jet%' OR lower(label) LIKE '%b-hadron-containing jet%')) SELECT a.predicate, COUNT(DISTINCT a.paper_id) AS n_papers, COUNT(*) AS n_assertions FROM assertion a WHERE (a.object_id IN (SELECT entity_id FROM bobj) OR a.subject_id IN (SELECT entity_id FROM bobj)) GROUP BY a.predicate ORDER BY n_papers DESC"}, "rows": 7, "error": null, "truncated": false, "preview": "predicate | n_papers | n_assertions\nresult_defines_object | 44 | 58\nobject_has_selection | 44 | 105\nregion_requires_object | 38 | 200\nregion_vetoes_object | 20 | 99\nresult_defines_region | 1 | 1\nregio"}, {"tool": "sql", "round": 4, "args": {"query": "WITH bobj AS (SELECT entity_id FROM entity WHERE kind='detector_object' AND (lower(label) LIKE '%b-tag%' OR lower(label) LIKE '%b tag%' OR lower(label) LIKE '%b jet%' OR lower(label) LIKE '%b-jet%' OR lower(label) LIKE '%b-hadron-containing jet%')), req AS (SELECT DISTINCT paper_id FROM assertion WHERE predicate='region_requires_object' AND object_id IN (SELECT entity_id FROM bobj)), objsel AS (SELECT DISTINCT paper_id FROM assertion WHERE predicate='object_has_selection' AND subject_id IN (SELECT entity_id FROM bobj)) SELECT p.arxiv_id,p.title, CASE WHEN r.paper_id IS NOT NULL THEN 1 ELSE 0 END AS region_requires, CASE WHEN o.paper_id IS NOT NULL THEN 1 ELSE 0 END AS bobject_defined FROM paper p LEFT JOIN req r ON r.paper_id=p.arxiv_id LEFT JOIN objsel o ON o.paper_id=p.arxiv_id WHERE r.paper_id IS NOT NULL OR o.paper_id IS NOT NULL ORDER BY p.arxiv_id"}, "rows": 45, "error": null, "truncated": false, "preview": "arxiv_id | title | region_requires | bobject_defined\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT COUNT(DISTINCT eo.paper_id) AS n, GROUP_CONCAT(DISTINCT eo.paper_id) AS arxiv_ids FROM entity_occurrence eo WHERE eo.kind='detector_object' AND (lower(eo.label) LIKE '%b-tag%' OR lower(eo.label) LIKE '%b tag%' OR lower(eo.label) LIKE '%b jet%' OR lower(eo.label) LIKE '%b-jet%' OR lower(eo.label) LIKE '%b-hadron-containing jet%')"}, "rows": 1, "error": null, "truncated": false, "preview": "n | arxiv_ids\n39 | 2006.05880,2007.02873,2009.04363,2010.14293,2012.03799,2012.08600,2102.01444,2103.04956,2103.06956,2106.01676,2106.14246,2107.12553,2109.13808,2110.11231,2111.08340,2112.03161,2201."}], "sets": {}, "entity_ids": ["hepkg:background:lost_tw_background", "hepkg:background:mt_background", "hepkg:background:mw_background", "hepkg:background:total-smooth-mJgamma", "hepkg:channel:diphoton_top_quarks", "hepkg:final-state:dilepton-0b", "hepkg:final-state:dilepton-2b", "hepkg:final_state:1lepton-4b-higgs-met", "hepkg:final_state:3lepton-Z-jets-met", "hepkg:final_state:alljets_met_0lepton", "hepkg:final_state:bb-large-R-jet", "hepkg:final_state:ggh-dimuon-untagged", "hepkg:final_state:lepjets_ge5j_ge3b", "hepkg:final_state:met-4jets-3bjets-0or1lepton", "hepkg:final_state:tth-dimuon-bjets", "hepkg:finalstate:diphoton_tHq_leptonic", "hepkg:finalstate:diphoton_ttH_hadr