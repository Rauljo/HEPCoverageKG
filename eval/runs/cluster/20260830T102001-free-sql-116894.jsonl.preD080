{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-07", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses have a ttZ background and a control region used to normalise that background?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The analyses are arXiv:2004.14060, 2006.05880, 2012.03799, 2102.01444, 2110.11231, 2202.08676, and 2401.05299. I excluded 2106.14246 because its ttZ-enriched control region is used only to verify the simulation prediction, not to normalise the background.", "answered": true, "papers": ["2004.14060", "2006.05880", "2012.03799", "2102.01444", "2110.11231", "2202.08676", "2401.05299"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ttZ background", "kind": "background", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background:ttz | background | ttZ irreducible background\nhepkg:background:ttz-tzq | background | ttZ and tZq irreducible background\nhepkg:background:ttx_prompt | backgro"}, {"tool": "search", "round": 1, "args": {"text": "control region used to normalize ttZ background", "kind": "event_region", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:region:cr-ttz | event_region | ttZ/tZq control region (CR-ttZ)\nhepkg:region:3l-ttz-cr | event_region | 3ℓ ttZ Control Region\nhepkg:region:cr-bins | event_region | Contro"}, {"tool": "search", "round": 1, "args": {"text": "normalisation using a control region", "kind": "background_method", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:method:cr-normalization-fit | background_method | Control-region-based normalisation via simultaneous likelihood fit\nhepkg:method:crw | background_method | W+jets contro"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, a.subject_id AS background_id, eb.label AS background, a.predicate, a.object_id, eo.kind AS object_kind, eo.label AS object_label, a.qualifiers FROM assertion a JOIN entity eb ON eb.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ','hepkg:background:ttx_prompt','hepkg:background:top-quark') ORDER BY a.paper_id, a.subject_id, a.predicate LIMIT 200"}, "rows": 11, "error": null, "truncated": false, "preview": "paper_id | background_id | background | predicate | object_id | object_kind | object_label | qualifiers\n2004.14060 | hepkg:background:ttbarZ | $t\\bar{t}+Z$ background | background_uses_method | hepkg:"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT e.entity_id, e.kind, e.label, GROUP_CONCAT(DISTINCT eo.paper_id) AS papers FROM entity e LEFT JOIN entity_occurrence eo ON eo.entity_id=e.entity_id WHERE (lower(e.label) LIKE '%ttz%' OR lower(e.label) LIKE '%ttbar%z%' OR lower(e.label) LIKE '%t\\bar{t}%z%') GROUP BY e.entity_id HAVING e.kind IN ('background','event_region','background_method') ORDER BY e.kind,e.label LIMIT 200"}, "rows": 31, "error": null, "truncated": false, "preview": "entity_id | kind | label | papers\nhepkg:background:others-minor | background | \"Others\" minor background category ($VVV$, $t\\bar{t}t$, $t\\bar{t}t\\bar{t}$, $t\\bar{t}W$, $t\\bar{t}WW$, $t\\bar{t}WZ$, $t\\b"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id, eb.label AS background, em.label AS method, a.qualifiers, ev.section_title, ev.quote FROM assertion a JOIN entity eb ON eb.entity_id=a.subject_id JOIN entity em ON em.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.predicate='background_uses_method' AND a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ','hepkg:background:ttx_prompt','hepkg:background:ttz-bkg','hepkg:background:ttz-gammastar') ORDER BY a.paper_id LIMIT 100"}, "rows": 18, "error": null, "truncated": false, "preview": "paper_id | background | method | qualifiers | section_title | quote\n2004.14060 | $t\\bar{t}+Z$ background | Control-region-based background normalisation via simultaneous profile likelihood fit | {} | "}, {"tool": "sql", "round": 5, "args": {"query": "SELECT a.paper_id, eb.label AS background, em.label AS method, a.qualifiers, ev.section_title, ev.quote FROM assertion a JOIN entity eb ON eb.entity_id=a.subject_id JOIN entity em ON em.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.predicate='background_uses_method' AND a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-bkg','hepkg:background:ttz-gammastar') ORDER BY a.paper_id LIMIT 100"}, "rows": 4, "error": null, "truncated": false, "preview": "paper_id | background | method | qualifiers | section_title | quote\n2202.08676 | ttZ irreducible background | Normalization to data in dedicated control regions | {} | Irreducible backgrounds | These "}], "sets": {}, "entity_ids": ["hepkg:background:Wt", "hepkg:background:bbtautau_ttbar", "hepkg:background:flavor_symmetric", "hepkg:background:fnp-lepton-rjr", "hepkg:background:mw_background", "hepkg:background:nonprompt_wz_ttz", "hepkg:background:other", "hepkg:background:other_ttx_ttz", "hepkg:background:others-minor", "hepkg:background:singletop", "hepkg:background:top-quark", "hepkg:background:ttZ-3l", "hepkg:background:ttbar", "hepkg:background:ttbar-gamma", "hepkg:background:ttbarZ", "hepkg:background:ttbar_background", "hepkg:background:tttt", "hepkg:background:ttv-twz", "hepkg:background:ttv-tz", "hepkg:background:ttx_prompt", "hepkg:background:ttz", "hepkg:background:ttz-bkg", "hepkg:background:ttz-gammastar", "hepkg:background:ttz-tzq", "hepkg:background:twz", "hepkg:background:tzq", "hepkg:background:wz", "