{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-01", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses are searches (rather than measurements) whose event selection uses both b-tagged jets and missing transverse momentum?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The graph identifies 21 search analyses whose event selections use both b-tagged jets and missing transverse momentum: arXiv:2006.05880, 2010.14293, 2012.03799, 2012.08600, 2102.01444, 2106.01676, 2106.14246, 2107.12553, 2112.03161, 2201.11585, 2202.08676, 2209.07327, 2211.08028, 2302.05225, 2307.01094, 2403.01556, 2506.13565, 2508.13900, 2509.22535, 2510.07527, and 2511.11853.", "answered": true, "papers": ["2006.05880", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2106.01676", "2106.14246", "2107.12553", "2112.03161", "2201.11585", "2202.08676", "2209.07327", "2211.08028", "2302.05225", "2307.01094", "2403.01556", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets used as detector objects in event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:bjet_tight_detector | detector_object | b-tagged jet, detector level, DeepJet tight working point\nhepkg:object:bjet | detector_object | b-tagged jets (MV2c10 algo"}, {"tool": "search", "round": 1, "args": {"text": "missing transverse momentum MET ETmiss used in event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object_selection:met_1L2L | selection_requirement | 1L/2L channel missing transverse momentum selection\nhepkg:systematic:met_selection_efficiency | systematic_uncertaint"}, {"tool": "sql", "round": 2, "args": {"query": "WITH req AS (\n SELECT a.paper_id, a.subject_id AS region_id, e.entity_id, e.kind, e.label\n FROM assertion a JOIN entity e ON e.entity_id=a.object_id\n WHERE a.predicate='region_requires_object'\n), flags AS (\n SELECT paper_id,\n  MAX(CASE WHEN lower(label) LIKE '%b-tag%' OR lower(label) LIKE '%b tagged%' OR lower(label) LIKE '%b jet%' OR lower(label) LIKE '%b-jet%' THEN 1 ELSE 0 END) has_b,\n  MAX(CASE WHEN lower(label) LIKE '%missing transverse%' OR lower(label) LIKE '%e_t%miss%' OR lower(label) LIKE '%etmiss%' OR lower(label) LIKE '%p_t%miss%' OR lower(label) LIKE '%ptmiss%' THEN 1 ELSE 0 END) has_met\n FROM req GROUP BY paper_id\n)\nSELECT p.arxiv_id,p.title,flags.has_b,flags.has_met FROM flags JOIN paper p ON p.arxiv_id=flags.paper_id WHERE p.category='search' AND has_b=1 AND has_met=1 ORDER BY p.arxiv_id LIMIT 200"}, "rows": 8, "error": null, "truncated": false, "preview": "arxiv_id | title | has_b | has_met\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector | 1 | 1\n2"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.paper_id, a.subject_id AS region_id, e.entity_id, e.label\nFROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id\nWHERE a.predicate='region_requires_object' AND p.category='search' AND a.paper_id IN ('2006.05880','2106.01676','2106.14246','2107.12553','2112.03161','2209.07327','2211.08028','2508.13900')\nAND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tagged%' OR lower(e.label) LIKE '%b jet%' OR lower(e.label) LIKE '%b-jet%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%etmiss%' OR lower(e.label) LIKE '%ptmiss%')\nORDER BY a.paper_id, region_id, e.label LIMIT 200"}, "rows": 94, "error": null, "truncated": false, "preview": "paper_id | region_id | entity_id | label\n2006.05880 | hepkg:object:CR-Z-VV | hepkg:object:met | Missing transverse momentum (p_T^miss)\n2006.05880 | hepkg:object:CR-Z-ttZ | hepkg:object:met | Missing t"}, {"tool": "sql", "round": 4, "args": {"query": "WITH f AS (\n SELECT eo.paper_id,\n MAX(CASE WHEN lower(eo.label) LIKE '%b-tag%' OR lower(eo.label) LIKE '%b tagged%' OR lower(eo.label) LIKE '%b-jet%' OR lower(eo.label) LIKE '%b jet%' THEN 1 ELSE 0 END) b,\n MAX(CASE WHEN lower(eo.label) LIKE '%missing transverse%' OR lower(eo.label) LIKE '%etmiss%' OR lower(eo.label) LIKE '%ptmiss%' THEN 1 ELSE 0 END) met\n FROM entity_occurrence eo WHERE eo.kind IN ('detector_object','selection_requirement') GROUP BY eo.paper_id)\nSELECT p.arxiv_id,p.title FROM paper p JOIN f ON f.paper_id=p.arxiv_id WHERE p.category='search' AND b=1 AND met=1 ORDER BY p.arxiv_id LIMIT 200"}, "rows": 21, "error": null, "truncated": false, "preview": "arxiv_id | title\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2010.14293 | Search for squ"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT eo.paper_id, eo.kind, eo.entity_id, eo.label FROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id WHERE p.category='search' AND eo.paper_id IN ('2006.05880','2010.14293','2012.03799','2012.08600','2102.01444','2106.01676','2106.14246','2107.12553','2112.03161','2201.11585','2202.08676','2209.07327','2211.08028','2302.05225','2307.01094','2403.01556','2506.13565','2508.13900','2509.22535','2510.07527','2511.11853') AND eo.kind IN ('detector_object','selection_requirement') AND (lower(eo.label) LIKE '%b-tag%' OR lower(eo.label) LIKE '%b tagged%' OR lower(eo.label) LIKE '%b-jet%' OR lower(eo.label) LIKE '%b jet%' OR lower(eo.label) LIKE '%missing transverse%' OR lower(eo.label) LIKE '%etmiss%' OR lower(eo.label) LIKE '%ptmiss%') ORDER BY eo.paper_id, eo.kind, eo.label LIMIT 200"}, "rows": 49, "error": null, "truncated": false, "preview": "paper_id | kind | entity_id | label\n2006.05880 | detector_object | hepkg:object:higgs-boson-candidate | Higgs boson candidate (h->bb jet pair, NN-tagged)\n2006.05880 | detector_object | hepkg:object:me"}], "sets": {}, "entity_ids": ["hepkg:final-state:dilepton-0b", "hepkg:final-state:dilepton-2b", "hepkg:final_state:bb-large-R-jet", "hepkg:final_state:tth-dimuon-bjets", "hepkg:finalstate:diphoton_zero_lepton_met", "hepkg:object:CR-Z-VV", "hepkg:object:CR-Z-ttZ", "hepkg:object:CR-h-ttbar", "hepkg:object:SR-Z-1A", "hepkg:object:SR-Z-1B", "hepkg:object:SR-Z-2A", "hepkg:object:SR-Z-2B", "hepkg:object:SR-h-1A", "hepkg:object:SR-h-1AB", "hepkg:object:SR-h-1B", "hepkg:object:VR-Z-1F", "hepkg:object:VR-Z-2F", "hepkg:object:VR-Z-VV-btag", "hepkg:object:VR-Z-VV-njet", "hepkg:object:VR-Z-ttZ", "hepkg:object:ak4_b_jet", "hepkg:object:b-jet", "hepkg:object:b-tagged-ak4-jet", "hepkg:object:b-tagged-jet", "hepkg:object:b_jet", "hepkg:object:b_tagged_jet", "hepkg:object:bjet", "hepkg:object:bjet-relaxed", "hepkg:object:bjet-tight", "hepkg:object:bjet_medium_detector", "hepkg:object:bjet_reco", "hepkg:object:bjet_tight_detector", "hepkg:object:btrackjet", "hepkg:object:etmiss", "hepkg:object:higgs-boson-candidate", "hepkg:object:met", "hepkg:object:met-particle", "hepkg:object:met_reco", "hepkg:object:met_track", "hepkg:object:missing-transverse-momentum", "hepkg:object:missing_et", "hepkg:object:missing_transverse_momentum", "hepkg:object:neutrino", "hepkg:object:non_b_tagged_jet", "hepkg:object:soft-b-tag", "hepkg:object:track_met", "hepkg:object_selection:bjet_count_baseline", "hepkg:object_selection:btag_efficiency", "hepkg:object_selection:met_1L2L", "hepkg:observable:b_jet_tagging_efficiency", "hepkg:region:0l-5j", "hepkg:region:2lss_sr", "hepkg:region:baseline", "hepkg:region:cat_vbf_1jet_tagged", "hepkg:region:cat_vbf_2jet_tagged", "hepkg:region:cr-w", "hepkg:region:dl_search_region", "hepkg:region:ml-sr", "hepkg:region:preselection", "hepkg:region:signal-regions", "hepkg:region:sl-cr-deepak8", "hepkg:region:sl-cr-ttbar", "hepkg:region:sl-cr-wjets", "hepkg:region:sl-sr", "hepkg:region:sr-0b", "hep