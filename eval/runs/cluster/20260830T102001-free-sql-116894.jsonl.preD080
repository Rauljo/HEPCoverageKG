{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-03", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses use the HistFitter framework for their statistical analysis?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The graph identifies four analyses that use HistFitter for statistical analysis:\n\n- **2006.05880** — *Search for top squarks in events with a Higgs or Z boson using 139 fb⁻¹ of pp collision data at √s = 13 TeV with the ATLAS detector*\n- **2011.07812** — *Search for displaced leptons in √s = 13 TeV pp collisions with the ATLAS detector*\n- **2106.01676** — *Search for chargino–neutralino pair production in final states with three leptons and missing transverse momentum in √s = 13 TeV pp collisions with the ATLAS detector*\n- **2211.08028** — *Search for supersymmetry in final states with missing transverse momentum and three or more b-jets in 139 fb⁻¹ of proton–proton collisions at √s = 13 TeV with the ATLAS detector*\n\nI excluded an analysis that used **pyhf** and only reported validation against HistFitter.", "answered": true, "papers": ["2006.05880", "2011.07812", "2106.01676", "2211.08028"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "HistFitter framework used for statistical analysis", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:method:histfitter | statistical_method | HistFitter statistical framework\nhepkg:method:profile-likelihood-fit | statistical_method | HistFitter fit\nhepkg:method:profile-"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, a.predicate, e.entity_id, e.label FROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id WHERE (e.entity_id IN ('hepkg:method:histfitter','hepkg:method:profile-likelihood-fit','hepkg:method:profile-likelihood-fit-histfitter') OR lower(e.label) LIKE '%histfitter%') ORDER BY a.paper_id, e.entity_id LIMIT 200"}, "rows": 7, "error": null, "truncated": false, "preview": "paper_id | title | predicate | entity_id | label\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS dete"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT eo.paper_id, p.title, eo.entity_id, eo.label FROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id WHERE lower(eo.label) LIKE '%histfitter%' ORDER BY eo.paper_id, eo.entity_id LIMIT 200"}, "rows": 6, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label\n2006.05880 | Search for top squarks in events with a Higgs or $Z$ boson using 139 fb -1 of $pp$ collision data at $\\sqrt{s}=13$ TeV with the ATLAS detector | hepkg"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.paper_id, a.assertion_id, a.object_id, eo.label AS paper_label, a.support, ev.quote FROM assertion a LEFT JOIN entity_occurrence eo ON eo.paper_id=a.paper_id AND eo.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.predicate='result_uses_statistical_method' AND (a.object_id IN ('hepkg:method:histfitter','hepkg:method:profile-likelihood-fit','hepkg:method:profile-likelihood-fit-histfitter','hepkg:method:pyhf-combination') OR lower(eo.label) LIKE '%histfitter%') ORDER BY a.paper_id, a.object_id LIMIT 200"}, "rows": 9, "error": null, "truncated": false, "preview": "paper_id | assertion_id | object_id | paper_label | support | quote\n2006.05880 | hepkg:assertion:9e57c68e01a5b7fcd7e517a5 | hepkg:method:histfitter | HistFitter statistical framework | explicit | The "}], "sets": {}, "entity_ids": ["hepkg:assertion:02bc5b2686d59e7809dde790", "hepkg:assertion:2371ab50d18ce9500df37aeb", "hepkg:assertion:9e57c68e01a5b7fcd7e517a5", "hepkg:assertion:c3d98c05b03ead8abe0724ae", "hepkg:assertion:c8550f45f49383ac2a1dbe6b", "hepkg:assertion:e3caa182f9c12ba0ef47e3c3", "hepkg:assertion:f66a71f2b5d3c91cdc662644", "hepkg:method:bayesian-eftfitter-batjl", "hepkg:method:bootstrap_compatibility", "hepkg:method:bootstrap_correlation_test", "hepkg:method:combine_tool", "hepkg:method:histfitter", "hepkg:method:profile-likelihood-fit", "hepkg:method:profile-likelihood-fit-histfitter", "hepkg:method:pyhf-combination", "hepkg:method:simplified-likelihood-reinterpretation", "hepkg:model:coupling_modifier_framework", "hepkg:model:kappa-framework", "hepkg:model:kappa-framework-hh", "hepkg:model:susy-simplified-models", "hepkg:region:AR", "hepkg:region:hmumu_categories", "hepkg:region:stxs-analysis-regions-45", "hepkg:sample:vbf_hbb_ggf_vbf_sample", "hepkg:statistical_method:combine_roofit_roostats_tool", "hepkg:statmethod:combine_roofit_roostats", "hepkg:systematic:statistical-mc"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 4, "prompt_tokens": 14152, "completion_tokens": 883, "rounds": 4, "seconds": 15.632126808166504, "reviews": [], "recovered_calls": 0, "cited": "answer.papers", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 15.632126808166504, "llm_calls": 4.0, "tokens": 15035.0, "rounds": 4.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "judged_precision": 1.0, "judged_recall": 0.8, "judged_f1": 0.888888888888889, "judged_named_none": 0.0, "judged_coverage": 0.15, "retrieval_reach": 0.8, "tool_calls": 4.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 27.0, "evidence_quotes": 0.0}}
{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-04", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses unfold their measured distributions -- that is, correct them back to particle level or truth level?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The graph identifies 16 analyses that correct measured spectra or binned measurements to particle, parton, generator, or truth level:\n\n- 2001.06899 — Z production with charm or bottom jets\n- 2009.14537 — forward proton scattering with photon-fusion dileptons\n- 2103.04956 — Higgs production in the four-lepton final state\n- 2103.06956 — Higgs production in the diphoton channel\n- 2110.11231 — inclusive and differential WZ production\n- 2112.00895 — W-boson plus charm production\n- 2206.09466 — Higgs production in the WW decay channel\n- 2207.12246 — elastic pp scattering total cross section and rho parameter\n- 2208.12095 — ttbar charge asymmetry\n- 2303.15340 — dilepton ttbar differential cross sections\n- 2308.02285 — W-boson plus charm production\n- 2309.14442 — differential ttbarbb production\n- 2312.04450 — differential ttbarZ production\n- 2401.05299 — differential ttbarW production\n- 2402.08486 — ttbar and additional-jet differential cross sections\n- 2404.06204 — W- and Z-boson transverse-momentum spectra", "answered": true, "papers": ["2001.06899", "2009.14537", "2103.04956", "2103.06956", "2110.11231", "2112.00895", "2206.09466", "2207.12246", "2208.12095", "2303.15340", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2404.06204"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "unfolding measured distributions corrected to particle level or truth level", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:method:unfolding-particle-parton | statistical_method | Unfolding of measurements to particle and parton levels\nhepkg:method:profile-likelihood-unfolding | statistical_m"}, {"tool": "sql", "round": 1, "args": {"query": "SELECT paper_id, section_title, substr(text,1,500) AS text FROM source_block WHERE (lower(text) LIKE '%unfold%' AND (lower(text) LIKE '%particle level%' OR lower(text) LIKE '%particle-level%' OR lower(text) LIKE '%truth level%' OR lower(text) LIKE '%truth-level%')) LIMIT 100"}, "rows": 0, "error": "no such column: paper_id", "truncated": false, "preview": "ERROR: no such column: paper_id"}, {"tool": "sql", "round": 1, "args": {"query": "SELECT predicate, COUNT(*) AS n FROM assertion WHERE lower(object_value) LIKE '%unfold%' OR lower(notes) LIKE '%unfold%' OR lower(qualifiers) LIKE '%unfold%' GROUP BY predicate ORDER BY n DESC LIMIT 50"}, "rows": 9, "error": null, "truncated": false, "preview": "predicate | n\nresult_measures_observable | 421\nresult_uses_statistical_method | 20\nresult_has_systematic | 7\nresult_uses_sample | 7\nresult_reports_quantity | 6\nresult_defines_region | 3\nresult_defines"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, e.entity_id, e.label AS method FROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id WHERE a.predicate='result_uses_statistical_method' AND lower(e.label) LIKE '%unfold%' ORDER BY a.paper_id, e.label"}, "rows": 22, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | method\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   T"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT ss.paper_id, p.title, sb.section_title, substr(sb.text,1,700) AS excerpt FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id WHERE lower(sb.text) LIKE '%unfold%' AND (lower(sb.text) LIKE '%particle level%' OR lower(sb.text) LIKE '%particle-level%' OR lower(sb.text) LIKE '%truth level%' OR lower(sb.text) LIKE '%truth-level%') ORDER BY ss.paper_id LIMIT 200"}, "rows": 72, "error": null, "truncated": false, "preview": "paper_id | title | section_title | excerpt\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, e.entity_id, e.kind, e.label, a.predicate FROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id WHERE lower(e.label) LIKE '%unfold%' ORDER BY a.paper_id, a.predicate, e.kind"}, "rows": 30, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | kind | label | predicate\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT ss.paper_id, p.title FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id WHERE lower(sb.text) LIKE '%unfold%' ORDER BY ss.paper_id"}, "rows": 20, "error": null, "truncated": false, "preview": "paper_id | title\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   TeV\n2103.04956 | Measu"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, e.entity_id, e.label AS method FROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id WHERE a.predicate='result_uses_statistical_method' AND (lower(e.label) LIKE '%unfold%' OR lower(e.label) LIKE '%detector%correct%' OR lower(e.label) LIKE '%bin-by-bin%') ORDER BY a.paper_id, e.label"}, "rows": 22, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | method\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   T"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT ss.paper_id, p.title FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash JOIN paper p ON p.arxiv_id=ss.paper_id WHERE (lower(sb.text) LIKE '%corrected to particle level%' OR lower(sb.text) LIKE '%corrected to particle-level%' OR lower(sb.text) LIKE '%corrected to truth level%' OR lower(sb.text) LIKE '%corrected to truth-level%' OR lower(sb.text) LIKE '%at particle level%' OR lower(sb.text) LIKE '%particle-level differential%') AND p.category='measurement' ORDER BY ss.paper_id"}, "rows": 8, "error": null, "truncated": false, "preview": "paper_id | title\n2009.14537 | Observation and measurement of forward proton scattering in association with lepton pairs produced via the photon fusion mechanism at ATLAS\n2103.06956 | Measurements of H"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT ss.paper_id, sb.section_title, substr(sb.text,1,1200) AS excerpt FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash WHERE ss.paper_id IN ('2103.04956','2112.00895','2206.09466','2303.15340','2309.14442','2402.08486','2404.06204','2103.06956','2009.14537') AND lower(sb.text) LIKE '%unfold%' ORDER BY ss.paper_id, sb.block_order LIMIT 100"}, "rows": 77, "error": null, "truncated": false, "preview": "paper_id | section_title | excerpt\n2103.04956 | Fiducial cross section | A maximum likelihood fit of the signal and background parameterizations to the observed $4\\ell$\nmass distribution, $N_{\\mathrm{"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT ss.paper_id, sb.section_title, substr(sb.text,1,900) AS excerpt FROM source_block sb JOIN source_snapshot ss ON ss.source_hash=sb.source_hash WHERE ss.paper_id IN ('2309.14442','2402.08486','2404.06204','2103.06956','2009.14537') AND lower(sb.text) LIKE '%unfold%' ORDER BY ss.paper_id, sb.block_order LIMIT 80"}, "rows": 71, "error": null, "truncated": false, "preview": "paper_id | section_title | excerpt\n2309.14442 | Abstract | Measurements of inclusive and normalized differential cross sections of the associated production of top quark-antiquark and bottom quark-ant"}], "sets": {}, "entity_ids": ["hepkg:method:asimov-closure-test", "hepkg:method:binned-ml-fit-simultaneous", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2-compatibility-test", "hepkg:method:data_driven_closure_test", "hepkg:method:fully_bayesian_unfolding", "hepkg:method:iterative_unfolding", "hepkg:method:profile-likelihood-unfolding", "hepkg:method:statistical_covariance_matrix", "hepkg:method:svd_unfolding_crosscheck", "hepkg:method:tikhonov-regularisation", "hepkg:method:tunfold-least-squares-unfolding", "hepkg:method:tunfold-unfolding", "hepkg:method:tunfold_least_squares_unfolding", "hepkg:method:unfolding-particle-parton", "hepkg:object:lepton_particle", "hepkg:object:pseudo-top-particle-4l", "hepkg:observable:sigma-wc-particle-inclusive", "hepkg:region:fiducial-3l-particle", "hepkg:region:fiducial-4l-particle", "hepkg:region:fiducial-particle", "hepkg:region:fiducial-region", "hepkg:region:z-ll-fiducial", "hepkg:sample:ttbar_signal", "hepkg:statmethod:iterative-bayesian-unfolding", "hepkg:statmethod:pseudodata_closure_test", "hepkg:statmethod:tunfold_regularized_unfolding", "hepkg:systematic:background-related-uncertainty-differential", "hepkg:systematic:pdf_scale_variation", "hepkg:systematic:signal-generator-modelling", "hepkg:systematic:unfolding-prior-uncertainty", "hepkg:systematic:unfolding-uncertainty", "hepkg:systematic:unfolding_bias", "hepkg:systematic:unfolding_closure"], "evidence_ids": [], "seen_values": [], "verification_score": null, "unsupported_claims": [], "llm_calls": 6, "prompt_tokens": 54822, "completion_tokens": 2186, "rounds": 6, "seconds": 29.626065969467163, "reviews": [], "rec