label AS subject_label, a.object_id, eo.label AS object_label, a.object_value FROM assertion a LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE (a.object_id IN ('hepkg:object:b_jet','hepkg:object:bjet_reco','hepkg:object:bjet-relaxed','hepkg:object:bjet-tight','hepkg:object:btrackjet','hepkg:object:bjet_medium_detector','hepkg:object:bjet_tight_detector','hepkg:object:b-tagged-ak4-jet','hepkg:object:soft-b-tag') OR lower(COALESCE(eo.label,'')) LIKE '%b-tag%' OR lower(COALESCE(eo.label,'')) LIKE '%b-hadron-containing%') AND a.predicate IN ('region_requires_object','region_vetoes_object','object_has_selection','region_has_selection','result_defines_object') ORDER BY a.paper_id, a.predicate LIMIT 200"}, "rows": 200, "error": null, "truncated": false, "preview": "paper_id | predicate | subject_id | subject_label | object_id | object_label | object_value\n2001.06899 | result_defines_object | hepkg:result:1724c3004deb2fe7c06e27d8 | Measurement of the associated p"}, {"tool": "sql", "round": 3, "args": {"query": "WITH hits AS ( SELECT DISTINCT a.paper_id FROM assertion a LEFT JOIN entity o ON o.entity_id=a.object_id LEFT JOIN entity s ON s.entity_id=a.subject_id WHERE a.predicate IN ('region_requires_object','region_vetoes_object','region_has_selection','object_has_selection') AND (lower(COALESCE(o.label,'')) LIKE '%b-tag%' OR lower(COALESCE(o.label,'')) LIKE '%b tagged%' OR lower(COALESCE(o.label,'')) LIKE '%b-hadron-containing jet%' OR lower(COALESCE(o.label,'')) LIKE '%b jet%' OR lower(COALESCE(o.label,'')) LIKE '%b-jet%' OR lower(COALESCE(s.label,'')) LIKE '%b-tag%' OR lower(COALESCE(a.object_value,'')) LIKE '%b-tag%') ) SELECT p.arxiv_id, p.title FROM hits h JOIN paper p ON p.arxiv_id=h.paper_id ORDER BY p.arxiv_id"}, "rows": 48, "error": null, "truncated": false, "preview": "arxiv_id | title\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proto