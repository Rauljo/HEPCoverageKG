{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-07", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses have a ttZ background and a control region used to normalise that background?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "Six analyses match: \n\n- **2004.14060** — all-hadronic stop search; a dedicated tt̄Z control region is included in the fit.\n- **2006.05880** — top-squark search with a Higgs or Z boson; uses a dedicated tt̄Z control region in the 3-lepton selection.\n- **2012.03799** — search with top-quark pairs, one lepton, jets, and missing transverse momentum; uses the TZCR to normalise tt̄Z.\n- **2102.01444** — opposite-charge dilepton search; tt̄Z is normalised in a dedicated CR_tt̄Z (though it is estimated directly from simulation in the four-body selection, where it is minor).\n- **2110.11231** — WZ cross-section measurement; a b-jet-enriched CR-ttZ constrains the combined ttZ/tZq background.\n- **2202.08676** — inclusive nonresonant multilepton search; ttZ is normalised and validated in a dedicated control region.", "answered": true, "papers": ["2004.14060", "2006.05880", "2012.03799", "2102.01444", "2110.11231", "2202.08676"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ttZ background", "kind": "background", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background:ttz | background | ttZ irreducible background\nhepkg:background:ttz-tzq | background | ttZ and tZq irreducible background\nhepkg:background:ttx_prompt | backgro"}, {"tool": "search", "round": 1, "args": {"text": "control region used to normalize ttZ background", "kind": "background_method", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background_method:cr_normalisation_fit | background_method | Control-region-based background normalisation fit\nhepkg:method:z_peak_control_region | background_method | Z"}, {"tool": "search", "round": 1, "args": {"text": "ttZ control region", "kind": "event_region", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:region:3l-ttz-cr | event_region | 3L ttZ control region\nhepkg:region:cr-ttz | event_region | ttZ/tZq control region (CR-ttZ)\nhepkg:region:cr_zee | event_region | Z(ee) c"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, a.subject_id, es.label AS subject_label, a.predicate, a.object_id, eo.label AS object_label FROM assertion a LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ') OR a.object_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ') ORDER BY a.paper_id, a.predicate LIMIT 200"}, "rows": 13, "error": null, "truncated": false, "preview": "paper_id | subject_id | subject_label | predicate | object_id | object_label\n2004.14060 | hepkg:background:ttbarZ | $t\\bar{t}+Z$ background | background_uses_method | hepkg:method:cr_fit_normalization"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.paper_id, b.label AS background, m.label AS method, ev.quote, ev.section_title FROM assertion a JOIN entity b ON b.entity_id=a.subject_id JOIN entity m ON m.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.predicate='background_uses_method' AND a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttZ-3l','hepkg:background:ttbarZ') ORDER BY a.paper_id, m.label LIMIT 100"}, "rows": 13, "error": null, "truncated": false, "preview": "paper_id | background | method | quote | section_title\n2004.14060 | $t\\bar{t}+Z$ background | Control-region-based background normalisation via simultaneous profile likelihood fit | the normalisations"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT arxiv_id, title FROM paper WHERE arxiv_id IN ('2004.14060','2006.05880','2012.03799','2102.01444','2110.11231','2202.08676') ORDER BY arxiv_id"}, "rows": 6, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2006"}], "sets": {}, "entity_ids": ["hepkg:background:Wt", "hepkg:background:bbtautau_ttbar", "hepkg:background:nonprompt_wz_ttz", "hepkg:background:other_ttx_ttz", "hepkg:background:singletop", "hepkg:background:top-quark", "hepkg:background:ttZ-3l", "hepkg:background:ttbar", "hepkg:background:ttbar-gamma", "hepkg:background:ttbarZ", "hepkg:background:ttbar_background", "hepkg:background:tttt", "hepkg:background:ttx_prompt", "hepkg:background:ttz", "hepkg:background:ttz-tzq", "hepkg:background:twz", "hepkg:background:tzq", "hepkg:background:wz", "hepkg:background:z-jets", "hepkg:background:zz", "hepkg:background_method:cr_normalisation_fit", "hepkg:background_method:data-control-sample-normalization", "hepkg:method:control_region_normalization_fit", "hepkg:method:cr-data-driven-normalization", "hepkg:method:cr-mistag-rate-estimation", "hepkg:method:cr-normalisation-fit", "hepkg:method:cr-normalization", "hepkg:method:cr-normalization-fit", "hepkg:method:cr-normalization-ttbar", "hepkg:method:cr_fit_normalization", "hepkg:method:crt", "hepkg:method:crw", "hepkg:method:crwz2j-fit", "hepkg:method:data-driven-fit-normalisation", "hepkg:method:data-to-sim-scale-factor", "hepkg:method:data_driven_emu_cr", "hepkg:method:datadriven-normalization-CR", "hepkg:method:dedicated_control_regions", "hepkg:method:mc-cr-constrained-freefloat", "hepkg:method:mc-simulation-direct", "hepkg:method:normalization-factor-fit-to-data", "hepkg:method:sim_scaled_cr_fit