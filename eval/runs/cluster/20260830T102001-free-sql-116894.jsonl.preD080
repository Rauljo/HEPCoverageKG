{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-05", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses reconstruct a Higgs-boson candidate as a physical object they select on (rather than merely studying Higgs production or decay)?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The graph identifies 12 analyses that explicitly reconstruct a Higgs candidate (diphoton, four-lepton/ZZ, boosted H→bb jet, resolved bb pair, or generic reconstructed Higgs) and apply candidate-level selection:\n\n- 2004.04545 — diphoton H→γγ candidate\n- 2006.05880 — NN-tagged h→bb jet-pair candidate\n- 2008.05928 — large-R H→bb candidate jet\n- 2103.04956 — four-lepton ZZ/Higgs candidate\n- 2103.06956 — diphoton H→γγ candidate\n- 2107.12553 — H-tagged large-R H→bb jet\n- 2111.08340 — large-R H→bb candidate jet\n- 2112.03161 — boosted H→bb candidate jet\n- 2207.00348 — selected diphoton system\n- 2504.13081 — reconstructed Higgs-boson candidate\n- 2604.27044 — merged and resolved H→bb candidates\n- 2605.14245 — diphoton Higgs candidate", "answered": true, "papers": ["2004.04545", "2006.05880", "2008.05928", "2103.04956", "2103.06956", "2107.12553", "2111.08340", "2112.03161", "2207.00348", "2504.13081", "2604.27044", "2605.14245"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "reconstructed Higgs boson candidate detector object selected in event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:higgs_boson | detector_object | Higgs boson (reconstructed candidate)\nhepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate\nhepkg:object:di"}, {"tool": "search", "round": 1, "args": {"text": "Higgs candidate selection requirement physical object", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:diphoton | object_definition | Higgs boson candidate\nhepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate\nhepkg:selection:higgs-boson-rapi"}, {"tool": "sql", "round": 1, "args": {"query": "SELECT kind, label, entity_id FROM entity WHERE lower(label) LIKE '%higgs%' OR lower(label) LIKE '%h candidate%' ORDER BY kind, label LIMIT 200"}, "rows": 200, "error": null, "truncated": false, "preview": "kind | label | entity_id\nbackground | Background from jets misidentified as tau_h candidates (QCD multijet, W+jets, ttbar, diboson) | hepkg:background:jet-to-tauh-misid\nbackground | Non-$VH$ Higgs bos"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT eo.paper_id, eo.entity_id, eo.kind, eo.label FROM entity_occurrence eo WHERE eo.entity_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:H-jet','hepkg:object:largeR-jet','hepkg:object:diphoton') ORDER BY eo.paper_id, eo.entity_id"}, "rows": 5, "error": null, "truncated": false, "preview": "paper_id | entity_id | kind | label\n2006.05880 | hepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate (h->bb jet pair, NN-tagged)\n2008.05928 | hepkg:object:largeR-jet | detecto"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id,a.predicate,a.subject_id,es.kind AS subject_kind,es.label AS subject_label,a.object_id,eo.kind AS object_kind,eo.label AS object_label FROM assertion a LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE a.object_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:H-jet','hepkg:object:largeR-jet','hepkg:object:diphoton') OR a.subject_id IN ('hepkg:object:higgs_boson','hepkg:object:higgs-boson-candidate','hepkg:object:H-jet','hepkg:object:largeR-jet','hepkg:object:diphoton') ORDER BY a.paper_id,a.predicate LIMIT 200"}, "rows": 20, "error": null, "truncated": false, "preview": "paper_id | predicate | subject_id | subject_kind | subject_label | object_id | object_kind | object_label\n2006.05880 | object_has_selection | hepkg:object:higgs-boson-candidate | detector_object | Hig"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT a.paper_id, a.predicate, e.entity_id, e.label, e.kind FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.predicate IN ('region_requires_object','region_vetoes_object','result_defines_object') AND e.kind='detector_object' AND (lower(e.label) LIKE '%higgs%' OR lower(e.label) LIKE '%h→%' OR lower(e.label) LIKE '%h-%jet%' OR lower(e.label) LIKE '%h candidate%') ORDER BY a.paper_id,e.label"}, "rows": 16, "error": null, "truncated": false, "preview": "paper_id | predicate | entity_id | label | kind\n2004.04545 | result_defines_object | hepkg:object:diphoton_system | Diphoton system (H→γγ candidate) | detector_object\n2006.05880 | region_requires_obje"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, e.entity_id, e.kind, e.label, a.predicate FROM assertion a JOIN entity e ON e.entity_id=a.subject_id WHERE a.predicate='object_has_selection' AND (lower(e.label) LIKE '%higgs%candidate%' OR lower(e.label) LIKE '%h→%candidate%' OR lower(e.label) LIKE '%h->%candidate%' OR lower(e.label) LIKE '%h-tagged%' OR lower(e.label) LIKE '%h-jet%' OR lower(e.label) LIKE '%diphoton system%' OR lower(e.label) LIKE '%zz candidate%') ORDER BY a.paper_id,e.label"}, "rows": 13, "error": null, "truncated": false, "preview": "paper_id | entity_id | kind | label | predicate\n2004.04545 | hepkg:object:diphoton_system | detector_object | Diphoton system (H→γγ candidate) | object_has_selection\n2006.05880 | hepkg:object:higgs-bo"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, e.entity_id, e.kind, e.label FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE a.predicate='region_requires_object' AND (lower(e.label) LIKE '%higgs%candidate%' OR lower(e.label) LIKE '%h→%candidate%' OR lower(e.label) LIKE '%h->%candidate%' OR lower(e.label) LIKE '%h-tagged%' OR lower(e.label) LIKE '%h-jet%' OR lower(e.label) LIKE '%diphoton system%' OR lower(e.label) LIKE '%zz candidate%' OR lower(e.label) LIKE '%bb candidate%' OR lower(e.label) LIKE '%b bbar jet%') ORDER BY a.paper_id,e.label"}, "rows": 6, "error": null, "truncated": false, "preview": "paper_id | entity_id | kind | label\n2006.05880 | hepkg:object:higgs-boson-candidate | detector_object | Higgs boson candidate (h->bb jet pair, NN-tagged)\n2008.05928 | hepkg:object:largeR-jet | detecto"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT arxiv_id,title FROM paper WHERE arxiv_id IN ('2004.04545','2006.05880','2008.05928','2103.04956','2103.06956','2107.12553','2111.08340','2112.03161','2504.13081','2604.27044','2605.14245') ORDER BY arxiv_id"}, "rows": 11, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.04545 | $CP$ Properties of Higgs Boson Interactions with Top Quarks in the $t\\bar{t}H$ and $tH$ Processes Using $H\\rightarrow\\gamma\\gamma$ with the ATLAS Detector\n2006.05880 | Se"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT arxiv_id,title FROM paper WHERE arxiv_id IN ('2004.04545','2006.05880','2008.05928','2103.04956','2103.06956','2107.12553','2111.08340','2112.03161','2207.00348','2504.13081','2604.27044','2605.14245') ORDER BY arxiv_id"}, "rows": 12, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.04545 | $CP$ Properties of Higgs Boson Interactions with Top Quarks in the $t\\bar{t}H$ and $tH$ Processes Using $H\\rightarrow\\gamma\\gamma$ with the ATLAS Detector\n2006.05880 | Se"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id,e.entity_id,e.label,a.object_value,a.qualifiers FROM assertion a JOIN entity e ON e.entity_id=a.subject_id WHERE a.predicate='object_has_selection' AND a.paper_id IN ('2004.04545','2006.05880','2008.05928','2103.04956','2103.06956','2107.12553','2111.08340','2112.03161','2207.00348','2504.13081','2604.27044','260