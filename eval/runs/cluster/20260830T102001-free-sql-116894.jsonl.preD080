{"run_id": "20260830T102001-free-sql-116894", "qid": "gabriel-gf-01-condition", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "b0a569a-dirty", "question": "Which analyses use b-tagged jets (jets identified as containing a b-hadron) in their event selection?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The graph identifies 44 analyses whose event selections require or veto b-tagged jets (including soft-b-tag and b-tagged track-jet variants): 2001.06899, 2004.04545, 2004.14060, 2006.05880, 2007.02873, 2009.04363, 2010.14293, 2012.03799, 2012.08600, 2102.01444, 2103.04956, 2103.06956, 2106.01676, 2106.14246, 2107.12553, 2109.13808, 2110.11231, 2112.03161, 2201.11585, 2202.08676, 2205.05120, 2206.09466, 2207.00348, 2208.12095, 2209.07327, 2211.08028, 2302.05225, 2307.01094, 2308.02285, 2309.14442, 2312.04450, 2401.05299, 2402.08486, 2403.01556, 2405.18661, 2503.19420, 2506.13565, 2508.13900, 2509.22535, 2510.07527, 2511.11853, 2602.18611, 2604.21670, and 2604.27044.", "answered": true, "papers": ["2001.06899", "2004.04545", "2004.14060", "2006.05880", "2007.02873", "2009.04363", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2307.01094", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2403.01556", "2405.18661", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets jets identified as containing a b-hadron used in event selection", "kind": "", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:object:b_jet | detector_object | b-hadron-containing jet\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-relaxed | detector_object | b-tagged j"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.predicate, a.paper_id, a.subject_id, es.label AS subject_label, a.object_id, eo.label AS object_label, COUNT(*) AS n FROM assertion a LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE a.object_id IN ('hepkg:object:b_jet','hepkg:object:bjet_reco','hepkg:object:bjet-relaxed','hepkg:object:bjet-tight','hepkg:object:btrackjet','hepkg:object:bjet_medium_detector','hepkg:object:bjet_tight_detector','hepkg:object:b-tagged-ak4-jet','hepkg:object:soft-b-tag') OR a.subject_id IN ('hepkg:object:b_jet','hepkg:object:bjet_reco','hepkg:object:bjet-relaxed','hepkg:object:bjet-tight','hepkg:object:btrackjet','hepkg:object:bjet_medium_detector','hepkg:object:bjet_tight_detector','hepkg:object:b-tagged-ak4-jet','hepkg:object:soft-b-tag') GROUP BY a.predicate,a.paper_id,a.subject_id,a.object_id ORDER BY a.paper_id,a.predicate LIMIT 200"}, "rows": 87, "error": null, "truncated": false, "preview": "predicate | paper_id | subject_id | subject_label | object_id | object_label | n\nobject_has_selection | 2001.06899 | hepkg:object:b_jet | b-tagged jet |  |  | 1\nresult_defines_object | 2001.06899 | he"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT eo.entity_id, eo.label, eo.paper_id FROM entity_occurrence eo WHERE eo.kind='detector_object' AND (lower(eo.label) LIKE '%b-tag%' OR lower(eo.label) LIKE '%b tag%' OR lower(eo.label) LIKE '%b-hadron-containing%' OR lower(eo.label) LIKE '%b jet%' OR lower(eo.label) LIKE '%b-jet%') ORDER BY eo.paper_id, eo.label LIMIT 200"}, "rows": 49, "error": null, "truncated": false, "preview": "entity_id | label | paper_id\nhepkg:object:higgs-boson-candidate | Higgs boson candidate (h->bb jet pair, NN-tagged) | 2006.05880\nhepkg:object:VR-Z-VV-btag | Validation region VR^{Z,b-tag}_VV for multi"}, {"tool": "sql", "round": 4, "args": {"query": "WITH bobj AS (SELECT DISTINCT entity_id FROM entity_occurrence WHERE kind='detector_object' AND (lower(label) LIKE '%b-tagged jet%' OR lower(label) LIKE '%b-tagged small%' OR lower(label) LIKE '%b tagged jet%' OR lower(label) LIKE '%b-hadron-containing jet%' OR lower(label) LIKE '%reconstructed b-tagged jet%' OR lower(label) LIKE '%soft b-tag%')) SELECT DISTINCT a.paper_id, p.title FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id WHERE (a.predicate='object_has_selection' AND a.subject_id IN (SELECT entity_id FROM bobj)) OR (a.predicate IN ('region_requires_object','region_vetoes_object') AND a.object_id IN (SELECT entity_id FROM bobj)) ORDER BY a.paper_id"}, "rows": 44, "error": null, "truncated": false, "preview": "paper_id | title\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   TeV\n2004.04545 | $CP$ "}, {"tool": "sql", "round": 5, "args": {"query": "WITH bobj AS (SELECT DISTINCT entity_id FROM entity_occurrence WHERE kind='detector_object' AND (lower(label) LIKE '%b-tagged jet%' OR lower(label) LIKE '%b-tagged small%' OR lower(label) LIKE '%b tagged jet%' OR lower(label) LIKE '%b-hadron-containing jet%' OR lower(label) LIKE '%reconstructed b-tagged jet%' OR lower(label) LIKE '%soft b-tag%')), hits AS (SELECT DISTINCT a.paper_id FROM assertion a WHERE (a.predicate='object_has_selection' AND a.subject_id IN (SELECT entity_id FROM bobj)) OR (a.predicate IN ('region_requires_object','region_vetoes_object') AND a.object_id IN (SELECT entity_id FROM bobj))) SELECT paper_id FROM hits ORDER BY paper_id LIMIT 200"}, "rows": 44, "error": null, "truncated": false, "preview": "paper_id\n2001.06899\n2004.04545\n2004.14060\n2006.05880\n2007.02873\n2009.04363\n2010.14293\n2012.03799\n2012.08600\n2102.01444\n2103.04956\n2103.06956\n2106.01676\n2106.14246\n2107.12553\n2109.13808\n2110.11231\n2112"}], "sets": {}, "entity_