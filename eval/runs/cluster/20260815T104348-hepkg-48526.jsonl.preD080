iews": [{"search_text": "Observed and background-only-fit expected event yields in signal regions", "tally": {"exact": 9, "broader": 1, "unrelated": 37}, "kept": 10, "candidates": 47, "defaulted": 0, "calls": 4, "errors": 0, "tail_keep_rate": 0.0, "dropped": [{"id": "hepkg:observable:background_yield_signal_region", "why": "This is a predicted value, not an observed or background-only-fit expected yield."}, {"id": "hepkg:observable:discovery-pvalue-significance", "why": "This is a measure of the significance of the background-only hypothesis, not a direct comparison of observed and expected yields."}, {"id": "hepkg:observable:signal_yield_limit", "why": "This is an upper limit on the signal event yield, not an observed or background-only-fit expected yield."}, {"id": "hepkg:observable:signal-event-ul", "why": "This is an upper limit on the number of BSM signal events, not an observed or background-only-fit expected yield."}, {"id": "hepkg:observable:signal_event_limit", "why": "This is a model-independent event limit, not an observed or background-only-fit expected yield."}, {"id": "hepkg:observable:observed-significance", "why": "This is about the significance of the Higgs boson signal, not directly related to observed and background-only-fit expected event yields."}, {"id": "hepkg:observable:p0-significance", "why": "This gives the p-value and significance for the background-only hypothesis in signal regions, which is related to the fit but not a direct measurement of event yields."}, {"id": "hepkg:observable:wh_significance", "why": "This is a measure of the significance of background-only hypothesis rejection, not a direct comparison of observed and expected yields."}, {"id": "hepkg:observable:vr-significance", "why": "This is a significance in validation regions, not an observed or background-only-fit expected yield."}, {"id": "hepkg:observable:zh_significance", "why": "This is a measure of the significance of background-only hypothesis rejection, not a direct 