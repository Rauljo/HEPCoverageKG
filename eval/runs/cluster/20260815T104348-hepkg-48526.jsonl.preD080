on."}, {"id": "hepkg:observable:visible-bsm-cross-section", "why": "This is an upper limit on a visible BSM cross section, not the total cross section."}, {"id": "hepkg:observable:xsec-br-schichi-bb", "why": "This is a production cross-section times branching fraction, not the total cross section."}, {"id": "hepkg:observable:observed-significance", "why": "This is a significance of the Higgs boson signal, not the total production cross section."}, {"id": "hepkg:observable:xsec-br-zprime-hgamma-hbb", "why": "Production cross-section times branching fraction for Z'->Hgamma, not total Higgs production."}, {"id": "hepkg:observable:xsec-95cl-ul", "why": "This is an upper limit on a cross section, not the total cross section itself."}, {"id": "hepkg:observable:mu-h-fiducial", "why": "This is a signal strength within a fiducial volume, not the total cross section."}, {"id": "hepkg:observable:sigma_fid_ttbb", "why": "Fiducial cross section for ttbb processes, not total Higgs production."}, {"id": "hepkg:observable:sigma_ttH_x_Bgammagamma", "why": "This is a product of a cross section and a branching ratio, not the total cross section."}, {"id": "hepkg:observable:pt_h", "why": "Measures the transverse momentum of the Higgs boson, not the total cross section."}, {"id": "hepkg:observable:total-xsec-ratio", "why": "Ratio of total production cross sections, not total Higgs production."}, {"id": "hepkg:observable:bsm_branching_fraction_invisible", "why": "This is a branching fraction to invisible final states, not a total cross section."}, {"id": "hepkg:observable:mu-h-differential", "why": "This is a signal strength in specific pT bins, not a total cross section."}, {"id": "hepkg:observable:stxs_stage12_xsec", "why": "This is a merged STXS cross section times branching fraction, not a total cross section."}, {"id": "hepkg:observable:bsm_branching_fraction_undetected", "why": "This is a branching fraction to undetected final states, not a total cross section."}, {"id": "hepkg:obs