d": 48}, "kept": 12, "candidates": 60, "defaulted": 0, "calls": 4, "errors": 0, "tail_keep_rate": 0.06666666666666667, "dropped": [{"id": "hepkg:observable:mu_per_mode", "why": "This is a set of signal strength modifiers for different production modes, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu-h-inclusive", "why": "This is a specific signal strength for a particular kinematic region, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:hh_incl_signal_strength", "why": "This is a signal strength for inclusive HH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu_fermion_vector", "why": "This is a set of signal strength modifiers for fermion- and vector-boson-induced production, not specifically the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:mu-vbf-vh", "why": "This is a signal strength modifier but for VBF and VH production modes, not the inclusive H→γγ decay."}, {"id": "hepkg:observable:mu-ggh-tth", "why": "This is a signal strength modifier for fermion-coupling production modes, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:higgs_mass_profiled", "why": "This is a different observable, related to the Higgs mass, not the signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:mu_ggf2jets", "why": "This is a signal strength parameter for ggF+2 jets Higgs boson production, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:mu_by_production_mode", "why": "This is a set of signal strength modifiers for various production modes, not specifically the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:mu-z-fiducial-validation", "why": "This is a signal strength validation for Z→bb, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:kappa-lambda", "why": "This is a trilinear self-coupling modifier, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:mu_vh_bb", "why": "This is a signal strength for VH production with H→bb decay, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:observed-significance", "why": "This is the significance of the H→WW signal, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:coupling_modifier_effective", "why": "This is an effective Higgs boson coupling modifier, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:coupling_modifier_resolved", "why": "This is a resolved Higgs boson coupling modifier, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:xsec-br-wh", "why": "This is a specific observable for WH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu-z-inclusive", "why": "This is a signal strength for Z+jets production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu_zh_bb", "why": "This is a specific signal strength for ZH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:abs_y_h", "why": "This is a kinematic distribution, not a signal strength modifier."}, {"id": "hepkg:observable:mu_wh_bb", "why": "This is a signal strength modifier but for WH production and H→bb decay, not the inclusive H→γγ decay."}, {"id": "hepkg:observable:p-value-mu-h-compatibility", "why": "This is a p-value for the compatibility of differential signal strengths, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:coupling_modifier_ratio", "why": "This is a ratio of coupling modifiers, not a signal strength modifier."}, {"id": "hepkg:observable:xsec-br-zh", "why": "This is a specific observable for ZH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:xsec-br-th", "why": "This is a specific observable for tH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu_vz_bb", "why": "This is a signal strength for VZ production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:xsec-br-tth", "why": "This is a specific observable for ttH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:xsec-br-ggf-bbh", "why": "This is the product of the cross-section and branching ratio for ggF+bbH production, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:xsec-br-vbf", "why": "This is the product of the cross-section and branching ratio for VBF production, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:br_h_to_inv", "why": "This is a different observable, specifically the branching fraction for the invisible decay of the Higgs boson."}, {"id": "hepkg:observable:mu-ttbar-inclusive", "why": "This is a signal strength modifier for ttbar normalization, not the inclusive H→γγ signal strength modifier."}, {"id": "hepkg:observable:mbb-spectrum", "why": "This is a kinematic distribution for a dark Higgs boson candidate, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu_tH", "why": "This is a signal strength for tH production, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:fit_basis_linear_with_dihiggs", "why": "This is a constraint on couplings, not a signal strength modifier."}, {"id": "hepkg:observable:fit_basis_linear_quadratic", "why": "This is a set of constraints on a large number of parameters in the SMEFT model, which is not directly related to the specific signal strength modifier asked about."}, {"id": "hepkg:observable:xsec-br-zprime-hgamma-hbb", "why": "This is a branching fraction and cross-section for a different process, not related to the Higgs boson signal strength modifier."}, {"id": "hepkg:observable:mu-HH", "why": "This is a general signal strength for HH production, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:pt_h", "why": "This is a kinematic distribution, not a signal strength modifier."}, {"id": "hepkg:observable:fit_basis_linear_no_dihiggs", "why": "This is a set of constraints on a SMEFT fit basis, not the inclusive Higgs boson signal strength modifier."}, {"id": "hepkg:observable:sigma-h-differential", "why": "This is a differential cross section for Higgs boson production, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:higgs_branching_fraction_ratio", "why": "This is a branching fraction ratio relative to H→ZZ, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:sigma_tot", "why": "This is the total Higgs boson production cross section, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:mu_vh_bb_dijetmass", "why": "This is a signal strength modifier but for VH production and H→bb decay, not the inclusive H→γγ decay."}, {"id": "hepkg:observable:ttw-minus-xsec", "why": "This is a cross-section for a different process, not related to the Higgs boson signal strength modifier."}, {"id": "hepkg:observable:model-independent-upper-limit", "why": "This provides upper limits on BSM cross sections and signal yields, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:ttw-plus-xsec", "why": "This is an inclusive cross-section for ttW production, not related to the H→γγ signal strength modifier."}, {"id": "hepkg:observable:hh_vbf_signal_strength", "why": "This is a signal strength for VBF HH production, which is not the specific signal strength modifier for the H→γγ decay."}, {"id": "hepkg:observable:eft_coefficient_constraints", "why": "This is a set of exclusion limit