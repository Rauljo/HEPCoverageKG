tes": 163, "defaulted": 0, "calls": 11, "errors": 0, "tail_keep_rate": 0.13333333333333333, "dropped": [{"id": "hepkg:systematic:missing_higher_order_qcd_corrections", "why": "This is a systematic uncertainty related to QCD scale, which is not specifically about CR model uncertainty."}, {"id": "hepkg:systematic:gluon_splitting", "why": "Gluon splitting rate uncertainty is related to parton shower models but not specifically to color reconnection model uncertainty."}, {"id": "hepkg:syst:qcd_multijet_mismodelling_group", "why": "QCD multijet mismodelling uncertainty is related to parton shower models but not specifically to color reconnection model uncertainty."}, {"id": "hepkg:systematic:gluon_splitting_rate", "why": "This is a systematic uncertainty related to gluon splitting, which is not directly related to CR model uncertainty."}, {"id": "hepkg:systematic:sf-cr-statistical", "why": "This is a statistical uncertainty, not related to color reconnection models."}, {"id": "hepkg:systematic:qcd-scale-uncertainty", "why": "This is about QCD scale uncertainty, not the CR model."}, {"id": "hepkg:systematic:scale-variation-signal-modeling", "why": "QCD factorization/renormalization scale variation uncertainty is not specifically about color reconnection model uncertainty."}, {"id": "hepkg:syst:qcd_cr_normalization_constraint", "why": "W(lnu)+jets/Z(nunu)+jets/HF-noise normalization constraint uncertainty is unrelated to color reconnection model uncertainty."}, {"id": "hepkg:systematic:qcd_multijet_syst", "why": "This is a systematic uncertainty related to QCD multijet background estimation, which is not related to CR model uncertainty."}, {"id": "hepkg:systematic:qcd-multijet-normalization-merged", "why": "This is a QCD multijet transfer factor uncertainty, not related to the CR model uncertainty."}, {"id": "hepkg:systematic:rw-jes", "why": "Jet energy scale uncertainty is not related to color reconnection model uncertainty."}, {"id": "hepkg:systematic:qcd-normalization",