lusive-xsec", "why": "This is a total cross section for a different process (t-tbar-W), not Higgs production."}, {"id": "hepkg:observable:diff_xsec_y_h", "why": "This is a differential cross section, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:tot_xsec_wminus", "why": "This is a product of the total cross section and a branching fraction, which is not the total Higgs boson production cross section alone."}, {"id": "hepkg:observable:coupling_modifier_effective", "why": "This is about effective couplings and total width, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:tot_xsec_w", "why": "This is a product of the total cross section and a branching fraction, which is not the total Higgs boson production cross section alone."}, {"id": "hepkg:observable:sigma_inel", "why": "This is the total inelastic cross section, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:ttw-minus-xsec", "why": "This is the inclusive cross section for a different process, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:ttw-plus-xsec", "why": "This is the inclusive cross section for a different process, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:higgs_stxs0_cross_section_times_bzz", "why": "This is a product of the cross section and a branching fraction, which is not the total Higgs boson production cross section alone."}, {"id": "hepkg:observable:tot_ratio_wz", "why": "This is a ratio of cross sections for different processes, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:higgs_signal_strength_per_production", "why": "This is a signal strength modifier, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:tot_ratio_wpm", "why": "This is a ratio of cross sections for different processes, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:ttw-fiducial-xsec", "why": "This is a fiducial cross section for a different process, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:rc-ratio-inclusive", "why": "This is a ratio of cross sections for different processes, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:mu-inclusive-hgg", "why": "This is a signal strength measurement, not the total Higgs boson production cross section."}, {"id": "hepkg:observable:higgs_stxs12_cross_section_times_bzz", "why": "This is a differential cross section, not the total cross section."}, {"id": "hepkg:observable:mu_inclusive", "why": "This is a signal strength modifier, not a total cross section."}, {"id": "hepkg:observable:signal-strength-mu", "why": "This is a signal strength modifier, not a total cross section."}, {"id": "hepkg:observable:sigma_el_obs", "why": "This is an elastic cross section, not the total Higgs production cross section."}, {"id": "hepkg:observable:visible-bsm-cross-section", "why": "This is a BSM cross-section upper limit, not the total Higgs production cross section."}, {"id": "hepkg:observable:xsec-br-schichi-bb", "why": "This is a production cross-section times branching fraction for a different process, not the total Higgs production cross section."}, {"id": "hepkg:observable:observed-significance", "why": "This is a significance of a Higgs signal, not a total cross section."}, {"id": "hepkg:observable:xsec-br-zprime-hgamma-hbb", "why": "This is a differential cross-section times branching fraction for a different process, not the total Higgs production cross section."}, {"id": "hepkg:observable:xsec-95cl-ul", "why": "This is an upper limit on a production cross section, not the total Higgs production cross section."}, {"id": "hepkg:observable:mu-h-fiducial", "why": "This is a signal strength within a fiducial volume, not a total cross section."}, {"id": "hepkg:observable:sigma_fid_ttbb", "why": "This is a fiducial cross section for a different process, not the total Higgs production cross section."}, {"id": "hepkg:observable:sigma_ttH_x_Bgammagamma", "why": "This is a production rate times branching ratio for a different process, not the total Higgs production cross section."}, {"id": "hepkg:observable:pt_h", "why": "This is a kinematic distribution, not a total cross section."}, {"id": "hepkg:observable:total-xsec-ratio", "why": "This is a ratio of total production cross sections, which could be related but is not the total Higgs production cross section itself."}, {"id": "hepkg:observable:bsm_branching_fraction_invisible", "why": "This is a branching fraction, not a total cross section."}, {"id": "hepkg:observable:mu-h-differential", "why": "Signal strength in specific pT bins, not total cross section"}, {"id": "hepkg:observable:stxs_stage12_xsec", "why": "Cross section times branching fraction, not total cross section"}, {"id": "hepkg:observable:bsm_branching_fraction_undetected", "why": "Branching fraction, not cross section"}, {"id": "hepkg:observable:mu_per_mode", "why": "Signal strength modifiers, not total cross section"}, {"id": "hepkg:observable:stxs-xsec", "why": "Differential cross section, not total cross section"}, {"id": "hepkg:observable:mu-h-inclusive", "why": "Signal strength in an inclusive region, not total cross section"}, {"id": "hepkg:observable:vhh_signal_strength", "why": "Signal strength for VHH production, not total cross section"}, {"id": "hepkg:observable:diff-xsec-pt-z", "why": "Differential cross section for WZ, not total cross section"}, {"id": "hepkg:observable:fiducial_xsec_inclusive", "why": "Fiducial cross section, not total cross section"}, {"id": "hepkg:observable:higgs_signal_strength_per_prod_decay", "why": "Signal strength modifier per process and decay channel, not total cross section"}, {"id": "hepkg:observable:higgs_signal_strength_inclusive", "why": "Inclusive signal strength modifier, not total cross section"}, {"id": "hepkg:observable:R_b_over_j", "why":