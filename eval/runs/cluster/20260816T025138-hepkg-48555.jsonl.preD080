ail_keep_rate": 0.06666666666666667, "dropped": [{"id": "hepkg:object:jet_particle", "why": "This is a generic particle-level jet, not specifically a b jet."}, {"id": "hepkg:object:extra_jet_particle", "why": "This is a generic additional particle-level jet, not specifically a b jet."}, {"id": "hepkg:object:jet", "why": "This is a detector-level hadronic jet, not a particle-level b jet."}, {"id": "hepkg:object:muon_particle", "why": "This is a particle-level muon, not a b jet."}, {"id": "hepkg:object:bjet_medium_detector", "why": "This is a detector-level b-tagged jet, not a particle-level b jet."}, {"id": "hepkg:object:bjet_tight_detector", "why": "This is a detector-level b-tagged jet, not a particle-level b jet."}, {"id": "hepkg:object:top_quark_particle", "why": "This is a particle-level top quark/antiquark candidate, not a b jet."}, {"id": "hepkg:object:jet_detector", "why": "This is a detector-level jet, not a particle-level b jet."}, {"id": "hepkg:object:electron_particle", "why": "This is a particle-level electron, not a b jet."}, {"id": "hepkg:object:hadronic-jet", "why": "This is a generic hadronic jet, not a particle-level b jet."}, {"id": "hepkg:object:Jb-jet", "why": "This is a large-R jet used as a b-quark proxy, not a particle-level b jet."}, {"id": "hepkg:object:non_b_tagged_jet", "why": "This is a non-b-tagged jet, not a particle-level b jet."}, {"id": "hepkg:object:stxs_fiducial_jet", "why": "This is a particle-level jet, but not specifically a b jet matched to a b hadron."}, {"id": "hepkg:object:btrackjet", "why": "This is a b-tagged track-jet, which is not the same as a particle-level b jet matched to a b hadron."}, {"id": "hepkg:object:neutrino_particle", "why": "This is a particle-level prompt neutrino, not related to b jets or b hadrons."}, {"id": "hepkg:object:ttbar_system_particle", "why": "This is a particle-level ttbar system, which may contain b jets but is not the specific object asked about."}, {"id": "hepkg:object:isolated_track", "why": "This is an isolated charged particle track, not related to b jets or b hadrons."}, {"id": "hepkg:object:b_jet_reco", "why": "This is a reconstructed b-tagged jet, which is close but not the same as a particle-level b jet matched to a b hadron."}, {"id": "hepkg:object:largeR-jet", "why": "This is a H→bb̄ candidate jet, which is a specific type of b jet but not necessarily at particle level or matched to a b hadron."}, {"id": "hepkg:object:parton_top_quark", "why": "This is a parton-level tbar, not related to b jets or b hadrons."}, {"id": "hepkg:object:bjet-relaxed", "why": "This is a b-tagged jet with a relaxed working point, which is close but not the same as a particle-level b jet matched to a b hadron."}, {"id": "hepkg:object:lepton_particle", "why": "This is a particle-level dressed lepton, not related to b jets or b hadrons."}, {"id": "hepkg:object:large_radius_jet", "why": "This is a large-radius jet used in a boosted H→bb analysis, which is close but not the same as a particle-level b jet matched to a b hadron."}, {"id": "hepkg:object:b-tagged-ak4-jet", "why": "This is a b jet, which is close but not the same as a particle-level b jet matched to a b hadron."}, {"id": "hepkg:object:qqprime_jet", "why": "This is a qq' jet, which is not related to b jets or b hadrons."}, {"id": "hepkg:object:bplus_candidate", "why": "This is a B+ meson candidate, which is related to b hadrons but not the same as a particle-level b jet matched to a b hadron."}, {"id": "hepkg:object:lepton_stxs_particle", "why": "This is a lepton, not related to b jets or b hadrons."}, {"id": "hepkg:object:ak4_b_jet", "why": "This is a b jet at detector level, not particle level matched to b hadron."}, {"id": "hepkg:object:parton_lepton", "why": "This is a parton-level lepton, not a b jet matched to a b hadron."}, {"id": "hepkg:object:reclustered_jet_r12", "why": "This is a reclustered jet, not specifically a b jet matched to a b hadron."}, {"id": "hepkg:object:soft-b-tag", "why": "This is a s