{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-01-condition", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses use b-tagged jets (jets identified as containing a b-hadron) in their event selection?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "", "answered": false, "papers": ["2001.06899", "2004.04545", "2004.14060", "2006.05880", "2007.02873", "2008.05928", "2009.04363", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2111.08340", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2303.15340", "2307.01094", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2402.08486", "2403.01556", "2405.18661", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets, jets identified as containing a b-hadron, b jet tagging", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:b_jet | detector_object | b-hadron-containing jet\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-tight | detector_object | leading b-ta"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, p.title, a.predicate, a.subject_id, es.label AS subject_label, a.object_id, eo.label AS object_label, a.object_value FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE a.object_id IN ('hepkg:object:b_jet','hepkg:object:bjet_reco','hepkg:object:bjet-tight','hepkg:object:bjet-relaxed','hepkg:object:b-tagged-ak4-jet','hepkg:object:bj