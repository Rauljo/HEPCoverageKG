{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-01", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses are searches (rather than measurements) whose event selection uses both b-tagged jets and missing transverse momentum?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2004.14060", "2006.05880", "2008.05928", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2106.01676", "2106.14246", "2107.12553", "2112.03161", "2201.11585", "2202.08676", "2209.07327", "2211.08028", "2302.05225", "2307.01094", "2403.01556", "2407.10549", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets / b-tagged jet event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:b-jet | detector_object | b-tagged jet (b-jet)\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:region:baseline | event_region | Baseline diphoton + "}, {"tool": "search", "round": 1, "args": {"text": "missing transverse momentum / missing transverse energy event selection", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:missing_et | detector_object | missing transverse momentum\nhepkg:object:missing_transverse_momentum | detector_object | Missing transverse momentum\nhepkg:object_s"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT p.arxiv_id, p.title, p.category, a.predicate, a.subject_id, es.label AS subject_label, a.object_id, eo.label AS object_label FROM paper p JOIN assertion a ON a.paper_id=p.arxiv_id LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE p.category='search' AND (a.subject_id IN ('hepkg:object:b-jet','hepkg:object:bjet_reco','hepkg:object:bjet-relaxed','hepkg:object:btrackjet','hepkg:object:bjet-tight','hepkg:object:b-tagged-ak4-jet','hepkg:object:bjet_tight_detector','hepkg:object:bjet_medium_detector') OR a.object_id IN ('hepkg:object:b-jet','hepkg:object:bjet_reco','hepkg:object:bjet-relaxed','hepkg:object:btrackjet','hepkg:object:bjet-tight','hepkg:object:b-tagged-ak4-jet','hepkg:object:bjet_tight_detector','hepkg:object:bjet_medium_detector') OR a.subject_id IN ('hepkg:object:missing_et','hepkg:object:missing_transverse_momentum','hepkg:object:met_reco','hepkg:object:etmiss','hepkg:object:track_met','hepkg:object:met_track') OR a.object_id IN ('hepkg:object:missing_et','hepkg:object:missing_transverse_momentum','hepkg:object:met_reco','hepkg:object:etmiss','hepkg:object:track_met','hepkg:object:met_track')) AND a.predicate IN ('object_has_selection','region_requires_object','result_defines_region','channel_has_region','result_defines_object') ORDER BY p.arxiv_id, a.predicate LIMIT 200"}, "rows": 47, "error": null, "truncated": false, "preview": "arxiv_id | title | category | predicate | subject_id | subject_label | object_id | object_label\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing tr"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT p.arxiv_id, p.title, e.kind, e.entity_id, e.label, a.predicate, a.subject_id, a.object_id FROM paper p JOIN assertion a ON a.paper_id=p.arxiv_id JOIN entity e ON e.entity_id IN (a.subject_id,a.object_id) WHERE p.category='search' AND (lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%missing et%' OR lower(e.label) LIKE '%etmiss%' OR lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b jet%') AND a.predicate IN ('object_has_selection','region_requires_object','result_defines_region','channel_has_region','result_defines_object') ORDER BY p.arxiv_id, e.label LIMIT 500"}, "rows": 200, "error": null, "truncated": true, "preview": "arxiv_id | title | kind | entity_id | label | predicate | subject_id | object_id\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse moment"}, {"tool": "sql", "round": 4, "args": {"query": "WITH b AS (SELECT DISTINCT a.paper_id FROM assertion a JOIN entity e ON e.entity_id IN (a.subject_id,a.object_id) WHERE a.predicate IN ('object_has_selection','region_requires_object','result_defines_region','channel_has_region','result_defines_object') AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b jet%' OR lower(e.label) LIKE '%b-jet%' OR lower(e.label) LIKE '%b jet%')), m AS (SELECT DISTINCT a.paper_id FROM assertion a JOIN entity e ON e.entity_id IN (a.subject_id,a.object_id) WHERE a.predicate IN ('object_has_selection','region_requires_object','result_defines_region','channel_has_region','result_defines_object') AND (lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%missing et%' OR lower(e.label) LIKE '%etmiss%' OR lower(e.label) LIKE '%met%')) SELECT p.arxiv_id,p.title FROM paper p JOIN b ON b.paper_id=p.arxiv_id JOIN m ON m.paper_id=p.arxiv_id WHERE p.category='search' ORDER BY p.arxiv_id"}, "rows": 22, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2006"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT DISTINCT p.arxiv_id,p.title,e.entity_id,e.kind,e.label,a.predicate FROM paper p JOIN assertion a ON a.paper_id=p.arxiv_id JOIN entity e ON e.entity_id IN (a.subject_id,a.object_id) WHERE p.category='search' AND a.predicate IN ('object_has_selection','region_requires_object','channel_has_region','result_defines_region','result_defines_object') AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b-jet%' OR lower(e.label) LIKE '%b jet%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%etmiss