label) LIKE '%b jet%' OR lower(s.label) LIKE '%b-jet%' OR lower(s.label) LIKE '%bjet%') AND NOT (lower(COALESCE(o.label,'')) LIKE '%non-b-tag%' OR lower(COALESCE(s.label,'')) LIKE '%veto%') ORDER BY a.paper_id"}, "rows": 46, "error": null, "truncated": false, "preview": "paper_id | title\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=13$   TeV\n2004.04545 | $CP$ "}, {"tool": "sql", "round": 5, "args": {"query": "SELECT COUNT(DISTINCT a.paper_id) AS n FROM assertion a LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE a.predicate IN ('object_has_selection','region_requires_object','region_has_selection','result_defines_region','result_defines_object') AND (lower(o.label) LIKE '%b-tag%' OR lower(o.label) LIKE '%b jet%' OR lower(o.label) LIKE '%b-jet%' OR lower(o.label) LIKE '%bjet%' OR lower(s.label) LIKE '%b-tag%' OR lower(s.label) LIKE '%b jet%' OR lower(s.label) LIKE '%b-jet%' OR lower(s.label) LIKE '%bjet%') AND NOT (lower(COALESCE(o.label,'')) LIKE '%non-b-tag%' OR lower(COALESCE(s.label,'')) LIKE '%veto%')"}, "rows": 1, "error": null, "truncated": false, "preview": "n\n46\n(1 rows)"}, {"tool": "sql", "round": 6, "args": {"query": "SELECT DISTINCT a.paper_id FROM assertion a LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE a.predicate IN ('object_has_selection','region_requires_object','region_has_selection') AND (lower(o.label) LIKE '%b-tag%' OR lower(o.label) LIKE '%b jet%' OR lower(o.label) LIKE '%b-jet%' OR lower(o.label) LIKE '%bjet%' OR lower(s.label) LIKE '%b-tag%' OR lower(s.label) LIKE '%b jet%' OR lower(s.label) LIKE '%b-jet%' OR lower(s.label) LIKE '%bjet%') AND NOT (lower(COALESCE(o.label,'')) LIKE '%non-b-tag%' OR lower(COALESCE(s.label,'')) LIKE '%veto%') ORDER BY a.paper_id"}, "rows": 46, "error": null, "truncated": false, "preview": "paper_id