{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-07", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses have a ttZ background and a control region used to normalise that background?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2004.14060", "2006.05880", "2009.04363", "2012.08600", "2103.04956", "2106.14246", "2107.12553", "2110.11231", "2112.03161", "2202.08676", "2209.07327", "2309.14442", "2312.04450", "2401.05299", "2405.18661", "2509.22535", "2510.07527"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ttZ background top-antitop Z background", "kind": "background", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background:top-quark | background | Top quark background (ttbar, single top, ttW, ttZ)\nhepkg:background:top | background | Top background\nhepkg:background:ttx_prompt | b"}, {"tool": "search", "round": 1, "args": {"text": "control region used to normalise background normalization", "kind": "event_region", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:region:cr-bins | event_region | Control-region (CR) bins used for background constraint\nhepkg:region:dpe_normalization | event_region | DPE background normalization regi"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, a.predicate, e.entity_id, e.kind, e.label, a.object_value FROM assertion a JOIN entity e ON e.entity_id=a.object_id WHERE (lower(e.label) LIKE '%ttz%' OR lower(e.label) LIKE '%t\\\\bar{t}z%') LIMIT 200"}, "rows": 56, "error": null, "truncated": false, "preview": "paper_id | predicate | entity_id | kind | label | object_value\n2004.14060 | result_defines_region | hepkg:region:crttz | event_region | CRTTZ | \n2004.14060 | channel_has_region | hepkg:region:crttz | "}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, a.predicate, s.entity_id AS subject_id, se.label AS subject_label, a.object_id, e.kind, e.label, a.object_value FROM assertion a JOIN entity e ON e.entity_id=a.object_id LEFT JOIN entity se ON se.entity_id=a.subject_id WHERE lower(e.label) LIKE '%normal%' OR lower(a.object_value) LIKE '%normal%' LIMIT 200"}, "rows": 0, "error": "no such column: s.entity_id", "truncated": false, "preview": "ERROR: no such column: s.entity_id"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT p.arxiv_id,p.title,a.assertion_id,a.predicate,e.kind,e.label,ev.quote FROM paper p JOIN assertion a ON a.paper_id=p.arxiv_id JOIN entity e ON e.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE p.arxiv_id IN ('2006.05880','2110.11231','2202.08676','2401.05299','2106.14246','2004.14060') AND (lower(e.label) LIKE '%ttz%' OR lower(e.label) LIKE '%normal%' OR lower(ev.quote) LIKE '%normal%') LIMIT 200"}, "rows": 190, "error": null, "truncated": false, "preview": "arxiv_id | title | assertion_id | predicate | kind | label | quote\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT arxiv_id,title FROM paper WHERE arxiv_id IN ('2006.05880','2110.11231','2202.08676','2401.05299','2106.14246','2004.14060')"}, "rows": 6, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2006"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.paper_id,a.predicate,a.subject_id,es.label AS subject_label,a.object_id,eo.label AS object_label,ev.quote FROM assertion a JOIN entity eo ON eo.entity_id=a.object_id LEFT JOIN entity es ON es.entity_id=a.subject_id L