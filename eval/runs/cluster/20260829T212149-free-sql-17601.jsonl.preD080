{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-07", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses have a ttZ background and a control region used to normalise that background?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2001.06899", "2004.14060", "2006.05880", "2009.04363", "2010.14293", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2106.01676", "2106.14246", "2107.12553", "2110.11231", "2111.08340", "2112.00895", "2112.03161", "2202.08676", "2211.08028", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2401.07090", "2402.08486", "2405.18661", "2408.03744", "2508.13900", "2509.22535", "2602.18611", "2604.27044"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ttZ background top quark pair Z background", "kind": "background", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background:ttbar-pair | background | Top quark pair (ttbar) background\nhepkg:background:top-quark | background | Top quark background (ttbar, single top, ttW, ttZ)\nhepkg"}, {"tool": "search", "round": 1, "args": {"text": "control region used to normalise or normalize background", "kind": "event_region", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:region:cr-bins | event_region | Control-region (CR) bins used for background constraint\nhepkg:region:cr-mgg-sideband | event_region | Background normalization control re"}, {"tool": "search", "round": 1, "args": {"text": "ttZ", "kind": "", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:region:ttz_cr | event_region | ttZ CR\nhepkg:region:3l-ttz-cr | event_region | 3ℓ ttZ\nhepkg:process:ttbarz-production | physics_process | ttZ production\nhepkg:observable:"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_i