{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-02", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses estimate a background using an ABCD method, or an ABCD-style sideband or matrix method over independent regions?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "", "answered": false, "papers": ["2004.01678", "2006.05880", "2008.05928", "2011.07812", "2012.01581", "2103.06956", "2106.01676", "2202.08676", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2307.01094", "2401.05299", "2404.06204", "2510.07527", "2511.11853", "2604.27044"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ABCD background estimation method using four independent regions", "kind": "", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:method:abcd-method | background_method | ABCD data-driven background estimation method\nhepkg:background_method:abcd_data_driven_crs | background_method | ABCD (matrix) d"}, {"tool": "search", "round": 1, "args": {"text": "matrix method background estimate fake objects", "kind": "", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:method:matrix-method | background_method | Matrix method for misidentified lepton background estimation\nhepkg:method:simulation_based_bkg_estimate | background_method | "}, {"tool": "search", "round": 1, "args": {"text": "sideband method background estimate independent control regions", "kind": "", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:region:cr-sideband | event_region | sideband control region\nhepkg:method:mc_template | background_method | MC-template background estimation method (simulation templates"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT a.paper_id, p.title, p.arxiv_id, e.entity_id, e.label, a.predicate, a.object_value\nFROM assertion a\nJOIN entity e ON e.entity_id=a.object_id\nJOIN paper p ON p.arxiv_id=a.paper_id\nWHERE a.predicate='background_uses_method'\n  AND (lower(e.label) LIKE '%abcd%' OR lower(e.label) LIKE '%matrix method%' OR lower(e.label) LIKE '%sideband%' OR lower(e.label) LIKE '%two-dimensional sideband%' OR lower(e.label) LIKE '%independent region%')\nORDER BY a.paper_id, e.label\nLIMIT 200"}, "rows": 18, "error": null, "truncated": false, "preview": "paper_id | title | arxiv_id | entity_id | label | predicate | object_value\n2004.01678 | Search for Higgs Boson Decays into a $Z$ Boson and a Light Hadronically Decaying Resonance Using 13 TeV $pp$ Col"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT p.arxiv_id, p.title, e.entity_id, e.label, a.predicate, GROUP_CONCAT(DISTINCT substr(ev.quote,1,300), ' | ') AS evidence\nFROM assertion a\nJOIN entity e ON e.entity_id=a.object_id\nJOIN paper p ON p.arxiv_id=a.paper_id\nLEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id\nLEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id\nWHERE a.predicate='background_uses_method'\n  AND (lower(e.label) LIKE '%abcd%' OR lower(e.label) LIKE '%matrix method%' OR lower(e.label) LIKE '%sideband%')\nGROUP BY p.arxiv_id, e.entity_id\nORDER BY p.arxiv_id\nLIMIT 100"}, "rows": 0, "error": "DISTINCT aggregates must have exactly one argument", "truncated": false, "preview": "ERROR: DISTINCT aggregates must have exactly one argument"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT p.arxiv_id, p.title, e.entity_id, e.label, a.predicate, GROUP_CONCAT(substr(ev.quote,1,300), ' | ') AS evidence\nFROM assertion a\nJOIN entity e ON e.entity_id=a.object_id\nJOIN paper p ON p.arxiv_id=a.paper_id\nLEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id\nLEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id\nWHERE a.predicate='background_uses_method'\n  AND (lower(e.label) LIKE '%abcd%' OR lower(e.label) LIKE '%matrix method%' OR lower(e.label) LIKE '%sideband%')\nGROUP BY p.arxiv_id, e.entity_id\nORDER BY p.arxiv_id\nLIMIT 100"}, "rows": 18, "error": null, "truncated": false, "preview": "arxiv_id | title | entity_id | label | predicate | evidence\n2004.01678 | Search for Higgs Boson Decays into a $Z$ Boson and a Light Hadronically Decaying Resonance Using 13 TeV $pp$ Collision Data fro"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT p.arxiv_id, p.title, e.entity_id, e.label, substr(ev.quote,1,700) AS evidence\nFROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id\nJOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id JOIN evidence ev ON ev.evidence_id=ae.evidence_id\nWHERE a.predicate='background_uses_method'\nAND p.arxiv_id IN ('2206.09466','2207.00348','2208.12095','2209.07327','2307.01094','2401.05299','2404.06204','2510.07527','2511.11853','2604.27044')\nORDER BY p.arxiv_id, a.assertion_id"}, "rows": 106, "error": null, "truncated": false, "preview": "arxiv_id | title | entity_id | label | evidence\n2206.09466 | Measurements of the Higgs boson production cross section and couplings in the $\\mathup{{{W}}}$ boson pair decay channel in proton-proton co"}, {"tool": "sql", "round": 6, "args": {"query": "SELECT DISTINCT p.arxiv_id, p.title, e.entity_id, e.label\nFROM assertion a JOIN entity e ON e.entity_id=a.object_id JOIN paper p ON p.arxiv_id=a.paper_id\nWHERE a.predicate='background_uses_method'\nAND (lower(e.label) LIKE '%abcd%' OR lower(e.label) LIKE '%matrix method%' OR lower(e.label) LIKE '%two-dimensional sideband%' OR lower(e.label) LIKE '%double two-dimensional sideband%')\nORDER BY p.arxiv_id"}, "rows": 13, "error": null, "truncated": false, "preview": "arxiv_id | title | entity_id | label\n2004.01678 | Search for Higgs Boson Decays into a $Z$ Boson and a Light Hadronically Decaying Resonance Using 13 TeV $pp$ Collision Data from the ATLAS Detector | "}], "sets": {}, "entity_ids": ["hepkg:background:sr-total", "hepkg:background:ttbar", "hepkg:background_