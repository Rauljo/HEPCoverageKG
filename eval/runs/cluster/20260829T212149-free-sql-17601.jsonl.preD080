{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-01", "repeat": 1, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses are searches (rather than measurements) whose event selection uses both b-tagged jets and missing transverse momentum?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2004.01678", "2004.14060", "2006.05880", "2008.05928", "2010.14293", "2011.07812", "2012.01581", "2012.03799", "2012.08600", "2102.01444", "2106.01676", "2106.14246", "2107.12553", "2112.03161", "2201.11585", "2202.08676", "2209.07327", "2211.08028", "2302.05225", "2304.08962", "2307.01094", "2403.01556", "2407.10549", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "b-tagged jets / b-tagged jet", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:bjet | detector_object | b-tagged jets\nhepkg:object:bjet_reco | detector_object | b-tagged jet\nhepkg:object:bjet-relaxed | detector_object | subleading b-tagged j"}, {"tool": "search", "round": 1, "args": {"text": "missing transverse momentum / MET / missing ET", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:met | detector_object | Missing transverse momentum (MET)\nhepkg:object:met_reco | detector_object | Reconstructed missing transverse momentum (MET)\nhepkg:object:m"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT kind, entity_id, label FROM entity WHERE lower(label) LIKE '%b-tag%' OR lower(label) LIKE '%b tag%' ORDER BY kind, label LIMIT 100"}, "rows": 82, "error": null, "truncated": false, "preview": "kind | entity_id | label\nbackground | hepkg:background:total-smooth-mJgamma | Total SM background in m_{Jγ} spectrum (single- and double-b-tagged categories)\nbackground_method | hepkg:method:ancillary"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT kind, entity_id, label FROM entity WHERE lower(label) LIKE '%missing transverse%' OR lower(label) LIKE '%missing et%' OR lower(label) LIKE '%met%' AND kind='detector_object' ORDER BY kind, label LIMIT 100"}, "rows": 59, "error": null, "truncated": false, "preview": "kind | entity_id | label\nchannel | hepkg:final_state:alljets_met_0lepton | All-hadronic multi-jet + missing transverse momentum final state (zero electrons/muons, one or two b-tagged jets)\nchannel | h"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT DISTINCT predicate, family, COUNT(*) AS n FROM assertion WHERE predicate IN ('region_requires_object','region_has_selection','object_has_selection','channel_has_region','result_defines_region','result_defines_object') GROUP BY predicate,family"}, "rows": 6, "error": null, "truncated": false, "preview": "predicate | family | n\nchannel_has_region | channels_regions | 889\nobject_has_selection | objects | 1335\nregion_has_selection | channels_regions | 1242\nregion_requires_object | channels_regions | 1055"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT a.paper_id, p.arxiv_id, p.title, p.category, a.predicate, e.kind, e.label, COUNT(*) AS n FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id JOIN entity e ON e.entity_id=a.object_id WHERE p.category='search' AND a.predicate IN ('region_requires_object','object_has_selection','region_has_selection','channel_has_region') AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tag%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%missing et%' OR lower(e.label) LIKE '%met%') GROUP BY a.paper_id,a.predicate,e.entity_id ORDER BY a.arxiv_id, a.predicate, e.label LIMIT 200"}, "rows": 0, "error": "no such column: a.arxiv_id", "truncated": false, "preview": "ERROR: no such column: a.arxiv_id"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT eo.paper_id, p.arxiv_id, p.title, p.category, eo.kind, eo.entity_id, eo.label FROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id WHERE p.category='search' AND (lower(eo.label) LIKE '%b-tag%' OR lower(eo.label) LIKE '%b tag%' OR lower(eo.label) LIKE '%missing transverse%' OR lower(eo.label) LIKE '%missing et%' OR lower(eo.label) LIKE '%met%') ORDER BY eo.paper_id LIMIT 200"}, "rows": 200, "error": null, "truncated": false, "preview": "paper_id | arxiv_id | title | category | kind | entity_id | label\n2004.01678 | 2004.01678 | Search for Higgs Boson Decays into a $Z$ Boson and a Light Hadronically Decaying Resonance Using 13 TeV $pp$"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id, p.arxiv_id, p.title, p.category, a.predicate, e.kind, e.label, COUNT(*) AS n FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id JOIN entity e ON e.entity_id=a.object_id WHERE p.category='search' AND a.predicate IN ('region_requires_object','object_has_selection','region_has_selection','channel_has_region') AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tag%' OR lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%missing et%' OR (e.kind='detector_object' AND lower(e.label) LIKE '%met%')) GROUP BY a.paper_id,a.predicate,e.entity_id ORDER BY p.arxiv_id, a.predicate, e.label LIMIT 300"}, "rows": 56, "error": null, "truncated": false, "preview": "paper_id | arxiv_id | title | category | predicate | kind | label | n\n2004.14060 | 2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse mome"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id, p.arxiv_id, a.predicate, s.kind AS subject_kind, s.label AS subject_label, o.kind AS object_kind, o.label AS object_label FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id JOIN entity s ON s.entity_id=a.subject_id JOIN entity o ON o.entity_id=a.object_id WHERE p.category='search' AND p.arxiv_id IN ('2004.14060','2006.05880') AND a.predicate IN ('region_requires_object','object_has_selection','region_has_selection','channel_has_region') ORDER BY p.arxiv_id, a.predicate LIMIT 200"}, "rows": 155, "error": null, "truncated": false, "preview": "paper_id | arxiv_id | predicate | subject_kind | subject_label | object_kind | object_label\n2004.14060 | 2004.14060 | channel_has_region | channel | All-hadronic multi-jet + missing transverse momentu"}, {"tool": "sql", "round": 5, "args": {"query": "WITH b AS (SELECT DISTINCT a.paper_id FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id JOIN entity e ON e.entity_id=a.object_id WHERE p.category='search' AND a.predicate IN ('region_requires_object','region_has_selection','object_has_selection') AND (lower(e.label) LIKE '%b-tag%' OR lower(e.label) LIKE '%b tag%' OR lower(e.label) LIKE '%b jet%' OR lower(e.label) LIKE '%b-jet%')), m AS (SELECT DISTINCT a.paper_id FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id JOIN entity e ON e.entity_id=a.object_id WHERE p.category='search' AND a.predicate IN ('region_requires_object','region_has_selection','object_has_selection') AND (lower(e.label) LIKE '%missing transverse%' OR lower(e.label) LIKE '%missing et%' OR (e.kind='detector_object' AND (lower(e.label) LIKE '%met%' OR lower(e.label) LIKE '%p_t^miss%' OR lower(e.label) LIKE '%p_t%miss%')))) SELECT p.arxiv_id, p.title FROM paper p JOIN b ON b.paper_id=p.arxiv_id JOIN m ON m.paper_id=p.arxiv_id WHERE p.category='search' ORDER BY p.arxiv_id"}, "rows": 10, "error": null, "truncated": false, "preview": "arxiv_id | title\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV with the ATLAS detector\n2006"}, {"tool": "sql", "round": 6, "args": {"query": "SELECT p.arxiv_id,p.title,p.category,a.predicate,s.kind,s.label AS subject,o.kind AS object_kind,o.label AS object_label FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id JOIN entity s ON s.entity_id=a.subject_id JOIN entity o 