{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-07", "repeat": 0, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses have a ttZ background and a control region used to normalise that background?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2004.14060", "2006.05880", "2012.03799", "2102.01444", "2110.11231", "2202.08676", "2307.01094"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "ttZ background top-antitop Z", "kind": "background", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:background:top-quark | background | Top quark background (ttbar, single top, ttW, ttZ)\nhepkg:background:top | background | Top background\nhepkg:background:ttx_prompt | b"}, {"tool": "search", "round": 1, "args": {"text": "control region used to normalize background", "kind": "event_region", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:region:cr-bins | event_region | Control-region (CR) bins used for background constraint\nhepkg:region:cr-mgg-sideband | event_region | Background normalization control re"}, {"tool": "search", "round": 1, "args": {"text": "normalization of ttZ background control region", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:object:CR-Z-ttZ | detector_object | Control region CR^Z_ttZ for ttZ background normalisation (3ℓ selection)\nhepkg:object:VR-Z-ttZ | detector_object | Validation region V"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, a.predicate, a.subject_id, s.label AS subject_label, a.object_id, o.label AS object_label, a.object_value FROM assertion a LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE (a.object_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttz-bkg','hepkg:background:ttbarZ','hepkg:background:ttZ-3l') OR a.subject_id IN ('hepkg:background:ttz','hepkg:background:ttz-tzq','hepkg:background:ttz-bkg','hepkg:background:ttbarZ','hepkg:background:ttZ-3l')) LIMIT 200"}, "rows": 15, "error": null, "truncated": false, "preview": "paper_id | predicate | subject_id | subject_label | object_id | object_label | object_value\n2006.05880 | result_estimates_background | hepkg:result:d5288b5bc0407b0b2005d131 | Search for top squarks in"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT e.entity_id, e.kind, e.label, COUNT(DISTINCT eo.paper_id) AS papers FROM entity e JOIN entity_occurrence eo ON eo.entity_id=e.entity_id WHERE lower(e.label) LIKE '%ttz%' AND (lower(e.label) LIKE '%control%' OR lower(e.label) LIKE '%normal%') GROUP BY e.entity_id,e.kind,e.label ORDER BY papers DESC"}, "rows": 7, "error": null, "truncated": false, "preview": "entity_id | kind | label | papers\nhepkg:region:3l-ttz-cr | event_region | 3L ttZ control region | 2\nhepkg:object:CR-Z-ttZ | detector_object | Control region CR^Z_ttZ for ttZ background normalisation ("}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT a.paper_id, a.predicate, a.subject_id, s.label AS subject_label, a.object_id, o.kind AS object_kind, o.label AS object_label, a.object_value FROM assertion a LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE a.paper_id IN ('2006.05880','2004.14060','2012.03799','2102.01444','2202.08676','2307.01094','2110.11231') AND (lower(COALESCE(s.label,'')) LIKE '%ttz%' OR lower(COALESCE(o.label,'')) LIKE '%ttz%' OR lower(COALESCE(a.object_value,'')) LIKE '%ttz%' OR lower(COALESCE(s.label,'')) LIKE '%control%' OR lower(COALESCE(o.label,'')) LIKE '%control%') ORDER BY a.paper_id, a.predicate LIMIT 300"}, "rows": 200, "error": null, "truncated": true, "preview": "paper_id | predicate | subject_id | subject_label | object_id | object_kind | object_label | object_value\n2004.14060 | background_uses_method | hepkg:background:zjets | $Z/\\gamma^{*}+\\mathrm{jets}$ ba"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT eo.paper_id, eo.entity_id, eo.kind, eo.label FROM entity_occurrence eo WHERE eo.paper_id IN ('2006.05880','2004.14060','2012.03799','2102.01444','2202.08676','2307.01094','2110.11231') AND (lower(eo.label) LIKE '%ttz%' OR lower(eo.label) LIKE '%control region%' OR lower(eo.label) LIKE '%normal%') ORDER BY eo.paper_id, eo.kind, eo.label LIMIT 300"}, "rows": 66, "error": null, "truncated": false, "preview": "paper_id | entity_id | kind | label\n2004.14060 | hepkg:method:cr_fit_normalization | background_method | Control-region-based background normalisation via simultaneous profile likelihood fit\n2004.1406"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT p.arxiv_id,p.title, a.predicate, s.label AS subject, o.label AS object, a.object_value FROM paper p JOIN assertion a ON a.paper_id=p.arxiv_id LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE p.arxiv_id IN ('2006.05880','2004.14060','2012.03799','2102.01444','2202.08676','2110.11231','2307.01094') AND (a.predicate IN ('background_uses_method','result_estimates_background','result_defines_region','channel_has_region','result_defines_region') OR lower(COALESCE(o.label,'')) LIKE '%ttz%' OR lower(COALESCE(s.label,'')) LIKE '%ttz%') ORDER BY p.arxiv_id, a.predicate LIMIT 250"}, "rows": 200, "error": null, "truncated": true, "preview": "arxiv_id | title | predicate | subject | object | object_value\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at "}, {"tool": "sql", "round": 5, "args": {"query": "SELECT p.arxiv_id, p.title, eo.entity_id, eo.kind, eo.label FROM paper p JOIN entity_occurrence eo ON eo.paper_id=p.arxiv_id WHERE p.arxiv_id IN ('2006.05880','2004.14060','2012.03799','2102.01444','2202.08676','2110.11231','2307.01094') AND eo.kind='event_region' AND (lower(eo.label) LIKE '%control%' OR lower(eo.label) LIKE '%cr%') ORDER BY p.arxiv_id, eo.label"}, "rows": 32, "error": null, "truncated": false, "preview": "arxiv_id | title | entity_id | kind | label\n2004.14060 | Search for a scalar partner of the top quark in the all-hadronic $t\\bar{t}$ plus missing transverse momentum final state at $\\sqrt{s}=13$ TeV w"}, {"tool": "sql", "round": 6, "args": {"query": "SELECT a.paper_id,a.predicate,s.label AS subject,o.kind,o.label AS object,a.object_value FROM assertion a LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE a.paper_id IN ('2006.05880','2012.03799','2102.01444','2202.08676','2110.11231') AND a.predicate IN ('background_uses_method','result_defines_region','channel_has_region','result_estimates_background') AND (lower(COALESCE(s.label,'')) LIKE '%ttz%' OR lower(COALESCE(o.label,'')) LIKE '%ttz%' OR lower(COALESCE(o.label,'')) LIKE '%control%' OR lower(COALESCE(o.label,'')) LIKE '%cr%') ORDER BY a.paper_id,a.predicate"}, "rows": 70, "error": null, "truncated": false, "preview": "paper_id | predicate | subject | kind | object | object_value\n2006.05880 | background_uses_method | ttZ background (3-lepton selection) | background_method | Control-region normalisation via profile-l"}], "sets": {}, "entity_ids": ["hepkg:background:Wt", "hepkg:background:diboson", "hepkg:background:multiboson-3l", "hepkg:background:other_ttx_ttz", "hepkg:background:others-minor", "hepkg:background:single-top", "hepkg:background:singletop", "hepkg:background:top", "hepkg:background:top-quark", "hepkg:background:top-singlelepton", "hepkg:background:ttZ-3l", "hepkg:background:ttbar", "hepkg:background:ttbar-1l", "hepkg:background:ttbar-pair", "hepkg:background:ttbar-w-z-h", "hepkg:background:ttbarZ", "hepkg:background:ttx_prompt", "hepkg:background:ttz", "hepkg:background:ttz-bkg", "hepkg:background:ttz-gammastar", "hepkg:background:ttz-tzq", "hepkg:background:t