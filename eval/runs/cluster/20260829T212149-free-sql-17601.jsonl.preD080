{"run_id": "20260829T212149-free-sql-17601", "qid": "gabriel-gf-08", "repeat": 2, "system": "free-sql", "config_hash": "4cc587a8ef30", "git_sha": "f92f1f0-dirty", "question": "Which analyses require exactly two electrons OR exactly two muons as alternative selections -- parallel ee and mumu channels, rather than requiring both?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "", "answered": false, "papers": ["2001.06899", "2004.14060", "2009.04363", "2009.14537", "2010.14293", "2011.07812", "2102.01444", "2106.01676", "2106.14246", "2110.11231", "2112.03161", "2201.11585", "2202.08676", "2207.00348", "2208.12095", "2209.07327", "2302.05225", "2307.01094", "2308.02285", "2309.14442", "2312.04450", "2401.05299", "2401.07090", "2403.01556", "2404.06204", "2503.19420", "2506.13565", "2509.22535", "2511.11853", "2602.18611"], "value": null, "steps": [{"tool": "search", "round": 1, "args": {"text": "exactly two electrons dielectron ee selection channel", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:channel:dielectron | channel | Dielectron (e+e-) control channel\nhepkg:region:CR_b_ee | event_region | CR_b^{ee}: 1-jet dielectron control region with exactly one b-tagg"}, {"tool": "search", "round": 1, "args": {"text": "exactly two muons dimuon mumu selection channel", "kind": "", "limit": 20}, "rows": 20, "error": null, "preview": "entity_id | kind | label\nhepkg:channel:dimuon | channel | Dimuon (mu+mu-) channel\nhepkg:object_selection:muon_2L | selection_requirement | 2L channel muon selection\nhepkg:object_selection:muon_1L | se"}, {"tool": "sql", "round": 1, "args": {"query": "SELECT kind, COUNT(*) AS n FROM entity WHERE lower(label) LIKE '%electron%' OR lower(label) LIKE '%muon%' GROUP BY kind ORDER BY n DESC"}, "rows": 15, "error": null, "truncated": false, "preview": "kind | n\nsystematic_uncertainty | 66\ndetector_object | 53\nevent_region | 26\nchannel | 17\nselection_requirement | 10\nresult | 8\nbackground | 8\nbenchmark | 5\nbackground_method | 5\npaper | 3\nobservable |"}, {"tool": "sql", "round": 2, "args": {"query": "SELECT a.paper_id, p.title, a.predicate, a.subject_id, es.label AS subject_label, es.kind AS subject_kind, a.object_id, eo.label AS object_label, eo.kind AS object_kind, a.object_value FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id LEFT JOIN entity es ON es.entity_id=a.subject_id LEFT JOIN entity eo ON eo.entity_id=a.object_id WHERE (lower(COALESCE(es.label,'')) LIKE '%ee%' OR lower(COALESCE(es.label,'')) LIKE '%dielectron%' OR lower(COALESCE(es.label,'')) LIKE '%mumu%' OR lower(COALESCE(es.label,'')) LIKE '%dimuon%' OR lower(COALESCE(eo.label,'')) LIKE '%ee%' OR lower(COALESCE(eo.label,'')) LIKE '%dielectron%' OR lower(COALESCE(eo.label,'')) LIKE '%mumu%' OR lower(COALESCE(eo.label,'')) LIKE '%dimuon%') AND a.predicate IN ('channel_has_region','result_has_channel','result_defines_region','region_has_selection','region_requires_object','channel_has_region','result_defines_object','object_has_selection') LIMIT 200"}, "rows": 200, "error": null, "truncated": false, "preview": "paper_id | title | predicate | subject_id | subject_label | subject_kind | object_id | object_label | object_kind | object_value\n2009.04363 | Evidence for Higgs boson decay to a pair of muons | channe"}, {"tool": "sql", "round": 3, "args": {"query": "SELECT entity_id, kind, label FROM entity WHERE lower(label) LIKE '%exactly 2%' OR lower(label) LIKE '%exactly two%' OR lower(label) LIKE '%two electrons%' OR lower(label) LIKE '%two muons%' OR lower(label) LIKE '%2 electrons%' OR lower(label) LIKE '%2 muons%' ORDER BY kind,label"}, "rows": 8, "error": null, "truncated": false, "preview": "entity_id | kind | label\nhepkg:channel:1l2t | channel | 1L2T channel (exactly 1 light lepton, exactly 2 h candidates)\nhepkg:channel:2l1t | channel | 2L1T channel (exactly 2 light leptons, exactly 1 h "}, {"tool": "sql", "round": 3, "args": {"query": "SELECT DISTINCT eo.paper_id, p.title, eo.kind, eo.label, eo.entity_id FROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id WHERE (lower(eo.label) LIKE '%dielectron%' OR lower(eo.label) LIKE '%dimuon%' OR lower(eo.label) LIKE '%ee%' OR lower(eo.label) LIKE '%mumu%') AND eo.kind IN ('channel','event_region','selection_requirement') ORDER BY eo.paper_id, eo.kind, eo.label"}, "rows": 60, "error": null, "truncated": false, "preview": "paper_id | title | kind | label | entity_id\n2009.04363 | Evidence for Higgs boson decay to a pair of muons | channel | Dimuon pair plus additional charged lepton(s) from leptonic W/Z decay (VH categor"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT a.paper_id, p.title, a.predicate, a.subject_id, s.label AS subject_label, s.kind AS subject_kind, a.object_id, o.label AS object_label, o.kind AS object_kind FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id WHERE (a.subject_id IN ('hepkg:object_selection:electron_2L','hepkg:object_selection:muon_2L') OR a.object_id IN ('hepkg:object_selection:electron_2L','hepkg:object_selection:muon_2L')) ORDER BY a.paper_id, a.predicate"}, "rows": 2, "error": null, "truncated": false, "preview": "paper_id | title | predicate | subject_id | subject_label | subject_kind | object_id | object_label | object_kind\n2509.22535 | Simultaneous probe of the charm and bottom quark Yukawa couplings using $"}, {"tool": "sql", "round": 4, "args": {"query": "SELECT DISTINCT eo.paper_id, p.title, eo.entity_id, eo.kind, eo.label FROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id WHERE eo.entity_id IN ('hepkg:channel:dielectron','hepkg:channel:dimuon','hepkg:channel:dilepton_plus_jets') ORDER BY eo.paper_id, eo.entity_id"}, "rows": 3, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | kind | label\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=1"}, {"tool": "search", "round": 4, "args": {"text": "same-flavour dilepton selection exactly two electrons or exactly two muons ee mumu alternative channels", "kind": "channel", "limit": 30}, "rows": 30, "error": null, "preview": "entity_id | kind | label\nhepkg:final_state:emu_ss_1or2_bjets_reco | channel | Same-sign $e\\mu$ pair with exactly one or exactly two $b$-tagged jets (reconstructed level, misidentified-lepton control c"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT eo.paper_id, p.title, eo.entity_id, eo.label, eo.kind FROM entity_occurrence eo JOIN paper p ON p.arxiv_id=eo.paper_id WHERE eo.kind='channel' AND (lower(eo.label) LIKE '%ee%' OR lower(eo.label) LIKE '%μμ%' OR lower(eo.label) LIKE '%mumu%' OR lower(eo.label) LIKE '%mu+mu%' OR lower(eo.label) LIKE '%e+e%') ORDER BY eo.paper_id, eo.label"}, "rows": 21, "error": null, "truncated": false, "preview": "paper_id | title | entity_id | label | kind\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=1"}, {"tool": "search", "round": 5, "args": {"text": "dilepton ee or mumu exactly two electrons or exactly two muons selection", "kind": "", "limit": 50}, "rows": 50, "error": null, "preview": "entity_id | kind | label\nhepkg:final_state:displaced-dilepton | channel | Two displaced leptons (ee, mumu, or emu)\nhepkg:observable:lepton-flavor-ratio | observable | Ratio of differential dilepton pr"}, {"tool": "sql", "round": 5, "args": {"query": "SELECT p.arxiv_id, p.title, COUNT(DISTINCT CASE WHEN lower(eo.label) LIKE '%electron%' OR lower(eo.label) LIKE '%ee%' OR lower(eo.label) LIKE '%e+e%' THEN eo.entity_id END) AS e_entities, COUNT(DISTINCT CASE WHEN lower(eo.label) LIKE '%muon%' OR lower(eo.label) LIKE '%mumu%' OR lower(eo.label) LIKE '%μ%' OR lower(eo.label) LIKE '%mu+mu%' THEN eo.entity_id END) AS mu_entities FROM paper p JOIN entity_occurrence eo ON eo.paper_id=p.arxiv_id WHERE eo.kind IN ('channel','event_region','selection_requirement') GROUP BY p.arxiv_id,p.title HAVING e_entities>0 AND mu_entities>0 ORDER BY p.arxiv_id"}, "rows": 19, "error": null, "truncated": false, "preview": "arxiv_id | title | e_entities | mu_entities\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proton collisions at $\\sqrt{s}=1"}, {"tool": "sql", "round": 6, "args": {"query": "SELECT a.paper_id, p.title, a.predicate, s.label AS subject, o.label AS object, a.object_value, ev.quote FROM assertion a JOIN paper p ON p.arxiv_id=a.paper_id LEFT JOIN entity s ON s.entity_id=a.subject_id LEFT JOIN entity o ON o.entity_id=a.object_id LEFT JOIN assertion_evidence ae ON ae.assertion_id=a.assertion_id LEFT JOIN evidence ev ON ev.evidence_id=ae.evidence_id WHERE a.paper_id IN ('2001.06899','2009.14537','2201.11585','2506.13565','2509.22535','2511.11853') AND (lower(COALESCE(s.label,'')) LIKE '%dilepton%' OR lower(COALESCE(s.label,'')) LIKE '%electron%' OR lower(COALESCE(s.label,'')) LIKE '%muon%' OR lower(COALESCE(s.label,'')) LIKE '%ee%' OR lower(COALESCE(s.label,'')) LIKE '%mumu%' OR lower(COALESCE(o.label,'')) LIKE '%dilepton%' OR lower(COALESCE(o.label,'')) LIKE '%electron%' OR lower(COALESCE(o.label,'')) LIKE '%muon%' OR lower(COALESCE(o.label,'')) LIKE '%ee%' OR lower(COALESCE(o.label,'')) LIKE '%mumu%') ORDER BY a.paper_id, a.assertion_id LIMIT 300"}, "rows": 200, "error": null, "truncated": true, "preview": "paper_id | title | predicate | subject | object | object_value | quote\n2001.06899 | Measurement of the associated production of a $\\mathup{{{Z}}}$ boson with charm or bottom quark jets in proton-proto"}], "sets": {}, "entity_ids": ["hepkg:background:cosmic-ray-muons-mumu", "hepkg:background:other-minor-backgrounds", "hepkg:background:z_ll", "hepkg:channel:1l2t", "hepkg:channel:1l3t", "hepkg:channel:2l1t", "