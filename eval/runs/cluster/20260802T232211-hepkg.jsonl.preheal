{"run_id": "20260802T232211-hepkg", "qid": "gen-paper-fe0d98cd", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which generators does analysis 2308.02285 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2308.02285 uses the following generators:\n\n- MadGraph5_aMC@NLO\n- PYTHIA 8 (v8.212/v8.230) parton shower, hadronization, and underlying-event generator with CUETP8M1/CP5 tunes\n- PYTHIA 8 (version 8.219) full generator for diboson production\n- powheg v2\n\nThis information is directly extracted from the paper.", "answered": true, "papers": ["2012.03799", "2206.09466", "2209.07327", "2308.02285", "2401.05299", "2508.13900", "2604.27044"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2308.02285"], "predicate": "sample_uses_generator"}, "rows": 4, "error": null, "seconds": 0.004}], "sets": {}, "entity_ids": ["hepkg:generator:mg5-amcnlo", "hepkg:generator:powheg-v2", "hepkg:generator:pythia8-219", "hepkg:generator:pythia8-shower"], "evidence_ids": ["hepkg:evidence:15431edfc1de6628de359dff", "hepkg:evidence:92a77e30bb46d04eadedc1ec", "hepkg:evidence:9a9d984cd210f1379c1034f9", "hepkg:evidence:9fd0a8d15ec583d5f2728c6f"], "seen_values": ["2", "2308.02285", "8", "8.212", "8.219", "8.23", "8.230", "and", "cp5", "cuetp8m1", "diboson", "for", "full", "generator", "hadronization", "hepkg:generator:mg5-amcnlo", "hepkg:generator:powheg-v2", "hepkg:generator:pythia8-219", "hepkg:generator:pythia8-shower", "madgraph5_amc", "nlo", "parton", "powheg", "production", "pythia", "sample_uses_generator", "shower", "tunes", "underlying-event", "version", "with"], "verification_score": 0.5, "unsupported_claims": ["212", "230"], "llm_calls": 2, "prompt_tokens": 7150, "completion_tokens": 151, "rounds": 2, "seconds": 6.086135249992367, "error": ""}, "scores": {"seconds": 6.086135249992367, "llm_calls": 2.0, "tokens": 7301.0, "rounds":