{"run_id": "20260802T232211-hepkg", "qid": "gen-paper-8a1dde85", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2010.14293 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2010.14293 uses the following background-estimation methods:\n\n- Data-driven jet-smearing (resolution-function) technique\n- MC simulation normalised to NLO cross-section\n- Top-quark control region (CRT) normalisation\n- W+jets control region (CRW) normalisation\n- γ+jets control-region extrapolation for Z(→νν)+jets\n\nThese methods are recorded in the graph as being used in this analysis.", "answered": true, "papers": ["2010.14293"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2010.14293"], "predicate": "background_uses_method"}, "rows": 5, "error": null, "seconds": 0.003}], "sets": {}, "entity_ids": ["hepkg:method:crt", "hepkg:method:crw", "hepkg:method:gamma-jets-cr", "hepkg:method:jet-smearing", "hepkg:method:mc-nlo-norm"], "evidence_ids": ["hepkg:evidence:0450a66f72b25991c10d65c4", "hepkg:evidence:3c307d1f8c682f558fd84ac9", "hepkg:evidence:4750beed25bcae913f312571", "hepkg:evidence:9b549de5e38c0cef52a02a40", "hepkg:evidence:d25ee1e6fa7d4b64925cdae4"], "seen_values": ["2010.14293", "background_method", "background_uses_method", "control", "control-region", "cross-section", "crt", "crw", "data-driven", "extrapolation", "for", "hepkg:method:crt", "hepkg:method:crw", "hepkg:method:gamma-jets-cr", "hepkg:method:jet-smearing", "hepkg:method:mc-nlo-norm", "jet-smearing", "jets", "nlo", "normalisation", "normalised", "region", "resolution-function", "simulation", "technique", "top-quark"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7182, "completion_tokens": 140, "rounds": 2, "seconds": 5.649531666014809, "error": ""}, "scores": {"seconds": 5.6495316660