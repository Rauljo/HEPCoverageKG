{"run_id": "20260802T232211-hepkg", "qid": "gen-paper-fdda346f", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many physics processes does analysis 2111.08340 target?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2111.08340 targets 6 distinct physics processes: Associated production with a top quark-antiquark pair (ttH), associated production with a weak vector boson (VH), gluon-gluon fusion (ggF) Higgs boson production, H → b b̄ decay, inclusive Higgs boson production (ggF+VBF+VH+ttH) at large transverse momentum, and vector-boson fusion (VBF) Higgs boson production.", "answered": true, "papers": ["2111.08340"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2111.08340"], "predicate": "result_targets_process"}, "rows": 6, "error": null, "seconds": 0.002}], "sets": {}, "entity_ids": ["hepkg:process:H-to-bb", "hepkg:process:VBF-production", "hepkg:process:VH-production", "hepkg:process:ggF-production", "hepkg:process:higgs-boson-production-highpt", "hepkg:process:ttH-production"], "evidence_ids": ["hepkg:evidence:5a485a3aa45fcfdfe7eeb0bf", "hepkg:evidence:93dd10889756bd1bd2a6cfc8", "hepkg:evidence:98ab18c7319e7956ba2eaab8", "hepkg:evidence:c1cda0a4cee09bcb4e9d7417", "hepkg:evidence:c476cb77061a35ed495a96f9", "hepkg:evidence:e5fbbd240229027fcdfcfdf4"], "seen_values": ["2111.0834", "2111.08340", "associated", "bbar", "boson", "decay", "fusion", "ggf", "gluon-gluon", "hepkg:process:ggf-production", "hepkg:process:h-to-bb", "hepkg:process:higgs-boson-production-highpt", "hepkg:process:tth-production", "hepkg:process:vbf-production", "hepkg:process:vh-production", "higgs", "inclusive", "large", "momentum", "pair", "physics_process", "production", "quark-antiquark", "result_targets_process", "top", "transverse", "tth", "vbf", "vector", "vector-boson", "weak", "with"], "verification_score": 1.0, "unsupported_claims"