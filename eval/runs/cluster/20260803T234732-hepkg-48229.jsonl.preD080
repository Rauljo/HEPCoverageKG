on", "remaining", "renormalization", "resolution", "resonance", "resonances", "result", "result_has_systematic", "results", "resummation", "rightarrow", "run", "same-sign", "scalar", "scale", "scenarios", "search", "searches", "section", "sections", "signal", "signals", "simulation", "simultaneous", "single-lepton", "sleptons", "small-", "soft-term", "spectra", "sqrt", "squarks", "state", "states", "statistical", "supersymmetric", "supersymmetry", "systematic_uncertainty", "systematics", "tagging", "tau", "tau_h", "tev", "text", "the", "theory", "three", "top", "total", "transverse", "trigger", "ttbar", "two", "uncertainties", "uncertainty", "unclustered", "using", "variation", "vbf", "vector", "vector-like", "via", "weak", "with", "years", "yield", "yukawa"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 4, "prompt_tokens": 24247, "completion_tokens": 1155, "rounds": 4, "seconds": 50.175025396980345, "error": ""}, "scores": {"seconds": 50.175025396980345, "llm_calls": 4.0, "tokens": 25402.0, "rounds": 4.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "entity_retrieved": 1.0, "entities_seen": 122.0, "tool_calls": 3.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 122.0, "evidence_quotes": 116.0}}
{"run_id": "20260803T234732-hepkg-48229", "qid": "gen-retrieval-41b49829", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which analyses define the region 3-lepton Z-dominated signal region?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "hard", "answer": {"text": "The following analyses define the region \"3-lepton Z-dominated signal region\":\n\n- **2007.02873**: Measurements of \\( WH \\) and \\( ZH \\) production in the \\( H \\rightarrow b\\bar{b} \\) decay channel in \\( pp \\) collisions at \\( 13\\, \\text{TeV} \\) with the ATLAS detector.\n- **2009.04363**: Evidence for Higgs boson decay to a pair of muons.\n- **2110.11231**: Measurement of the inclusive and differential \\( WZ \\) production cross sections, polarization angles, and triple gauge couplings in \\( pp \\) collisions at \\( \\sqrt{s}=13\\, \\text{TeV} \\).\n- **2202.08676**: Inclusive nonresonant multilepton probes of new phenomena at \\( \\sqrt{s}=13\\, \\text{TeV} \\).\n- **2206.09466**: Measurements of the Higgs boson production cross section and couplings in the \\( W \\) boson pair decay channel in proton-proton collisions at \\( \\sqrt{s}=13\\, \\text{TeV} \\).\n- **2312.04450**: Inclusive and differential cross-section measurements of \\( t\\bar{t}Z \\) production in \\( pp \\) collisions at \\( \\sqrt{s}=13 \\) TeV with the ATLAS detector, including EFT and spin-correlation interpretations.\n- **2401.05299**: Measurement of the total and differential cross-sections of \\( t\\bar{t}W \\) production in \\( pp \\) collisions at \\( \\sqrt{s}=13 \\) TeV with the ATLAS detector.\n- **2408.03744**: Measurement of the inclusive cross sections for \\( W \\) and \\( Z \\) boson production in proton-proton collisions at \\( \\sqrt{s}=5.02 \\) and 13 TeV.\n- **2503.19420**: Measurements of the production cross-sections of a Higgs boson in association with a vector boson and decaying into \\( WW^{\\ast} \\) with the ATLAS detector at \\( \\sqrt{s}=13 \\) TeV.\n- **2510.07527**: Combination of searches for nonresonant Higgs boson pair production in proton-proton collisions at \\( \\sqrt{s}=13\\, \\text{TeV} \\).\n- **2605.14245**: Constraints on anomalous Higgs boson couplings to vector bosons and fermions using the final state in proton-proton collisions at \\( \\sqrt{s}=13\\, \\text{TeV} \\).\n\nThese analyses are the ones that define the \"3-lepton Z-dominated signal region\" according to the graph.", "answered": true, "papers": ["2004.01678", "2007.02873", "2009.04363", "2009.14537", "2011.07812", "2012.01581", "2102.01444", "2106.01676", "2106.14246", "2107.12553", "2109.13808", "2110.11231", "2112.03161", "2201.11585", "2202.08676", "2206.09466", "2207.00348", "2209.07327", "2304.08962", "2312.04450", "2401.05299", "2404.06204", "2405.18661", "2407.10549", "2408.03744", "2503.19420", "2509.22535", "2510.07527", "2602.18611", "2604.21670", "2605.14245"], "value": null, "steps": [{"round": 1, "tool": "search", "args": {"text": "3-lepton Z-dominated signal region", "kind": "event_region"}, "rows": 60, "error": null, "seconds": 0.406}, {"round": 2, "tool": "subjects_of", "args": {"predicate": "result_defines_region", "object_set": "set_1"}, "rows": 47, "error": null, "seconds": 0.034}, {"round": 3, "tool": "papers_of", "args": {"entity_ids": ["hepkg:result:f30a5987a892a17a8cd2f437", "hepkg:result:3ceb5926f4ce82b73c00210b", "hepkg:result:116cfef0a2431c2e58b354ad", "hepkg:result:b5d7a4349aed174d446f3878", "hepkg:result:c2a8c6c321f85ca4e9620c78", "hepkg:result:180d8e3ba064c02c9c16a8ae", "hepkg:result:dbe00b660bc7b95a46e94404", "hepkg:result:8e885d9541438f775548eee6", "hepkg:result:3c55ab19d48206f55f056f4a", "hepkg:result:6b87d4fa6369adc316efb3b5", "hepkg:result:ca408cb17d5fce2b056fcc4e"]}, "rows": 11, "error": null, "seconds": 0.011}], "sets": {"set_1": ["hepkg:region:0lep_sr", "hepkg:region:1lep_sr", "hepkg:region:2lep_sr", "hepkg:region:3l-sr", "hepkg:region:3l-wz-0jet-cr", "hepkg:reg