.02 \\) and 13 TeV\n- **2508.13900**: General search for supersymmetric particles in scenarios with compressed mass spectra using proton-proton collisions at \\( \\sqrt{s}=13 \\, \\text{TeV} \\)\n- **2604.27044**: Improved results on Higgs boson pair production in the 4 \\( b \\) final state\n\nThese are the distinct papers that used the specified sample.", "answered": true, "papers": ["2001.06899", "2004.01678", "2004.14060", "2006.05880", "2007.02873", "2008.05928", "2009.04363", "2010.14293", "2102.01444", "2103.04956", "2106.01676", "2107.12553", "2109.13808", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2307.01094", "2308.02285", "2402.08486", "2404.06204", "2408.03744", "2503.19420", "2506.13565", "2508.13900", "2509.22535", "2511.11853", "2604.27044"], "value": null, "steps": [{"round": 1, "tool": "search", "args": {"text": "t t̄ t t̄ background MC sample", "kind": "sample"}, "rows": 60, "error": null, "seconds": 0.366}, {"round": 2, "tool": "subjects_of", "args": {"predicate": "result_uses_sample", "object_set": "set_1"}, "rows": 110, "error": null, "seconds": 0.046}, {"round": 3, "tool": "papers_of", "args": {"entity_ids": ["hepkg:result:5a41a7c7c62ceaef4c046044", "hepkg:result:116cfef0a2431c2e58b354ad", "hepkg:result:755b77b523c64332ab0fea19", "hepkg:result:99f6575cff4954b41554a576", "hepkg:result:c56b160307f064d9155ebd77", "hepkg:result:c2a8c6c321f85ca4e9620c78", "hepkg:result:1724c3004deb2fe7c06e27d8", "hepkg:result:dbe00b660bc7b95a46e94404", "hepkg:result:c223e8afe1e53690005d65ee", "hepkg:result:3c55ab19d48206f55f056f4a", "hepkg:result:f5b1d9536f2db25c7969a697", "hepkg:result:6b87d4fa6369adc316efb3b5"]}, "rows": 12, "error": null, "seconds": 0.011}], "sets": {"set_1": ["hepkg:sample:background-ttbar", "hepkg:sample:background-zjets", "hepkg:sample:background_simulation_mc", "hepkg:sample:diboson", "hepkg:sample:dy-background-mc", "hepkg:sample:dy-mc", "hepkg:sample:gamma-j