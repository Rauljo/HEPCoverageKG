{"run_id": "20260817T144023-hepkg-49058", "qid": "gen-paper-c8279f43", "repeat": 0, "system": "hepkg", "config_hash": "7b9f084cc5fb", "git_sha": "91aeb1c-dirty", "question": "How many background-estimation methods does analysis 2309.14442 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2309.14442 uses 9 background-estimation methods, including a Barlow-Beeston-like treatment of MC statistical uncertainty, binned maximum likelihood fit for unfolding, chi-squared test converted to z score for prediction-data compatibility, inverse-Hessian covariance matrix for confidence intervals, lowess-based smoothing of systematic template variations, nuisance parameter profiling for systematic uncertainty estimation, Poisson likelihood with Gaussian-constrained nuisance parameters, and pseudo-experiment validation of frequentist coverage.", "answered": true, "papers": ["2001.06899", "2309.14442", "2408.03744", "2604.21670"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2309.14442"], "predicate": "result_uses_statistical_method"}, "rows": 8, "error": null, "seconds": 0.034, "redirected_from": "describe"}], "sets": {}, "entity_ids": ["hepkg:method:barlow_beeston_mc_stat", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2_z_score_compatibility_test", "hepkg:method:hessian_covariance_confidence_intervals", "hepkg:method:lowess_smoothing_systematics", "hepkg:method:nuisance_parameter_profiling", "hepkg:method:poisson_likelihood", "hepkg:method:pseudo_experiment_coverage_validation"], "evidence_ids": ["hepkg:evidence:0ccb429071bed7eda100853e", "hepkg:evidence:aae59860b5b6ef1f6c0ffd08", "hepkg:evidence:ab0d80cc1154a182f54b7030", "hepkg:evidence:f894569140c80d177a626d65", "hepkg:evidence:ffc515fc23a1e63d3fa0d80e"], "seen_values": ["2309.14442", "barlow-beeston-like", "binned", "chi-squared", "compatibility", "confidence", "converted", "covariance", "coverage", "estimatio