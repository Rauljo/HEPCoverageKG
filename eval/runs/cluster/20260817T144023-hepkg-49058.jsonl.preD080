{"run_id": "20260817T144023-hepkg-49058", "qid": "gen-paper-e588a3a8", "repeat": 0, "system": "hepkg", "config_hash": "7b9f084cc5fb", "git_sha": "91aeb1c-dirty", "question": "Which statistical methods does analysis 2602.18611 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2602.18611 uses the following statistical methods:\n\n- Asimov data set method for expected results\n- Asymptotic approximation for 68%/95% CL intervals (q<1, q<3.84; q<2.30, q<5.99 for 2D)\n- Barlow-Beeston lite approach for MC statistical uncertainties in simulated templates\n- CMS Combine statistical analysis tool (RooFit/RooStats)\n- Correlation matrix extraction from second derivatives of q(alpha) around best fit\n- Maximum likelihood fits to extract SMEFT Wilson coefficient constraints\n- Moment matching procedure to determine simplified-likelihood parameters (dimidated Gaussian)\n- Principal component analysis (PCA) of Hessian matrix to derive constrained SMEFT eigenvector directions\n- Profile likelihood ratio test statistic q(alpha)\n- SM compatibility p-value from chi-square distribution of q(alpha_SM)\n- Simplified likelihood procedure (Gaussian/dimidated-Gaussian approximation) for SMEFT constraints", "answered": true, "papers": ["2602.18611"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2602.18611"], "predicate": "result_uses_statistical_method"}, "rows": 11, "error": null, "seconds": 0.034}], "sets": {}, "entity_ids": ["hepkg:method:barlow_beeston_lite", "hepkg:statistical_method:asimov_dataset_method", "hepkg:statistical_method:asymptotic_approximation_cl_intervals", "hepkg:statistical_method:combine_roofit_roostats_tool", "hepkg:statistical_method:hessian_correlation_extraction", "hepkg:statistical_method:maximum_likelihood_fit_smeft", "hepkg:statistical_method:moment_matching_procedure", "hepkg:statistical_method:pca_hessian_smeft", "hepkg:statistical_method:profile_likelihood_ratio_test_statistic", "hepkg:statistical_method:simplified_likelihood_procedure", "hepkg:statistical_method:sm_compatibility_pvalue"], "evidence_ids": ["hepkg:evidence:0991129494c227759ba613c8", "hepkg:evidence:27ae94fc7c16fc9385a27c50", "hepkg:evidence:2865d13800143e68107c7de4", "hepkg:evidence:5281bde2c76a4d07d7e3e116", "hepkg:evidence:68da6d6f01610bcc4d79d21c", "hepkg:evidence:8320527288c25fd4c663533f", "hepkg:evidence:a78ed551d48a0e3e5a65834d", "hepkg:evidence:f1e5d084946e132c1483a200", "hepkg:evidence:f6bd443234f00466c1c5eb75", "hepkg:evidence:fe1a8cc65b2c41e95f7a80c7"], "seen_values": ["1", "2", "2.3", "2.30", "2602.18611", "3.84", "5.99", "68", "95", "alpha", "alpha_sm", "analysis", "approach", "approximation", "around", "asimov", "asymptotic", "background_method", "barlow-beeston", "best", "chi-square", "cms", "coefficient", "combine", "compatibility", "component", "constrained", "constraints", "correlation", "data", "derivatives", "derive", "determine", "dimidated", "dimidated-gaussian", "directions", "distribution", "eigenvector", "expected", "extract", "extraction", "fit", "fits", "for", "from", "gaussian", "hepkg:method:barlow_beeston_lite", "hepkg:statistical_method:asimov_dataset_method", "hepkg:statistical_method:asymptotic_approximation_cl_intervals", "hepkg:statistical_method:combine_roofit_roostats_tool", "hepkg:statistical_method:hessian_correlation_extraction", "hepkg:statistical_method:maximum_likelihood_fit_smeft", "hepkg:statistical_method:moment_matching_procedure", "hepkg:statistical_method:pca_hessian_smeft", "hepkg:statistical_method:profile_likelihood_ratio_test_statistic", "hepkg:statistical_method:simplified_likelihood_procedure", "hepkg:statistical_method:sm_compatibility_pvalue", "hessian", "intervals", "likelihood", "lite", "matching", "matrix", "maximum", "method", "moment", "p-value", "parameters", "pca", "principal", "procedure", "profile", "ratio", "result_uses_statistical_method", "results", "roofit", "roostats", "second", "set",