{"run_id": "20260817T144023-hepkg-49058", "qid": "gen-paper-7cb29dd5", "repeat": 1, "system": "hepkg", "config_hash": "7b9f084cc5fb", "git_sha": "91aeb1c-dirty", "question": "Which statistical methods does analysis 2402.08486 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2402.08486 uses the following statistical methods:\n\n- Binned template fit to m(ll) distribution using TFractionFitter (ROOT)\n- Chi-squared test statistic (with covariance matrix including bin-to-bin correlations) for data-to-theory comparison\n- Pseudo-data closure and coverage test of unfolding procedure\n- TUnfold chi2-fit unfolding with Tikhonov regularization\n\nThese methods are recorded in the graph for this analysis.", "answered": true, "papers": ["2402.08486"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2402.08486"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.032}], "sets": {}, "entity_ids": ["hepkg:statmethod:binned_template_fit_tfractionfitter", "hepkg:statmethod:chi2_data_theory_comparison", "hepkg:statmethod:pseudodata_closure_test", "hepkg:statmethod:tunfold_regularized_unfolding"], "evidence_ids": ["hepkg:evidence:3f109ed7a8aac1e8b04ea168", "hepkg:evidence:7a073fb8e5593dc59dd5b31f", "hepkg:evidence:856edb6c1ff9da082ae4f46a", "hepkg:evidence:ab1b3a4124b03aaf3ca15621", "hepkg:evidence:dd7884515c9d5710b2bd8d42", "hepkg:evidence:ff1291b75c0afd152814c5b3"], "seen_values": ["2402.08486", "and", "bin-to-bin", "binned", "chi-squared", "chi2-fit", "closure", "comparison", "correlations", "covariance", "coverage", "data-to-theory", "distribution", "fit", "for", "hepkg:statmethod:binned_template_fit_tfractionfitter", "hepkg:statmethod:chi2_data_theory_comparison", "hepkg:statmethod:pseudodata_closure_test", "hepkg:statmethod:tunfold_regularized_unfolding", "incl", "matrix", "procedure", "pseudo-data", "regularization", "result_uses_statistical_meth