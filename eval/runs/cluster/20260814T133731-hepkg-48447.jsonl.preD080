{"run_id": "20260814T133731-hepkg-48447", "qid": "gen-paper-b3d73360", "repeat": 0, "system": "hepkg", "config_hash": "9f0ca51b332d", "git_sha": "feb9060-dirty", "question": "How many statistical methods does analysis 2302.05225 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2302.05225 uses five statistical methods:\n\n- $\\chi^2$ compatibility test between measured and predicted differential cross-sections\n- Binned likelihood function of Poisson probability terms with Gaussian/log-normal nuisance-parameter constraints\n- Bootstrap methodology for correlation coefficient estimation\n- CLs method for upper-limit setting\n- Profile likelihood ratio test statistic\n\nThese methods are recorded in the graph as being used by this analysis.", "answered": true, "papers": ["2103.04956", "2302.05225", "2303.15340"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2302.05225"], "predicate": "result_uses_statistical_method"}, "rows": 5, "error": null, "seconds": 0.031, "redirected_from": "describe"}], "sets": {}, "entity_ids": ["hepkg:method:bootstrap_correlation", "hepkg:method:chi2_compatibility_test", "hepkg:method:cls_method", "hepkg:method:likelihood_function_poisson", "hepkg:method:profile_likelihood_ratio_test_statistic"], "evidence_ids": ["hepkg:evidence:0da9818a2617efd2cb9acf6b", "hepkg:evidence:20200ea00c636a6881d883bf", "hepkg:evidence:370be53c77612b86aa165eb4", "hepkg:evidence:7a493b431d81bfb930e40062", "hepkg:evidence:bb07e9aa09b6d94b43345ea7"], "seen_values": ["2", "2302.05225", "and", "between", "binned", "bootstrap", "chi", "cls", "coefficient", "compatibility", "constraints", "correlation", "cross-sections", "differential", "estimation", "for", "function", "gaussian", "hepkg:method:bootstrap_correlation", "hepkg:method:chi2_compatibility_test", "hepkg:method:cls_method", "hepkg:method:likelihood_function_poisson", "hepkg:method:profile_likelihood_ratio_test_sta