{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-c8279f43", "repeat": 1, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "How many background-estimation methods does analysis 2309.14442 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2309.14442 uses 9 background-estimation methods, including:\n1. Barlow-Beeston-like treatment of MC statistical uncertainty\n2. Binned maximum likelihood fit for unfolding\n3. Chi-squared test converted to z score for prediction-data compatibility\n4. Inverse-Hessian covariance matrix for confidence intervals\n5. Lowess-based smoothing of systematic template variations\n6. Nuisance parameter profiling for systematic uncertainty estimation\n7. Poisson likelihood with Gaussian-constrained nuisance parameters\n8. Pseudo-experiment validation of frequentist coverage", "answered": true, "papers": ["2001.06899", "2309.14442", "2408.03744", "2604.21670"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2309.14442"], "predicate": "result_uses_statistical_method"}, "rows": 8, "error": null, "seconds": 0.034, "redirected_from": "describe"}], "sets": {}, "entity_ids": ["hepkg:method:barlow_beeston_mc_stat", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2_z_score_compatibility_test", "hepkg:method:hessian_covariance_confidence_intervals", "hepkg:method:lowess_smoothing_systematics", "hepkg:method:nuisance_parameter_profiling", "hepkg:method:poisson_likelihood", "hepkg:method:pseudo_experiment_coverage_validation"], "evidence_ids": ["hepkg:evidence:0ccb429071bed7eda100853e", "hepkg:evidence:aae59860b5b6ef1f6c0ffd08", "hepkg:evidence:ab0d80cc1154a182f54b7030", "hepkg:evidence:f894569140c80d177a626d65", "hepkg:evidence:ffc515fc23a1e63d3fa0d80e"], "seen_values": ["2309.14442", "barlow-beeston-like", "binned", "chi-squared", "compatibility", "confidence", "converted", "covariance", "coverage", "estimation", "fit", "for", "frequentist", "gaussian-constrained", "hepkg:method:barlow_beeston_mc_stat", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2_z_score_compatibility_test", "hepkg:method:hessian_covariance_confidence_intervals", "hepkg:method:lowess_smoothing_systematics", "hepkg:method:nuisance_parameter_profiling", "hepkg:method:poisson_likelihood", "hepkg:method:pseudo_experiment_coverage_validation", "intervals", "inverse-hessian", "likelihood", "lowess-based", "matrix", "maximum", "nuisance", "parameter", "parameters", "poisson", "prediction-data", "profiling", "pseudo-experiment", "result_uses_statistical_method", "score", "smoothing", "statistical", "statistical_method", "systematic", "template", "test", "treatment", "uncertainty", "unfolding", "validation", "variations", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 9531, "completion_tokens": 330, "rounds": 2, "seconds": 11.868108481168747, "reviews": [], "recovered_calls": 0, "cited": "", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged": false, "error": ""}, "scores": {"seconds": 11.868108481168747, "llm_calls": 2.0, "tokens": 9861.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "count_correct": 1.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 8.0, "evidence_quotes": 5.0}}
{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-ca8052a9", "repeat": 1, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "Which systematic uncertainties does analysis 2001.06899 report?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The analysis 2001.06899 reports the following systematic uncertainties:\n\n- Background (ttbar, single top, diboson) normalization uncertainty\n- Gluon splitting rate uncertainty\n- Heavy-flavor tagging efficiency scale factor uncertainty\n- Jet energy scale and resolution (JES/JER) correction uncertainty\n- Missing transverse momentum (p_T^miss) selection efficiency uncertainty\n- PDF and mu_R, mu_F scale uncertainty (unfolding correction)\n- Parton shower and hadronization modeling uncertainty (Pythia vs Herwig++)\n- Pileup weighting uncertainty\n- Statistical uncertainty of MC M_SV template shapes\n- b jet M_SV template shape correction uncertainty", "answered": true, "papers": ["2001.06899"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2001.06899"], "predicate": "result_has_systematic"}, "rows": 10, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:systematic:b_jet_msv_shape_correction", "hepkg:systematic:background_rate_normalization", "hepkg:systematic:gluon_splitting", "hepkg:systematic:hf_tagging_efficiency", "hepkg:systematic:jes_jer", "hepkg:systematic:met_selection_efficiency", "hepkg:systematic:parton_shower_hadronization_model", "hepkg:systematic:pdf_scale_variation", "hepkg:systematic:pileup_weighting", "hepkg:systematic:template_statistics"], "evidence_ids": ["hepkg:evidence:22aacafa72d5703fc1473cb9", "hepkg:evidence:2b37e3d54d1e432523f49a1d", "hepkg:evidence:3168359c1d904c1caa11bb86", "hepkg:evidence:68cc9f43715596f759dca513", "hepkg:evidence:6a720291b1e6fc13a52b39b5", "hepkg:evidence:aeb55882de1e91893ab35bb3", "hepkg:evidence:b7e63f59da9abb79e95f5a40", "hepkg:ev