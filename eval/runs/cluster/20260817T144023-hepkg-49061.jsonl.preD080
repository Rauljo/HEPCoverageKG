{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-1f804225", "repeat": 0, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "Which backgrounds does analysis 2206.09466 estimate?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2206.09466 estimates the following backgrounds:\n\n- Drell-Yan background\n- Nonprompt lepton (reducible) background from Z+jets and ttbar\n- Nonresonant WW background\n- Top quark (ttbar + single top) background\n- Triboson background\n- WZ / Vgamma / Vgamma* multiboson background\n- ZZ irreducible background\n\nThis list is based on the information recorded in the graph for this analysis.", "answered": true, "papers": ["2107.12553", "2110.11231", "2202.08676", "2206.09466", "2404.06204", "2503.19420"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2206.09466"], "predicate": "result_estimates_background"}, "rows": 7, "error": null, "seconds": 0.032}], "sets": {}, "entity_ids": ["hepkg:background:drell-yan", "hepkg:background:nonprompt-lepton", "hepkg:background:top-quark", "hepkg:background:triboson", "hepkg:background:ww-nonresonant", "hepkg:background:wz-vgamma-multiboson", "hepkg:background:zz"], "evidence_ids": ["hepkg:evidence:03c87d37d632246ab7ce857e", "hepkg:evidence:08fa9b2020db3a7c2a1e4743", "hepkg:evidence:1bf1d5f6172e86d2dea2cb7f", "hepkg:evidence:699c3e0c66801eda96b481c2", "hepkg:evidence:9da3cfd7f9beddcd2a20b1f6", "hepkg:evidence:e37c51884ba4fdd17d4f8ba2", "hepkg:evidence:f74b638e3e4f6573b5563970"], "seen_values": ["2206.09466", "and", "background", "drell-yan", "from", "hepkg:background:drell-yan", "hepkg:background:nonprompt-lepton", "hepkg:background:top-quark", "hepkg:background:triboson", "hepkg:background:ww-nonresonant", "hepkg:background:wz-vgamma-multiboson", "hepkg:background:zz", "irreducible", "jets", "lepton", "multiboson", "nonprompt", "nonresonant", "quark", "reducible", "