{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-83f6668f", "repeat": 1, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "Which background-estimation methods does analysis 2106.14246 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2106.14246 uses the following background-estimation methods:\n\n- Asymptotic approximation of the profile likelihood ratio test statistic\n- Barlow-Beeston approach for MC statistical uncertainties in the likelihood\n- CLs criterion for 95% CL upper limits\n- Log-normal nuisance parameters for normalization-only systematic uncertainties\n- Template morphing technique for shape+normalization nuisance parameters (Gaussian pdf)\n\nThese methods are used in the statistical analysis of the results.", "answered": true, "papers": ["2106.14246", "2510.07527"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2106.14246"], "predicate": "result_uses_statistical_method"}, "rows": 5, "error": null, "seconds": 0.031}], "sets": {}, "entity_ids": ["hepkg:statmethod:asymptotic_profile_likelihood", "hepkg:statmethod:barlow_beeston", "hepkg:statmethod:cls_criterion", "hepkg:statmethod:lognormal_nuisance", "hepkg:statmethod:template_morphing"], "evidence_ids": ["hepkg:evidence:6cb6e501c0233a7d7466aed0", "hepkg:evidence:ce5b517539566c8ea450aa29", "hepkg:evidence:ddfc2b4b0ba3ba821aaf102a"], "seen_values": ["2106.14246", "95", "approach", "approximation", "asymptotic", "barlow-beeston", "cls", "criterion", "for", "gaussian", "hepkg:statmethod:asymptotic_profile_likelihood", "hepkg:statmethod:barlow_beeston", "hepkg:statmethod:cls_criterion", "hepkg:statmethod:lognormal_nuisance", "hepkg:statmethod:template_morphing", "likelihood", "limits", "log-normal", "morphing", "normalization", "normalization-only", "nuisance", "parameters", "pdf", "profile", "ratio", "result_uses_statistical_method", "shape", "statistic", "st