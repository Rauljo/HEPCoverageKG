{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-3db63969", "repeat": 0, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "How many detector objects does analysis 2111.08340 define?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2111.08340 defines 11 detector objects, including anti-tagged candidate jets, candidate jets (H→bb̄ candidate large-R jets), double-tagged candidate jets, H-jets, J_b jets, J_t jets, large-radius (R=1.0) jets, muons, and track-jets.", "answered": true, "papers": ["2001.06899", "2004.01678", "2007.02873", "2009.04363", "2009.14537", "2012.03799", "2012.08600", "2102.01444", "2103.04956", "2103.06956", "2106.01676", "2106.14246", "2109.13808", "2110.11231", "2111.08340", "2112.03161", "2201.11585", "2202.08676", "2205.05120", "2206.09466", "2207.00348", "2208.12095", "2209.07327", "2211.08028", "2302.05225", "2304.08962", "2307.01094", "2308.02285", "2401.05299", "2403.01556", "2404.06204", "2405.18661", "2407.10549", "2408.03744", "2503.19420", "2504.13081", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2604.21670", "2604.27044"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2111.08340"], "predicate": "result_defines_object"}, "rows": 9, "error": null, "seconds": 0.033}], "sets": {}, "entity_ids": ["hepkg:object:H-jet", "hepkg:object:Jb-jet", "hepkg:object:Jt-jet", "hepkg:object:anti-tagged-candidate-jet", "hepkg:object:candidate-jet", "hepkg:object:double-tagged-candidate-jet", "hepkg:object:large-R-jet", "hepkg:object:muon", "hepkg:object:track-jet"], "evidence_ids": ["hepkg:evidence:0aea7ea3ff57a28044b7412a", "hepkg:evidence:291043d321e54757f68c97c0", "hepkg:evidence:379d32e35ec117a83d49f6bf", "hepkg:evidence:3f23a399a8f3bf3367d0583e", "hepkg:evidence:bb13f67109119a06c7f81a36", "hepkg:evidence:beaf7254f7015760be76f953", "hepkg:evidence:d52131487f0d47e719a09c7e"], "seen_values": [