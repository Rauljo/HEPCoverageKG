{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-cd49e95d", "repeat": 2, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "Which statistical methods does analysis 2208.12095 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2208.12095 uses the following statistical methods:\n\n- $\\chi^{2}$ minimisation for Wilson-coefficient limits\n- Asimov dataset pseudo-experiments (500 smeared response matrices)\n- Bootstrap method for MC statistical uncertainty estimation\n- Extended Markov-chain Monte Carlo likelihood sampling\n- Fully Bayesian Unfolding (FBU)\n\nThese methods are recorded in the graph as used in this analysis.", "answered": true, "papers": ["2208.12095"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2208.12095"], "predicate": "result_uses_statistical_method"}, "rows": 5, "error": null, "seconds": 0.033}], "sets": {}, "entity_ids": ["hepkg:method:asimov_pseudoexperiments", "hepkg:method:bootstrap_mc_stat", "hepkg:method:chi2_minimisation", "hepkg:method:fully_bayesian_unfolding", "hepkg:method:mcmc_sampling"], "evidence_ids": ["hepkg:evidence:2230b374e3fe95672fe68509", "hepkg:evidence:5210580b71fc107ad4d49832", "hepkg:evidence:82e9f886918fc8963ac3ebcd", "hepkg:evidence:95fe45d96477f9c98a148539"], "seen_values": ["2", "2208.12095", "5", "500", "asimov", "bayesian", "bootstrap", "carlo", "chi", "dataset", "estimation", "extended", "fbu", "for", "fully", "hepkg:method:asimov_pseudoexperiments", "hepkg:method:bootstrap_mc_stat", "hepkg:method:chi2_minimisation", "hepkg:method:fully_bayesian_unfolding", "hepkg:method:mcmc_sampling", "likelihood", "limits", "markov-chain", "matrices", "method", "minimisation", "monte", "pseudo-experiments", "response", "result_uses_statistical_method", "sampling", "smeared", "statistical", "statistical_method", "uncertainty", "unfolding", "wilson-coefficient"], "verification_score