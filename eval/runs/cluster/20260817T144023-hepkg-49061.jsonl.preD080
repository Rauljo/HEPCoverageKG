{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-d5e9ba08", "repeat": 2, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "Which systematic uncertainties does analysis 2012.01581 report?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The analysis 2012.01581 reports the following systematic uncertainties:\n\n- Background prediction systematic uncertainty (largest deviation of ABCD cross-checks from nominal ratio)\n- GBDT score modeling (data/MC mismodeling) uncertainty on signal yields\n- Integrated luminosity uncertainty\n- Jet energy scale (JES) uncertainty (7 independent sources)\n- Online H_T trigger requirement uncertainty on signal yields\n- Online jet p_T trigger requirement uncertainty on signal yields\n- Online tracking requirement uncertainty on signal yields\n- PDF modelling uncertainty (CT14, MMHT2014 vs NNPDF3.0 replicas)\n- Pile-up reweighting modelling uncertainty\n- Primary vertex selection uncertainty on signal yields\n- Track impact parameter modeling uncertainty on signal yields\n\nThese uncertainties are documented in the paper with the arXiv ID 2012.01581.", "answered": true, "papers": ["2004.14060", "2012.01581", "2103.04956", "2103.06956", "2106.14246", "2109.13808", "2112.00895", "2112.03161", "2208.12095", "2309.14442", "2402.08486", "2408.03744", "2509.22535", "2602.18611", "2605.14245"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2012.01581"], "predicate": "result_has_systematic"}, "rows": 11, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:systematic:background_prediction", "hepkg:systematic:gbdt_score_modeling", "hepkg:systematic:integrated_luminosity", "hepkg:systematic:jet_energy_scale", "hepkg:systematic:online_ht_requirement", "hepkg:systematic:online_jet_pt_requirement", "hepkg:systematic:online_tracking_requirement", "hepkg:systematic:pdf_uncertainty", "hepkg:systematic:pileup_modeling", "hepkg:systematic:primary_vertex_selection", "hepkg:systematic:track_impact_parameter_modeling"], "evidence_ids": ["hepkg:evidence:2d9fd3aaffbd7c4bdc3241a8", "hepkg:evidence:38d1d2fae6610ff9c827296d", "hepkg:evidence:86e9995634f457b0825db2ed", "hepkg:evidence:92cea6d4c1a87c13cac71e65", "hepkg:evidence:9ae535ff6b6d29c697156982", "hepkg:evidence:a06d383fe3b020f7784ed0f4", "hepkg:evidence:a8b0834eac55a512d44c0f49", "hepkg:evidence:b053c2c48b5aac76a3216240", "hepkg:evidence:c279ebcc8a3e9eded07991e7", "hepkg:evidence:e6534595f238047876f9d65e", "hepkg:evidence:f5d621b08c3fe89cd0900610"], "seen_values": ["0", "2012.01581", "7", "abcd", "background", "cross-checks", "ct14", "data", "deviation", "energy", "from", "gbdt", "h_t", "hepkg:systematic:background_prediction", "hepkg:systematic:gbdt_score_modeling", "hepkg:systematic:integrated_luminosity", "hepkg:systematic:jet_energy_scale", "hepkg:systematic:online_ht_requirement", "hepkg:systematic:online_jet_pt_requirement", "hepkg:systematic:online_tracking_requirement", "hepkg:systematic:pdf_uncertainty", "hepkg:systematic:pileup_modeling", "hepkg:systematic:primary_vertex_selection", "hepkg:systematic:track_impact_parameter_modeling", "impact", "independent", "integrated", "jes", "jet", "largest", "luminosity", "mismodeling", "mmht2014", "modeling", "modelling", "nnpdf3", "nominal", "online", "p_t", "parameter", "pdf", "pile-up", "prediction", "primary", "ratio", "replicas", "requirement", "result_has_systematic", "reweighting", "scale", "score", "selection", "signal", "sources", "systematic", "systematic_uncertainty", "track", "tracking", "trigger", "uncertainty", "vertex", "yields"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 9665, "completion_tokens": 445, "rounds": 2, "seconds": 16.407233418896794, "reviews": [], "recovered_calls": 0, "cited": "", "abstention_challenged": false, "citation_corrected": false, "citation_disagrees": [], "invented_ids": [], "nudged":