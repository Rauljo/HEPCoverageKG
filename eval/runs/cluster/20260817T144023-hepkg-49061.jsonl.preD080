{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-c8279f43", "repeat": 0, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "How many background-estimation methods does analysis 2309.14442 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2309.14442 uses 9 background-estimation methods, including:\n1. Barlow-Beeston-like treatment of MC statistical uncertainty\n2. Binned maximum likelihood fit for unfolding\n3. Chi-squared test converted to z score for prediction-data compatibility\n4. Inverse-Hessian covariance matrix for confidence intervals\n5. Lowess-based smoothing of systematic template variations\n6. Nuisance parameter profiling for systematic uncertainty estimation\n7. Poisson likelihood with Gaussian-constrained nuisance parameters\n8. Pseudo-experiment validation of frequentist coverage", "answered": true, "papers": ["2001.06899", "2309.14442", "2408.03744", "2604.21670"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2309.14442"], "predicate": "result_uses_statistical_method"}, "rows": 8, "error": null, "seconds": 0.034, "redirected_from": "describe"}], "sets": {}, "entity_ids": ["hepkg:method:barlow_beeston_mc_stat", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2_z_score_compatibility_test", "hepkg:method:hessian_covariance_confidence_intervals", "hepkg:method:lowess_smoothing_systematics", "hepkg:method:nuisance_parameter_profiling", "hepkg:method:poisson_likelihood", "hepkg:method:pseudo_experiment_coverage_validation"], "evidence_ids": ["hepkg:evidence:0ccb429071bed7eda100853e", "hepkg:evidence:aae59860b5b6ef1f6c0ffd08", "hepkg:evidence:ab0d80cc1154a182f54b7030", "hepkg:evidence:f894569140c80d177a626d65", "hepkg:evidence:ffc515fc23a1e63d3fa0d80e"], "seen_values": ["2309.14442", "barlow-beeston-like", "binned", "chi-squared", "compatibility", "confidence", "converted", "covariance", "co