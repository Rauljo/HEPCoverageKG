{"run_id": "20260817T144023-hepkg-49061", "qid": "gen-paper-41d31e47", "repeat": 2, "system": "hepkg", "config_hash": "88358778a0b0", "git_sha": "91aeb1c-dirty", "question": "Which observables does analysis 2307.01094 measure?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2307.01094 measures the following observables:\n\n- Gluino mass exclusion limit\n- Model-independent 95% CL upper limits on visible BSM cross section and signal event yield ($\\sigma_{\\text{vis}}$, $S_{\\mathrm{obs}}^{95}$, $S_{\\mathrm{exp}}^{95}$) per signal region\n- Neutralino ($\\tilde{\\chi}_1^0$) mass exclusion limit\n- Observed and background-only-fit expected event yields in signal regions\n- Significance of deviation between observed and background-expected yields per signal region\n- Squark mass exclusion limit\n- Top squark ($\\tilde{t}$) mass exclusion limit\n\nThese details are directly from the paper.", "answered": true, "papers": ["2010.14293", "2307.01094", "2403.01556"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2307.01094"], "predicate": "result_measures_observable"}, "rows": 7, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:observable:gluino-mass", "hepkg:observable:model-independent-upper-limit", "hepkg:observable:neutralino-mass", "hepkg:observable:squark-mass", "hepkg:observable:sr-event-yield", "hepkg:observable:sr-significance", "hepkg:observable:topsquark-mass"], "evidence_ids": ["hepkg:evidence:5dc339a0b1dc65b7722e14f9", "hepkg:evidence:78391dcfbefd0629f7958d2e", "hepkg:evidence:8ee64bce2a43d6ebef4d361b", "hepkg:evidence:d3b8c4d8455884d089e475e6", "hepkg:evidence:e8330d67ba5d1cf182ed29c1", "hepkg:evidence:f7f7f07ed58d95e2ad92227d"], "seen_values": ["0", "1", "2307.01094", "95", "and", "background-expected", "background-only-fit", "between", "bsm", "chi", "cross", "deviation", "event", "exclusion", "exp", "expected", "gluino", "hepkg:observable:gluin