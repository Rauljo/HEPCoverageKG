{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-eb3035ab", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which backgrounds does analysis 2112.00895 estimate?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2112.00895 estimates the following backgrounds:\n\n- Diboson (WW, WZ, ZZ) production background\n- Single top quark production background\n- W + heavy quark-antiquark pair background (W+cc-bar and W+bb-bar)\n- W + light-flavour (udsg) jets background\n- Z + jets background\n- ttbar production background\n\nThese backgrounds are estimated as part of the analysis.", "answered": true, "papers": ["2112.00895"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2112.00895"], "predicate": "result_estimates_background"}, "rows": 6, "error": null, "seconds": 0.039}], "sets": {}, "entity_ids": ["hepkg:process:diboson_bkg", "hepkg:process:single_top_bkg", "hepkg:process:ttbar_bkg", "hepkg:process:w_plus_qqbar", "hepkg:process:w_plus_udsg", "hepkg:process:z_plus_jets_bkg"], "evidence_ids": ["hepkg:evidence:2b64dd3a0e84ee4135ffd4cf", "hepkg:evidence:3ee606e99543c11f001fcc49", "hepkg:evidence:48550cf7c0e5dcda4428b09d", "hepkg:evidence:62b1bfa509bf19ab939789ab", "hepkg:evidence:69aa8f581cdc86bb79a54632", "hepkg:evidence:a91683abd0ea84ba9376f471", "hepkg:evidence:c56eb621c59c421a380afea4"], "seen_values": ["2112.00895", "and", "background", "bb-bar", "cc-bar", "diboson", "heavy", "hepkg:process:diboson_bkg", "hepkg:process:single_top_bkg", "hepkg:process:ttbar_bkg", "hepkg:process:w_plus_qqbar", "hepkg:process:w_plus_udsg", "hepkg:process:z_plus_jets_bkg", "jets", "light-flavour", "pair", "physics_process", "production", "quark", "quark-antiquark", "result_estimates_background", "single", "top", "ttbar", "udsg"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7239, "completion_tokens": 1