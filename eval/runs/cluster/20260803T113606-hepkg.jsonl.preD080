{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-d1ad0b52", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which generators does analysis 2009.14537 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2009.14537 uses the following generators:\n\n- Herwig 7\n- JETSET 7.408 hadronization/interface program\n- LPAIR 4.0 Monte Carlo generator", "answered": true, "papers": ["2004.04545", "2009.04363", "2009.14537", "2012.03799", "2207.00348", "2208.12095", "2309.14442", "2401.05299", "2404.06204", "2604.21670"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2009.14537"], "predicate": "sample_uses_generator"}, "rows": 3, "error": null, "seconds": 0.035}], "sets": {}, "entity_ids": ["hepkg:generator:herwig7", "hepkg:generator:jetset7.408", "hepkg:generator:lpair4.0"], "evidence_ids": ["hepkg:evidence:14c059828b26fbb5e478e15d", "hepkg:evidence:b7c6aeec1269b39246578302", "hepkg:evidence:d6cfdb4588f21cfc00e1438a"], "seen_values": ["0", "2009.14537", "4", "4.0", "408", "7", "7.408", "carlo", "generator", "hadronization", "hepkg:generator:herwig7", "hepkg:generator:jetset7", "hepkg:generator:lpair4", "herwig", "interface", "jetset", "lpair", "monte", "program", "sample_uses_generator"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7044, "completion_tokens": 258, "rounds": 2, "seconds": 11.046195324975997, "error": ""}, "scores": {"seconds": 11.046195324975997, "llm_calls": 2.0, "tokens": 7302.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "retrieved_label_recall": 1.0, "retrieved_entities": 3.0, "mentioned_label_recall": 1.0, "truncation_loss_labels": 0.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrie