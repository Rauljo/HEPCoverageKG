{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-9d9c05f4", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2309.14442 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2309.14442 uses the following background-estimation methods:\n\n- Barlow-Beeston-like treatment of MC statistical uncertainty\n- Binned maximum likelihood fit for unfolding\n- Chi-squared test converted to z score for prediction-data compatibility\n- Inverse-Hessian covariance matrix for confidence intervals\n- Lowess-based smoothing of systematic template variations\n- Nuisance parameter profiling for systematic uncertainty estimation\n- Poisson likelihood with Gaussian-constrained nuisance parameters\n- Pseudo-experiment validation of frequentist coverage\n\nThese methods are recorded in the graph as being used in this analysis.", "answered": true, "papers": ["2001.06899", "2309.14442", "2408.03744", "2604.21670"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2309.14442"], "predicate": "result_uses_statistical_method"}, "rows": 8, "error": null, "seconds": 0.032}], "sets": {}, "entity_ids": ["hepkg:method:barlow_beeston_mc_stat", "hepkg:method:binned_maximum_likelihood_fit", "hepkg:method:chi2_z_score_compatibility_test", "hepkg:method:hessian_covariance_confidence_intervals", "hepkg:method:lowess_smoothing_systematics", "hepkg:method:nuisance_parameter_profiling", "hepkg:method:poisson_likelihood", "hepkg:method:pseudo_experiment_coverage_validation"], "evidence_ids": ["hepkg:evidence:0ccb429071bed7eda100853e", "hepkg:evidence:aae59860b5b6ef1f6c0ffd08", "hepkg:evidence:ab0d80cc1154a182f54b7030", "hepkg:evidence:f894569140c80d177a626d65", "hepkg:evidence:ffc515fc23a1e63d3fa0d80e"], "seen_values": ["2309.14442", "barlow-beeston-like", "binned", "chi-squared", "compatibility", "confidence", "c