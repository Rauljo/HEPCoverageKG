{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-6c16e3bd", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2205.05120 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2205.05120 uses five statistical methods:\n\n- Asymptotic approximation for CL$_{s}$ computation in model-dependent fits\n- Barlow-Beeston method for limited simulation/control-region sample size\n- Binned maximum likelihood fit combining all categories, channels, and data-taking years\n- External constraints on nuisance parameters (log-normal for normalization, Gaussian for shape)\n- Pseudoexperiments used to evaluate look-elsewhere/fluctuation probability and significance", "answered": true, "papers": ["2205.05120", "2307.01094"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2205.05120"], "predicate": "result_uses_statistical_method"}, "rows": 5, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:statmethod:asymptotic-approximation", "hepkg:statmethod:barlow-beeston", "hepkg:statmethod:binned-maximum-likelihood-fit", "hepkg:statmethod:nuisance-external-constraints", "hepkg:statmethod:pseudoexperiments"], "evidence_ids": ["hepkg:evidence:1be49345b04d7a73097158e7", "hepkg:evidence:93a974fad25cf0afbc1357e9", "hepkg:evidence:b6ead49c11080941fc8a9506", "hepkg:evidence:cad606bc91e35873ce8efc22"], "seen_values": ["2205.0512", "2205.05120", "all", "and", "approximation", "asymptotic", "barlow-beeston", "binned", "categories", "channels", "combining", "computation", "constraints", "control-region", "data-taking", "evaluate", "external", "fit", "fits", "fluctuation", "for", "gaussian", "hepkg:statmethod:asymptotic-approximation", "hepkg:statmethod:barlow-beeston", "hepkg:statmethod:binned-maximum-likelihood-fit", "hepkg:statmethod:nuisance-external-constraints", "hepkg:statmethod:pseudoexpe