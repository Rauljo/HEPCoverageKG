{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-a7f77797", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which backgrounds does analysis 2106.14246 estimate?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2106.14246 estimates the following backgrounds:\n\n- Electron sign mismeasurement (charge misID) background\n- Multiboson background (WWW, WWZ, WZZ, ZZZ)\n- Nonprompt lepton background\n- Photon conversion background (Zg, Wg, ttg)\n- SM WZ production background\n- ZZ/H production background\n- tX background (single top / top + multiboson)\n- ttX background (tttt, ttH, ttW, ttZ)\n- ttXX background (two top quarks + two massive bosons)\n\nThis list is based on the information recorded in the graph.", "answered": true, "papers": ["2106.14246"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2106.14246"], "predicate": "result_estimates_background"}, "rows": 9, "error": null, "seconds": 0.038}], "sets": {}, "entity_ids": ["hepkg:background:charge_misid", "hepkg:background:multiboson_prompt", "hepkg:background:nonprompt_lepton", "hepkg:background:ttx_prompt", "hepkg:background:ttxx_prompt", "hepkg:background:tx_prompt", "hepkg:background:wz_prompt", "hepkg:background:xg_conversion", "hepkg:background:zz_h_prompt"], "evidence_ids": ["hepkg:evidence:1bddbb8f8e45ee073c27834e", "hepkg:evidence:30fdd54916f3d205a91f652c", "hepkg:evidence:3a54c1a4dfa134134ea3d647", "hepkg:evidence:43c926eec13862a8543b3caa", "hepkg:evidence:5a6e26d73035bd3a7435a568", "hepkg:evidence:82ca9e1716a49878cd6ffbd5", "hepkg:evidence:96bef078213dcae5d3817632", "hepkg:evidence:9f2af2733b4348262c1765dd", "hepkg:evidence:f04810e5fa1c59ab1fb1c402"], "seen_values": ["2106.14246", "background", "bosons", "charge", "conversion", "electron", "hepkg:background:charge_misid", "hepkg:background:multiboson_prompt", "hepkg:background:nonprompt_lepton", "hepkg: