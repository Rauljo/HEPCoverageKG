{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-ca96d52f", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2007.02873 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2007.02873 uses six statistical methods:\n\n1. Asymptotic formulae for significance calculation of background-only hypothesis rejection\n2. Beeston–Barlow technique for MC statistical uncertainty treatment\n3. Binned maximum-likelihood global fit (product of Poisson terms over bins, POIs and nuisance parameters)\n4. Bootstrap method for statistical compatibility testing between analyses\n5. Maximum-likelihood fits / profiled negative-log-likelihood for one-dimensional Wilson-coefficient confidence intervals\n6. Smoothing and pruning of systematic variations region-by-region\n\nThese methods are recorded in the graph for this analysis.", "answered": true, "papers": ["2007.02873"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2007.02873"], "predicate": "result_uses_statistical_method"}, "rows": 6, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:method:asymptotic_significance_formulae", "hepkg:method:beeston_barlow", "hepkg:method:bootstrap_compatibility", "hepkg:method:global_likelihood_fit", "hepkg:method:profile_likelihood_eft", "hepkg:method:systematic_smoothing_pruning"], "evidence_ids": ["hepkg:evidence:1221ebac96f2404df4272c70", "hepkg:evidence:41cb1b346a5344850f3ff5a4", "hepkg:evidence:51403597c0aa3b992fc87d37", "hepkg:evidence:58899763d4ef3b589ee7e01c", "hepkg:evidence:bd0627dca08aef9a728536ba", "hepkg:evidence:fb57cf64eebbee88c7830d9e"], "seen_values": ["2007.02873", "analyses", "and", "asymptotic", "background-only", "barlow", "beeston", "between", "binned", "bins", "bootstrap", "calculation", "compatibility", "confidence", "fit", "fits", "for", "formulae", "global", "h