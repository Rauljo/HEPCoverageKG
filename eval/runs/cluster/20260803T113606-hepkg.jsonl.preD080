{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-e891501b", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2103.04956 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2103.04956 uses the following background-estimation methods:\n\n- Asymptotic approach for confidence interval estimation\n- One-dimensional unbinned maximum likelihood fit to \\( m_{4\\ell} \\) for fiducial cross section extraction\n- Profile likelihood ratio test statistic\n- Two-dimensional unbinned maximum likelihood fit (m4l and kinematic discriminant D)\n\nThese methods are used to estimate backgrounds and perform statistical analyses in the paper.", "answered": true, "papers": ["2103.04956", "2302.05225"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2103.04956"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.035}], "sets": {}, "entity_ids": ["hepkg:method:1d_unbinned_ml_fit_fiducial", "hepkg:method:2d_unbinned_ml_fit", "hepkg:method:asymptotic_approach", "hepkg:method:profile_likelihood_ratio_test_statistic"], "evidence_ids": ["hepkg:evidence:3ac55c46e3ca50f13cc2c347", "hepkg:evidence:70a9ab660526a264edf8997c", "hepkg:evidence:f1d6e435bb2560559987a925", "hepkg:evidence:f56aa9c76496e1c758e1e1c6"], "seen_values": ["2103.04956", "and", "approach", "asymptotic", "confidence", "cross", "discriminant", "estimation", "extraction", "fiducial", "fit", "for", "hepkg:method:1d_unbinned_ml_fit_fiducial", "hepkg:method:2d_unbinned_ml_fit", "hepkg:method:asymptotic_approach", "hepkg:method:profile_likelihood_ratio_test_statistic", "interval", "kinematic", "likelihood", "m4l", "maximum", "one-dimensional", "profile", "ratio", "result_uses_statistical_method", "section", "statistic", "statistical_method", "test", "two-dimensional", "unbinned"], "verification_score