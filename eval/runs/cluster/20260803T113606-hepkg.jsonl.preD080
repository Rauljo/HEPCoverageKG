{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-dee5f2f6", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many distinct generators does analysis 2112.00895 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2112.00895 uses three distinct generators: MadGraph v5.1.3.30, POWHEG 2.0, and PYTHIA 6. This is supported by the following evidence:\n- MadGraph v5.1.3.30: \"The signal samples are generated using MadGraph5_aMC@NLO v5.1.3.30.\"\n- POWHEG 2.0: \"The tt̄+jets and single-top samples are produced using POWHEG 2.0.\"\n- PYTHIA 6: \"The parton shower and hadronization are performed using PYTHIA 6.\"\nTherefore, the answer is **3** distinct generators.", "answered": true, "papers": ["2009.04363", "2012.08600", "2103.06956", "2110.11231", "2112.00895", "2202.08676", "2404.06204", "2405.18661", "2408.03744", "2504.13081", "2506.13565", "2509.22535", "2511.11853", "2605.14245"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2112.00895"], "predicate": "sample_uses_generator"}, "rows": 3, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:generator:madgraph5", "hepkg:generator:powheg", "hepkg:generator:pythia6"], "evidence_ids": ["hepkg:evidence:0c18fa5b6d891694b3fd2d05", "hepkg:evidence:11f0657fed154aaecc867bda", "hepkg:evidence:2b64dd3a0e84ee4135ffd4cf", "hepkg:evidence:aa857b804200488920a510de"], "seen_values": ["2", "2.0", "2112.00895", "5.1.3.3", "5.1.3.30", "6", "generator", "hepkg:generator:madgraph5", "hepkg:generator:powheg", "hepkg:generator:pythia6", "madgraph", "powheg", "pythia", "sample_uses_generator"], "verification_score": 0.5, "unsupported_claims": ["1.3", "30"], "llm_calls": 2, "prompt_tokens": 7041, "completion_tokens": 390, "rounds": 2, "seconds": 16.07871933095157, "error": ""}, "scores": {"seconds": 16.07871933095157, "llm_calls": 2.0, "tokens": 7431.0, "rounds": 2.0,