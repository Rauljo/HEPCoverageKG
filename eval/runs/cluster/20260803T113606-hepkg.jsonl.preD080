{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-0e40973d", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which generators does analysis 2111.08340 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The analysis 2111.08340 uses the following generators:\n\n- GoSam\n- Hj-MiNLO prescription\n- MiNLO matching prescription\n- Powheg Box v2\n- Pythia 8.230\n- Sherpa 2.2.8\n\nThis information is directly extracted from the paper.", "answered": true, "papers": ["2004.01678", "2006.05880", "2010.14293", "2011.07812", "2012.03799", "2102.01444", "2111.08340", "2207.00348", "2211.08028", "2307.01094", "2312.04450", "2407.10549", "2503.19420"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2111.08340"], "predicate": "sample_uses_generator"}, "rows": 6, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:generator:gosam", "hepkg:generator:hj-minlo", "hepkg:generator:minlo", "hepkg:generator:powheg-box-v2", "hepkg:generator:pythia8.230", "hepkg:generator:sherpa-2.2.8"], "evidence_ids": ["hepkg:evidence:115445483da97d225634b60c", "hepkg:evidence:1b609a4cdb7843eb79a87ff9", "hepkg:evidence:2e8a9b23636f3872e74d7eb1", "hepkg:evidence:35162e7e0f86a7e8f6232297", "hepkg:evidence:760610d729114b94449230a5", "hepkg:evidence:fec859cc82b8b6b381d35ae9"], "seen_values": ["2", "2.2.8", "2.8", "2111.0834", "2111.08340", "23", "230", "8.23", "8.230", "box", "generator", "gosam", "hepkg:generator:gosam", "hepkg:generator:hj-minlo", "hepkg:generator:minlo", "hepkg:generator:powheg-box-v2", "hepkg:generator:pythia8", "hepkg:generator:sherpa-2", "hj-minlo", "matching", "minlo", "powheg", "prescription", "pythia", "sample_uses_generator", "sherpa"], "verification_score": 0.6666666666666667, "unsupported_claims": ["2.2"], "llm_calls": 2, "prompt_tokens": 7212, "completion_tokens": 116, "rounds": 2, "seconds": 5.904757607262582, "error":