{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-a83514e3", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which statistical methods does analysis 2009.14537 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2009.14537 uses the following statistical methods:\n\n1. **Asymptotic profile-likelihood method for significance evaluation** (statistical_method)\n2. **Background-only profile-likelihood fit normalization of mixed-data sample** (background_method)\n3. **Data-driven mixed-data sample method for combinatorial background estimation** (background_method)\n\nThese methods are used to evaluate the significance and estimate backgrounds in the analysis.", "answered": true, "papers": ["2009.14537"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2009.14537"], "predicate": "result_uses_statistical_method"}, "rows": 3, "error": null, "seconds": 0.034}], "sets": {}, "entity_ids": ["hepkg:method:asymptotic-profile-likelihood-significance", "hepkg:method:data-mixing-background-estimation", "hepkg:method:profile-likelihood-normalization"], "evidence_ids": ["hepkg:evidence:04b34b16de483d07bd8310f9", "hepkg:evidence:2f605c811b7d644ed4bbc876", "hepkg:evidence:944c780e973cd21f9c9dd79e"], "seen_values": ["2009.14537", "asymptotic", "background", "background-only", "background_method", "combinatorial", "data-driven", "estimation", "evaluation", "fit", "for", "hepkg:method:asymptotic-profile-likelihood-significance", "hepkg:method:data-mixing-background-estimation", "hepkg:method:profile-likelihood-normalization", "method", "mixed-data", "normalization", "profile-likelihood", "result_uses_statistical_method", "sample", "significance", "statistical_method"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7074, "completion_tokens": 135, "rounds": 2, "seconds": 6.279280705843121, "error":