 "2.2.4", "2.3.3", "2.4", "2.6", "2207.00348", "3.3", "6", "7", "8.2", "box", "generator", "hepkg:generator:herwig7", "hepkg:generator:madgraph5-amcatnlo-2", "hepkg:generator:powheg-box-v2", "hepkg:generator:pythia8", "hepkg:generator:sherpa2", "herwig", "madgraph5_amc", "nlo", "powheg", "pythia", "sample_uses_generator", "sherpa"], "verification_score": 0.6, "unsupported_claims": ["2.3", "2.2"], "llm_calls": 2, "prompt_tokens": 7244, "completion_tokens": 133, "rounds": 2, "seconds": 6.267687484622002, "error": ""}, "scores": {"seconds": 6.267687484622002, "llm_calls": 2.0, "tokens": 7377.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 0.6, "unsupported_claims": 2.0, "retrieved_label_recall": 1.0, "retrieved_entities": 6.0, "mentioned_label_recall": 1.0, "truncation_loss_labels": 0.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 6.0, "evidence_quotes": 16.0}}
{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-ddb2dbf2", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2202.08676 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "The analysis 2202.08676 uses the following statistical methods:\n\n1. Data-driven matrix method\n2. Gamma function modeling of statistical uncertainties in signal and background estimates\n3. Goodness-of-fit test based on the saturated model method\n4. Log-normal nuisance parameter modeling of systematic uncertainties in the likelihood\n5. Modified frequentist CLs approach with binned profile likelihood test statistic (asymptotic approximation)\n6. Simplified likelihood framework for reinterpretation of results\n\nTherefore, the analysis uses **6** statistical methods.\n\nHere is the evidence for each method:\n\n- Data-driven matrix method: \"The data-driven matrix method is used to estimate the background contribution.\"\n- Gamma function modeling of statistical uncertainties in signal and background estimates: \"Statistical uncertainties in the signal and background estimates are modeled using a gamma function.\"\n- Goodness-of-fit test based on the saturated model method: \"A goodness-of-fit test based on the saturated model method is performed.\"\n- Log-normal nuisance parameter modeling of systematic uncertainties in the likelihood: \"Systematic uncertainties are included in the likelihood as log-normal nuisance parameters.\"\n- Modified frequentist CLs approach with binned profile likelihood test statistic (asymptotic approximation): \"The modified frequentist CLs approach with a binned profile likelihood test statistic (asymptotic approximation) is used to set upper limits on the signal cross section.\"\n- Simplified likelihood framework for reinterpretation of results: \"A simplified likelihood framework is provided for the reinterpretation of the results.\"\n\nAnswered from the graph.", "answered": true, "papers": ["2106.01676", "2202.08676", "2209.07327", "2307.01094"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2202.08676"], "predicate": "result_uses_statistical_method"}, "rows": 6, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:method:cls-profile-likelihood", "hepkg:method:gamma-function-stat-uncertainty", "hepkg:method:goodness-of-fit-saturated-model", "hepkg:method:lognormal-nuisance-parameters", "hepkg:method:matrix-method", "hepkg:method:simplified-likelihood-reinterpretation"], "evidence_ids": ["hepkg:evidence:1082eff101f70931a38a51da", "hepkg:evidence:3bd01e9413f948f9359c6257", "hepkg:evidence:6026d72d040e78aa2cfb915f", "hepkg:evidence:787ec4395af1b651d0749ae6", "hepkg:evidence:97a73217bd6c32652227b368", "hepkg:evidence:a6c8eadca8ad1413e3ee6d3c"], "seen_values": ["2202.08676", "and", "approach", "approximation", "asymptotic", "background", "background_method", "based", "binned", "cls", "data-driven", "estimates", "for", "framework", "frequentist", "function", "gamma", "goodness-of-fit", "hepkg:method:cls-profile-likelihood", "hepkg:method:gamma-function-stat-uncertainty", "hepkg:method:goodness-of-fit-saturated-model", "hepkg:method:lognormal-nuisance-parameters", "hepkg:method:matrix-method", "hepkg:method:simplified-likelihood-reinterpretation", "likelihood", "log-normal", "matrix", "method", "model", "modeling", "modified", "nuisance", "parameter", "profile", "reinterpretation", "result_uses_statistical_method", "results", "saturated", "signal", "simplified", "statistic", "statistical", "statistical_method", "systematic", "test", "the", "uncertainties", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7275, "completion_tokens": 357, "rounds": 2, "seconds": 15.056432700250298, "error": ""}, "scores": {"seconds": 15.056432700250298, "llm_calls": 2.0, "tokens": 7632.0, "rounds": 2.