{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-3daca92e", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which statistical methods does analysis 2011.07812 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2011.07812 uses the following statistical methods:\n\n- **ABCD data-driven background estimation method**\n- **CLs prescription for 95% CL exclusion limits**\n- **Data-driven cosmic-ray background estimation using R_good ratio of cosmic-tagged muon quality**\n- **HistFitter package with Gaussian nuisance parameters for systematic uncertainties**\n\nThese methods are used to estimate backgrounds and set exclusion limits in the analysis.", "answered": true, "papers": ["2006.05880", "2010.14293", "2011.07812", "2106.01676", "2211.08028"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2011.07812"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:method:abcd-method", "hepkg:method:cls-prescription", "hepkg:method:histfitter", "hepkg:method:rgood-cosmic-method"], "evidence_ids": ["hepkg:evidence:0dc2ffdc86d9058c25db576a", "hepkg:evidence:1a6f5998c9aaec1cdd59cd19", "hepkg:evidence:4a05a35340158b2515909aaf", "hepkg:evidence:876b4eaaabd017c15766c97b"], "seen_values": ["2011.07812", "95", "abcd", "background", "background_method", "cls", "cosmic-ray", "cosmic-tagged", "data-driven", "estimation", "exclusion", "for", "gaussian", "hepkg:method:abcd-method", "hepkg:method:cls-prescription", "hepkg:method:histfitter", "hepkg:method:rgood-cosmic-method", "histfitter", "limits", "method", "muon", "nuisance", "package", "parameters", "prescription", "quality", "r_good", "ratio", "result_uses_statistical_method", "statistical_method", "systematic", "uncertainties", "using", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_c