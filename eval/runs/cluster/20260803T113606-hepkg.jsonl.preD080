{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-4d227ce9", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which statistical methods does analysis 2209.07327 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2209.07327 uses the following statistical methods:\n\n- Barlow-Beeston method for simulated-sample statistical uncertainties\n- Binned maximum likelihood fit for SUSY signal strength, background yields and nuisance parameters\n- CLs method for limit setting\n- Chi-square minimization of lepton pT distributions for nonprompt rate determination\n- Lognormal-distributed nuisance parameters for normalization-only systematic uncertainties\n- Profile likelihood test statistic in the asymptotic approximation\n- Saturated chi-square goodness-of-fit test\n- Template morphing with Gaussian probability distributions for shape systematics\n\nThese methods are documented in the paper with the arXiv ID 2209.07327.", "answered": true, "papers": ["2107.12553", "2209.07327", "2604.27044"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2209.07327"], "predicate": "result_uses_statistical_method"}, "rows": 8, "error": null, "seconds": 0.038}], "sets": {}, "entity_ids": ["hepkg:method:barlow-beeston", "hepkg:method:binned-ml-fit", "hepkg:method:chi2-minimization-nonprompt", "hepkg:method:cls", "hepkg:method:lognormal-nuisance", "hepkg:method:profile-likelihood-asymptotic", "hepkg:method:saturated-chi2-gof", "hepkg:method:template-morphing"], "evidence_ids": ["hepkg:evidence:46ae61373b5cc23fb820f62e", "hepkg:evidence:496ee2532d23d4dfaee8e2ff", "hepkg:evidence:565d4bb176b0c84d07f01e1f", "hepkg:evidence:57852945fec9725c9113eee6", "hepkg:evidence:66218aa2a52d0e5c0ec828dc", "hepkg:evidence:a4abb615ea03bd2038c75444", "hepkg:evidence:ba5404d92fe32e4627d852ed"], "seen_values": ["2209.07327", "and", "approximation", "asymptotic", "ba