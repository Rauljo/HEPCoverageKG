{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-d224ce94", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many background-estimation methods does analysis 2103.06956 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2103.06956 uses three background-estimation methods:\n\n1. Data-driven control sample (photon ID BDT sideband, reweighted) replacing simulated nonprompt-photon background.\n2. Data-driven gamma+jets modelling via inverted photon ID BDT requirement with randomized ID score reassignment.\n3. Discrete profiling method for background m_gg modelling.\n\nThese methods are recorded in the graph as used by this analysis.", "answered": true, "papers": ["2103.06956"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2103.06956"], "predicate": "background_uses_method"}, "rows": 3, "error": null, "seconds": 0.042}], "sets": {}, "entity_ids": ["hepkg:background_method:data_driven_gjets_randomized_id", "hepkg:background_method:data_driven_nonprompt_control_sample", "hepkg:background_method:discrete_profiling"], "evidence_ids": ["hepkg:evidence:0024e2074b31f371cfafa307", "hepkg:evidence:8be72f2efa1fb7c278b2e804", "hepkg:evidence:8f7083f1f14b9001dd5bdf69", "hepkg:evidence:d9c5dbe6398768979acb6f2a", "hepkg:evidence:ffa169f87610d80b8c943636"], "seen_values": ["2103.06956", "background", "background_method", "background_uses_method", "bdt", "control", "data-driven", "discrete", "for", "gamma", "hepkg:background_method:data_driven_gjets_randomized_id", "hepkg:background_method:data_driven_nonprompt_control_sample", "hepkg:background_method:discrete_profiling", "inverted", "jets", "m_gg", "method", "modelling", "nonprompt-photon", "photon", "profiling", "randomized", "reassignment", "replacing", "requirement", "reweighted", "sample", "score", "sideband", "simulated", "via", "with"], "verification_score": 1.0, "