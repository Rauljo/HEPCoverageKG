{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-4c0139a9", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which physics processes does analysis 2012.03799 target?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2012.03799 targets the following physics processes:\n\n- Direct stop pair production, \\( pp \\rightarrow \\tilde{t}_1 \\tilde{t}_1^* \\)\n- Four-body stop decay, \\( \\tilde{t}_1 \\rightarrow b f f' \\tilde{\\chi}_1^0 \\)\n- Three-body stop decay, \\( \\tilde{t}_1 \\rightarrow b W \\tilde{\\chi}_1^0 \\)\n- Two-body stop decay, \\( \\tilde{t}_1 \\rightarrow t + \\tilde{\\chi}_1^0 \\)\n- \\( pp \\rightarrow t \\bar{t} + \\) spin-0 mediator (\\( \\phi/a \\rightarrow \\chi \\bar{\\chi} \\))\n\nThese processes are detailed in the paper.", "answered": true, "papers": ["2012.03799", "2102.01444"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2012.03799"], "predicate": "result_targets_process"}, "rows": 5, "error": null, "seconds": 0.02}], "sets": {}, "entity_ids": ["hepkg:process:stop-decay-2body", "hepkg:process:stop-decay-3body", "hepkg:process:stop-decay-4body", "hepkg:process:stop-pair-production", "hepkg:process:ttbar-plus-mediator"], "evidence_ids": ["hepkg:evidence:0bb10e9422258c776430f16c", "hepkg:evidence:456eae81bd2f10544b46c954", "hepkg:evidence:74acb271af5d8432cb03e9f8", "hepkg:evidence:8d8bcafa07c0bf03f3428ebf", "hepkg:evidence:9d65dce1ab7bb96a52e46e5b"], "seen_values": ["0", "1", "2012.03799", "decay", "direct", "four-body", "hepkg:process:stop-decay-2body", "hepkg:process:stop-decay-3body", "hepkg:process:stop-decay-4body", "hepkg:process:stop-pair-production", "hepkg:process:ttbar-plus-mediator", "mediator", "pair", "physics_process", "production", "result_targets_process", "spin-0", "stop", "tbar", "three-body", "two-body"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls":