{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-9817079c", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many background-estimation methods does analysis 2112.00895 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2112.00895 uses six background-estimation methods:\n\n1. Convino maximum-likelihood combination of measurements\n2. Data-driven tag-and-probe method for reconstruction efficiency\n3. Global chi-squared minimization for PDF parameter determination\n4. HERAPDF general approach for experimental PDF uncertainty propagation\n5. MC replica method cross-check for PDF uncertainty estimation\n6. OS-SS (opposite-sign minus same-sign) subtraction technique", "answered": true, "papers": ["2112.00895", "2207.12246", "2401.07090", "2408.03744"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2112.00895"], "predicate": "result_uses_statistical_method"}, "rows": 6, "error": null, "seconds": 0.041}], "sets": {}, "entity_ids": ["hepkg:method:convino_combination", "hepkg:method:global_chi2_pdf_fit", "hepkg:method:herapdf_uncertainty_approach", "hepkg:method:mc_replica_uncertainty_crosscheck", "hepkg:method:os_ss_subtraction", "hepkg:method:tag_and_probe"], "evidence_ids": ["hepkg:evidence:5859e45f8cec6fbce81f3659", "hepkg:evidence:5d5915eb088082dcccb782df", "hepkg:evidence:8b656790510b4c8779ae14de", "hepkg:evidence:cda993edb2d81b6e65fe0ac2", "hepkg:evidence:cec4d3a4742b7465e8124623"], "seen_values": ["2112.00895", "approach", "background_method", "chi-squared", "combination", "convino", "cross-check", "data-driven", "determination", "efficiency", "estimation", "experimental", "for", "general", "global", "hepkg:method:convino_combination", "hepkg:method:global_chi2_pdf_fit", "hepkg:method:herapdf_uncertainty_approach", "hepkg:method:mc_replica_uncertainty_crosscheck", "hepkg:method:os_ss_subtraction", "hepkg:m