{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-7d9ba57b", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which physics processes does analysis 2302.05225 target?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2302.05225 targets the following physics processes:\n\n- H -> e tau (lepton-flavour-violating Higgs decay)\n- H -> mu tau (lepton-flavour-violating Higgs decay)\n\nThese processes are recorded in the graph as the targets of the analysis.", "answered": true, "papers": ["2302.05225"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2302.05225"], "predicate": "result_targets_process"}, "rows": 2, "error": null, "seconds": 0.017}], "sets": {}, "entity_ids": ["hepkg:process:h_to_etau", "hepkg:process:h_to_mutau"], "evidence_ids": ["hepkg:evidence:fead9f49345278dd8dadad23"], "seen_values": ["2302.05225", "decay", "hepkg:process:h_to_etau", "hepkg:process:h_to_mutau", "higgs", "lepton-flavour-violating", "physics_process", "result_targets_process", "tau"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 6989, "completion_tokens": 104, "rounds": 2, "seconds": 4.999203033279628, "error": ""}, "scores": {"seconds": 4.999203033279628, "llm_calls": 2.0, "tokens": 7093.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "retrieved_label_recall": 1.0, "retrieved_entities": 2.0, "mentioned_label_recall": 1.0, "truncation_loss_labels": 0.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 2.0, "evidence_quotes": 1.0}}
