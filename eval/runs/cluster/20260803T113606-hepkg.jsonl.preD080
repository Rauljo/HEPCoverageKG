{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-505f6449", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2109.13808 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2109.13808 uses the following background-estimation methods:\n\n- Asimov dataset for SM expected results\n- Log-normal constraint on nuisance parameters\n- Maximum-likelihood (ML) fit\n- Negative log-likelihood profile scan with confidence intervals\n- Parameter morphing for coupling interpolation/extrapolation\n- Simultaneous SR+CR maximum-likelihood fit\n\nThese methods are recorded in the graph as the statistical methods used in the analysis.", "answered": true, "papers": ["2103.06956", "2109.13808"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2109.13808"], "predicate": "result_uses_statistical_method"}, "rows": 6, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:statmethod:asimov_dataset", "hepkg:statmethod:lognormal_np_constraint", "hepkg:statmethod:ml_fit", "hepkg:statmethod:nll_profile_scan", "hepkg:statmethod:parameter_morphing", "hepkg:statmethod:simultaneous_sr_cr_fit"], "evidence_ids": ["hepkg:evidence:1725617b46d366128bd64020", "hepkg:evidence:18957ac592da7142a7c601a3", "hepkg:evidence:1c2377ad8baff3e623480138", "hepkg:evidence:74d9c8d6cf592aad0b69a33b", "hepkg:evidence:80fee5bdea3142b53af1b1d3", "hepkg:evidence:8d5d82e3b9f25851d245a17d", "hepkg:evidence:a4e25bec2bdf49313780ee85", "hepkg:evidence:ba590f8ffb71028c4bf77953", "hepkg:evidence:f94179816e2762688ed8fe8b"], "seen_values": ["2109.13808", "asimov", "confidence", "constraint", "coupling", "dataset", "expected", "extrapolation", "fit", "for", "hepkg:statmethod:asimov_dataset", "hepkg:statmethod:lognormal_np_constraint", "hepkg:statmethod:ml_fit", "hepkg:statmethod:nll_profile_scan", "hepkg:statmethod:parame