{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-6407a4ca", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many distinct generators does analysis 2110.11231 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2110.11231 uses four distinct generators: MCFM v7.0, MadGraph5_aMC@NLO, POWHEG 2.0, and Pythia 8.", "answered": true, "papers": ["2004.04545", "2009.04363", "2012.03799", "2012.08600", "2103.06956", "2106.14246", "2107.12553", "2110.11231", "2112.00895", "2112.03161", "2202.08676", "2206.09466", "2208.12095", "2209.07327", "2302.05225", "2309.14442", "2401.05299", "2401.07090", "2402.08486", "2404.06204", "2405.18661", "2408.03744", "2504.13081", "2506.13565", "2508.13900", "2509.22535", "2510.07527", "2511.11853", "2602.18611", "2604.21670", "2604.27044", "2605.14245"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2110.11231"], "predicate": "sample_uses_generator"}, "rows": 4, "error": null, "seconds": 0.04}], "sets": {}, "entity_ids": ["hepkg:generator:madgraph5-amcatnlo", "hepkg:generator:mcfm", "hepkg:generator:powheg", "hepkg:generator:pythia8"], "evidence_ids": ["hepkg:evidence:3a95148e440fb775eb893f20", "hepkg:evidence:7cf094eee335e47e8c63c0d0", "hepkg:evidence:bbe74b410fa3c28e5f73ea6c", "hepkg:evidence:bf68fa718310c28728039ce3", "hepkg:evidence:f9074c64abeb1aea20b38d45"], "seen_values": ["2", "2.0", "2110.11231", "7", "7.0", "8", "generator", "hepkg:generator:madgraph5-amcatnlo", "hepkg:generator:mcfm", "hepkg:generator:powheg", "hepkg:generator:pythia8", "madgraph5_amc", "mcfm", "nlo", "powheg", "pythia", "sample_uses_generator"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7099, "completion_tokens": 166, "rounds": 2, "seconds": 7.919629656709731, "error": ""}, "scores": {"seconds": 7.919629656709731, "llm_calls": 2.0, "tokens": 7265.0, "rounds": 2.0