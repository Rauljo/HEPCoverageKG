{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-4c655151", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2303.15340 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2303.15340 uses three statistical methods:\n\n1. $\\chi^2$ compatibility test between measured and predicted differential cross-sections\n2. Bootstrapping pseudo-experiment method for validation and covariance-matrix construction\n3. Log-likelihood fit solving simultaneously for $t\\bar{t}$ cross-section and combined selection/$b$-tagging efficiency\n\nThese methods are recorded in the graph as being used in this analysis.", "answered": true, "papers": ["2302.05225", "2303.15340"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2303.15340"], "predicate": "result_uses_statistical_method"}, "rows": 3, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:method:bootstrapping_pseudo_experiments", "hepkg:method:chi2_compatibility_test", "hepkg:method:log_likelihood_fit"], "evidence_ids": ["hepkg:evidence:8674637e19b59fe15ff7fa00", "hepkg:evidence:8fb646ca0422bdb12930988e", "hepkg:evidence:fd1946ebf7775001e4eb7640"], "seen_values": ["-tagging", "2", "2303.1534", "2303.15340", "and", "bar", "between", "bootstrapping", "chi", "combined", "compatibility", "construction", "covariance-matrix", "cross-section", "cross-sections", "differential", "efficiency", "fit", "for", "hepkg:method:bootstrapping_pseudo_experiments", "hepkg:method:chi2_compatibility_test", "hepkg:method:log_likelihood_fit", "log-likelihood", "measured", "method", "predicted", "pseudo-experiment", "result_uses_statistical_method", "selection", "simultaneously", "solving", "statistical_method", "test", "validation"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7093, "completion_tokens"