{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-9c2f9595", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which statistical methods does analysis 2506.13565 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2506.13565 uses the following statistical methods:\n\n- Bayesian 95% CL upper limit setting with CMS Combine tool\n- Binned template-based likelihood construction in dilepton mass bins\n- Chi-square goodness-of-fit test for lepton flavor ratio\n- Simultaneous background-only maximum-likelihood fit\n- TUnfold bin-by-bin migration correction for lepton flavor ratio measurement\n\nThese methods are documented in the paper.", "answered": true, "papers": ["2506.13565"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2506.13565"], "predicate": "result_uses_statistical_method"}, "rows": 5, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:method:background-only-ml-fit", "hepkg:method:bayesian-cl-limits", "hepkg:method:binned-template-likelihood", "hepkg:method:chi2-test-flavor-ratio", "hepkg:method:tunfold-unfolding"], "evidence_ids": ["hepkg:evidence:0bb6c664d3d4d1cbc337960d", "hepkg:evidence:1de5cd05d6d6c74903febdaf", "hepkg:evidence:6140b9727fcbd4b8da580bd4", "hepkg:evidence:630803c5064a033812dd2c66", "hepkg:evidence:af0ad92e73094f399b168021", "hepkg:evidence:d4563f7adab4e7652995d48f", "hepkg:evidence:f789e55eb8a6334759552f30", "hepkg:evidence:f9c344cac1472515aa35b415", "hepkg:evidence:fae5ca64cb888ff3ed5ea1e3"], "seen_values": ["2506.13565", "95", "background-only", "bayesian", "bin-by-bin", "binned", "bins", "chi-square", "cms", "combine", "construction", "correction", "dilepton", "fit", "flavor", "for", "goodness-of-fit", "hepkg:method:background-only-ml-fit", "hepkg:method:bayesian-cl-limits", "hepkg:method:binned-template-likelihood", "hepkg:method:chi2-test-flavor-ratio", "hepkg:met