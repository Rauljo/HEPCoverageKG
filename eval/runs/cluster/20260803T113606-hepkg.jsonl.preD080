{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-7202565c", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2207.12246 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2207.12246 uses 10 statistical methods, including binned profile likelihood fit, bootstrap method, data-driven closure test, tag-and-probe method, iterative unfolding, offset method, SVD unfolding cross-check, statistical covariance matrix, and statistical-uncertainties-only fit cross-check.", "answered": true, "papers": ["2004.14060", "2112.00895", "2207.12246", "2401.07090", "2408.03744"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2207.12246"], "predicate": "result_uses_statistical_method"}, "rows": 9, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:method:bootstrap", "hepkg:method:data_driven_closure_test", "hepkg:method:iterative_unfolding", "hepkg:method:offset_method", "hepkg:method:profile_likelihood_fit", "hepkg:method:statistical_covariance_matrix", "hepkg:method:statistical_only_fit_crosscheck", "hepkg:method:svd_unfolding_crosscheck", "hepkg:method:tag_and_probe"], "evidence_ids": ["hepkg:evidence:1317d7d2c6c611aaace030d6", "hepkg:evidence:1578aa9dc2336a52155e9e02", "hepkg:evidence:1c8cfbd4340b8ff538b96bbc", "hepkg:evidence:203ba808dd140c90a5a69b6e", "hepkg:evidence:45a7526671c7e7443c298946", "hepkg:evidence:83ad426b1ab955eec1737ae7", "hepkg:evidence:b7e87574bb16c7ce8a20e50e", "hepkg:evidence:d9facb55e16feeae7e986619", "hepkg:evidence:de26b2ac26abfb58dcbbfb8d"], "seen_values": ["2207.12246", "and", "background-only", "bias", "binned", "bootstrap", "closure", "covariance", "cross-check", "data-driven", "decomposition", "determination", "discovery", "dynamically-stabilized", "efficiency", "evaluation", "exclusion", "fit", "fits", "for", "from", "hepkg:method:bootstr