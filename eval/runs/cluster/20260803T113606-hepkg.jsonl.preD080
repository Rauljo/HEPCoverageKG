{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-cbda1551", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many simulated samples does analysis 2503.19420 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2503.19420 uses 16 simulated samples:\n\n- $VVV$ triboson\n- $V\\gamma$ (V + photon)\n- $WZ/ZZ/V\\gamma^{*}$ diboson\n- $Wt$\n- $Z/\\gamma^{*}$ (Z+jets)\n- $gg \\to WW/ZZ$\n- $gg \\to ZH$\n- $q\\bar{q} \\to WH$\n- $q\\bar{q} \\to ZH$\n- $tWZ$\n- $tZ$\n- $t\\bar{t}$\n- $t\\bar{t}H$\n- $t\\bar{t}V$\n- EW $WWqq$\n- VBF Higgs boson\n- ggF Higgs boson\n\nThis list is based on the information recorded in the graph for this analysis.", "answered": true, "papers": ["2106.01676", "2109.13808", "2112.03161", "2209.07327", "2211.08028", "2302.05225", "2503.19420", "2508.13900"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2503.19420"], "predicate": "result_uses_sample"}, "rows": 17, "error": null, "seconds": 0.044}], "sets": {}, "entity_ids": ["hepkg:sample:gg-vv", "hepkg:sample:gg-zh", "hepkg:sample:ggf-h", "hepkg:sample:qq-wh", "hepkg:sample:qq-zh", "hepkg:sample:ttbar", "hepkg:sample:tth", "hepkg:sample:ttv", "hepkg:sample:twz", "hepkg:sample:tz", "hepkg:sample:vbf-h", "hepkg:sample:vgamma-sherpa", "hepkg:sample:vv-sherpa", "hepkg:sample:vvv", "hepkg:sample:wt", "hepkg:sample:wwqq", "hepkg:sample:zjets"], "evidence_ids": ["hepkg:evidence:0bdbf44013b5a8aed80cd9c1", "hepkg:evidence:1aef5a2e020e1df7c1325ee3", "hepkg:evidence:3fb4e9c231b055d0d4693033", "hepkg:evidence:5226ee3179bcbcbe06122d98", "hepkg:evidence:6b8bba4dc443b4d854b69c42", "hepkg:evidence:91e0cad79595d663398e82ff", "hepkg:evidence:9e9efb1b280c6caebcf2c2bc", "hepkg:evidence:a40410055625f6e469cf8d70", "hepkg:evidence:cd16d3727b5ffb01cabc85c0", "hepkg:evidence:d0f332b46870c4dd29382d41", "hepkg:evidence:d54988c1ff612d78d73a6533", "hepkg:evidence:d759e