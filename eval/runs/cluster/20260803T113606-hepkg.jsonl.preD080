{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-e80486cd", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2009.04363 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2009.04363 uses 6 statistical methods: Asymptotic CLs criterion for upper limits, Barlow-Beeston lite technique for binwise statistical uncertainty modeling, Binned maximum likelihood fit with log-normal constrained nuisance parameters, Discrete profiling method for background function choice, Fisher test for determining polynomial order, and Profile likelihood ratio test statistic.", "answered": true, "papers": ["2009.04363", "2206.09466", "2604.27044"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2009.04363"], "predicate": "result_uses_statistical_method"}, "rows": 6, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:method:asymptotic-cls", "hepkg:method:barlow-beeston-lite", "hepkg:method:binned-maximum-likelihood-fit", "hepkg:method:discrete-profiling-method", "hepkg:method:fisher-test-polynomial-order", "hepkg:method:profile-likelihood-ratio"], "evidence_ids": ["hepkg:evidence:2442bc4d5e4bc49c21f3afea", "hepkg:evidence:29cee07ea7f17f61321d7668", "hepkg:evidence:926b41a3f4612938c5c69bea", "hepkg:evidence:bb9b76373df128a42a84aca3", "hepkg:evidence:c6f25cf894309ed534a6ed9e"], "seen_values": ["2009.04363", "asymptotic", "background", "barlow-beeston", "binned", "binwise", "choice", "cls", "constrained", "criterion", "determining", "discrete", "fisher", "fit", "for", "function", "hepkg:method:asymptotic-cls", "hepkg:method:barlow-beeston-lite", "hepkg:method:binned-maximum-likelihood-fit", "hepkg:method:discrete-profiling-method", "hepkg:method:fisher-test-polynomial-order", "hepkg:method:profile-likelihood-ratio", "likelihood", "limits", "lite", "log-normal", "maximum", "method