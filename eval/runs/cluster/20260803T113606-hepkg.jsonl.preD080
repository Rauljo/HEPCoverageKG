{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-d1eb03ef", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2012.08600 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2012.08600 uses the following background-estimation methods:\n\n1. Background-only fit to control-region data used to determine DY+jets normalization in slepton search regions.\n2. Binned Poisson likelihood construction across signal regions with log-normal constrained nuisance parameters for background-only and signal+background hypotheses.\n3. Free-floating signal and background normalization in fits including control regions to account for signal contamination.\n4. Global significance estimation via -2lnQ test statistic compared against background-only pseudo-experiments (look-elsewhere effect correction).\n5. Modified frequentist CLs approach with asymptotic profile likelihood test statistic for 95% CL upper limits.\n6. R_SF/DF treated as a nuisance parameter with Gaussian prior constraint in the edge fit.\n7. Simultaneous unbinned maximum likelihood fit to \\( m_{ll} \\) distribution in \\( e^+e^-, \\mu^+\\mu^-, e^\\pm\\mu^\\mp \\) samples to search for a kinematic edge.\n\nThese methods are documented in the analysis 2012.08600.", "answered": true, "papers": [], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2012.08600"], "predicate": "result_uses_statistical_method"}, "rows": 7, "error": null, "seconds": 0.03}], "sets": {}, "entity_ids": [], "evidence_ids": ["hepkg:evidence:0ddbded3fe0500b44656ee43", "hepkg:evidence:266e7e6df007a44d4813ce8e", "hepkg:evidence:878a5d193eeb1e5c47d25cd0", "hepkg:evidence:8e42c69c1ff9326c9477347c", "hepkg:evidence:965d1d3dac5befa5132c8f27", "hepkg:evidence:b107f63100c3676eeb94ed22", "hepkg:evidence:c2e25ccff643de555777e19c", "hepkg:evidence:ca27fc30dc57bf261d1f5d4a"], "seen_values": ["-2lnq", "-mu-", "2012.086", "2012.08600", "95", "account", "across", "against", "and", "approach", "asymptotic", "background", "background-only", "binned", "cls", "compared", "constrained", "constraint", "construction", "contamination", "control", "control-region", "correction", "data", "determine", "distribution", "edge", "effect", "estimation", "fit", "fits", "for", "free-floating", "frequentist", "gaussian", "global", "hypotheses", "including", "jets", "kinematic", "likelihood", "limits", "log-normal", "look-elsewhere", "m_ll", "maximum", "method", "modified", "mu-", "none", "normalization", "nuisance", "parameter", "parameters", "poisson", "prior", "profile", "pseudo-experiments", "r_sf", "regions", "result_uses_statistical_method", "samples", "search", "signal", "significance", "simultaneous", "slepton", "statistic", "test", "the", "treated", "unbinned", "upper", "used", "via", "with"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7354, "completion_tokens": 272, "rounds": 2, "seconds": 11.797332188114524, "error": ""}, "scores": {"seconds": 11.797332188114524, "llm_calls": 2.0, "tokens": 7626.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "retrieved_label_recall": 0.0, "retrieved_entities": 0.0, "mentioned_label_recall": 0.0, "truncation_loss_labels": 0.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 0.0, "evidence_quotes": 8.0}}
