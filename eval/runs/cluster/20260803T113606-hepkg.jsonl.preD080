{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-c79b2cae", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2102.01444 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2102.01444 uses the following background-estimation methods:\n\n- CLs method for deriving exclusion confidence levels\n- Fit performed with standard minimisation software, floating background normalisations with MC-derived shapes\n- Likelihood constructed as product of Poisson pdfs (observed yields per CR/SR) and Gaussian pdfs for nuisance parameters\n- Model-independent hypothesis test introducing a free signal strength constrained by observed SR yield\n- Pseudo-experiments used to compute expected/observed limits and discovery p-values\n- Simultaneous likelihood fit using HistFitter and pyhf minimisation packages\n- Simultaneous profile likelihood fit in dedicated background control regions\n\nThese methods are described in the paper as part of the statistical analysis and background estimation procedures.", "answered": true, "papers": [], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2102.01444"], "predicate": "result_uses_statistical_method"}, "rows": 7, "error": null, "seconds": 0.031}], "sets": {}, "entity_ids": [], "evidence_ids": ["hepkg:evidence:071a0012f7b999dffe712de7", "hepkg:evidence:086b8f62840c2b2899756603", "hepkg:evidence:41e414d43e32578bac7ff1b7", "hepkg:evidence:615643a033a20f0c7a65843f", "hepkg:evidence:b3e803d54c7f33a5b9590b9f", "hepkg:evidence:c6463fc73dd197dd2881bc7f", "hepkg:evidence:d915d341ab851e7c778ef15e", "hepkg:evidence:e7ee9948dc4cb0152b634b94"], "seen_values": ["2102.01444", "and", "background", "cls", "compute", "confidence", "constrained", "constructed", "control", "dedicated", "deriving", "discovery", "exclusion", "expected", "fit", "floating", "for", "free", "gaussian", "histfitter", "hypothesis", "introducing", "levels", "likelihood", "limits", "mc-derived", "method", "minimisation", "model-independent", "none", "normalisations", "nuisance", "observed", "p-values", "packages", "parameters", "pdfs", "per", "performed", "poisson", "product", "profile", "pseudo-experiments", "pyhf", "regions", "result_uses_statistical_method", "shapes", "signal", "simultaneous", "software", "standard", "strength", "test", "used", "using", "with", "yield", "yields"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7285, "completion_tokens": 201, "rounds": 2, "seconds": 9.046735164243728, "error": ""}, "scores": {"seconds": 9.046735164243728, "llm_calls": 2.0, "tokens": 7486.0, "rounds": 2.0, "errored": 0.0, "answered": 1.0, "abstained": 0.0, "refused_in_text": 0.0, "refusal_flag_disagrees": 0.0, "faithfulness": 1.0, "unsupported_claims": 0.0, "retrieved_label_recall": 0.0, "retrieved_entities": 0.0, "mentioned_label_recall": 0.0, "truncation_loss_labels": 0.0, "tool_calls": 1.0, "tool_errors": 0.0, "tool_error_rate": 0.0, "retrieved_first": 1.0, "entities_retrieved": 0.0, "evidence_quotes": 8.0}}
