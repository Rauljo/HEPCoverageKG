{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-89f3a99d", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which background-estimation methods does analysis 2012.03799 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "Analysis 2012.03799 uses the following background-estimation methods:\n\n- Asimov Z significance formula for signal-region optimisation and observed excess quantification\n- Background-only simultaneous likelihood fit to control regions (and signal regions) with normalisation factors\n- CLs prescription for exclusion limit setting\n- Profile-likelihood-ratio test for background-only hypothesis (p0, Z significance)\n\nThese methods are used to estimate and quantify backgrounds in the analysis.", "answered": true, "papers": ["2012.03799"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2012.03799"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.032}], "sets": {}, "entity_ids": ["hepkg:statmethod:background-only-likelihood-fit", "hepkg:statmethod:cls-prescription", "hepkg:statmethod:profile-likelihood-ratio-test", "hepkg:statmethod:z-significance"], "evidence_ids": ["hepkg:evidence:2e6cd8abc148c4d23d5d0009", "hepkg:evidence:4670a83ce1edbb2a7f4ab411", "hepkg:evidence:735214fde14f5231f872cdc8", "hepkg:evidence:77fabef1b139adf90524feee", "hepkg:evidence:cdf2073ab3a73cc2c72caab8"], "seen_values": ["0", "2012.03799", "and", "asimov", "background-only", "cls", "crs", "excess", "exclusion", "factors", "fit", "for", "formula", "hepkg:statmethod:background-only-likelihood-fit", "hepkg:statmethod:cls-prescription", "hepkg:statmethod:profile-likelihood-ratio-test", "hepkg:statmethod:z-significance", "hypothesis", "likelihood", "limit", "normalisation", "observed", "optimisation", "prescription", "profile-likelihood-ratio", "quantification", "result_uses_statistical_method", "sett