{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-66d0a558", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "How many statistical methods does analysis 2307.01094 use?", "shape": "count", "split": "dev", "needs": ["sql"], "difficulty": "medium", "answer": {"text": "Analysis 2307.01094 uses 6 statistical methods: Asymptotic approximation for CL$_{s}$ computation in model-dependent fits, CL$_{s}$ method for exclusion, Multi-bin (shape) fit of signal-region observables, Profile likelihood background-only fit, Pseudo-experiments used to evaluate model-independent limits, and Toy-experiment cross-check of asymptotic CL$_{s}$ results.", "answered": true, "papers": ["2205.05120", "2207.00348", "2307.01094"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2307.01094"], "predicate": "result_uses_statistical_method"}, "rows": 6, "error": null, "seconds": 0.037}], "sets": {}, "entity_ids": ["hepkg:statmethod:asymptotic-approximation", "hepkg:statmethod:cls-method", "hepkg:statmethod:multi-bin-fit", "hepkg:statmethod:profile-likelihood-fit", "hepkg:statmethod:pseudo-experiments", "hepkg:statmethod:toy-experiments-crosscheck"], "evidence_ids": ["hepkg:evidence:0958339195e7d48c5cf046fd", "hepkg:evidence:1ad6124c7442cbd05dc48bc8", "hepkg:evidence:2435fe9ad5982565b07efc29", "hepkg:evidence:49e7cd72cec0a47440e9dcea", "hepkg:evidence:916662a37db9e289033deca8", "hepkg:evidence:b3be86c9d92a7d1d4919c796", "hepkg:evidence:f31350b84ad28e0816e6ad83"], "seen_values": ["2307.01094", "approximation", "asymptotic", "background-only", "computation", "cross-check", "evaluate", "exclusion", "fit", "fits", "for", "hepkg:statmethod:asymptotic-approximation", "hepkg:statmethod:cls-method", "hepkg:statmethod:multi-bin-fit", "hepkg:statmethod:profile-likelihood-fit", "hepkg:statmethod:pseudo-experiments", "hepkg:statmethod:toy-experiments-crosscheck", "likelihood", "limits", "method", "model-dependent", "