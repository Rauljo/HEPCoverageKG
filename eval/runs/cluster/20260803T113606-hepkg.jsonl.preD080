{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-793abda9", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which backgrounds does analysis 2006.05880 estimate?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2006.05880 estimates the following backgrounds:\n\n- Fake/non-prompt (FNP) lepton background\n- Multi-boson (mainly WZ) background (3-lepton selection)\n- Other subdominant SM backgrounds (e.g., tZ, tWZ, ttW, tth, ttWW, tttt, ttt, Wh, Zh, single top, diboson in 1l)\n- ttZ background (3-lepton selection)\n- ttbar background (1-lepton selection)\n\nThese backgrounds are estimated as part of the analysis.", "answered": true, "papers": ["2006.05880"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2006.05880"], "predicate": "result_estimates_background"}, "rows": 5, "error": null, "seconds": 0.036}], "sets": {}, "entity_ids": ["hepkg:background:fnp-lepton", "hepkg:background:multiboson-3l", "hepkg:background:other-subdominant", "hepkg:background:ttZ-3l", "hepkg:background:ttbar-1l"], "evidence_ids": ["hepkg:evidence:5d7c72a7829b7c5c96e0a6a7", "hepkg:evidence:93d7c4176840f035c5e4a107", "hepkg:evidence:cadbe22cb251103849f05044", "hepkg:evidence:d0c68a8ca62d4101e860c2b9"], "seen_values": ["-lepton", "1", "2006.0588", "2006.05880", "3", "background", "backgrounds", "diboson", "fake", "fnp", "hepkg:background:fnp-lepton", "hepkg:background:multiboson-3l", "hepkg:background:other-subdominant", "hepkg:background:ttbar-1l", "hepkg:background:ttz-3l", "lepton", "mainly", "multi-boson", "non-prompt", "other", "result_estimates_background", "selection", "single", "subdominant", "top", "ttbar", "tth", "ttt", "tttt", "ttw", "ttww", "ttz", "twz"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens": 7213, "completion_tokens": 168, "rounds": 2, "seconds": 7.978707526810467, "error": ""}, "sco