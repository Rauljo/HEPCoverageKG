{"run_id": "20260803T113606-hepkg", "qid": "gen-paper-8d9f908d", "repeat": 0, "system": "hepkg", "config_hash": "b29c4f777113", "git_sha": "6945b02-dirty", "question": "Which statistical methods does analysis 2111.08340 use?", "shape": "set", "split": "dev", "needs": ["sql"], "difficulty": "easy", "answer": {"text": "The analysis 2111.08340 uses the following statistical methods:\n\n- Beeston-Barlow \"lite\" technique for limited MC sample-size statistical uncertainties\n- Binned maximum-likelihood (global likelihood) fit using RooStats\n- CLs method for upper limit derivation\n- Log-likelihood ratio (LLR) test based on Wilks' theorem\n\nThese methods are recorded in the graph as being used in this analysis.", "answered": true, "papers": ["2111.08340", "2312.04450", "2401.05299"], "value": null, "steps": [{"round": 1, "tool": "contents_of", "args": {"paper_ids": ["2111.08340"], "predicate": "result_uses_statistical_method"}, "rows": 4, "error": null, "seconds": 0.032}], "sets": {}, "entity_ids": ["hepkg:method:beeston-barlow-lite", "hepkg:method:cls-limit", "hepkg:method:global-likelihood-fit", "hepkg:method:llr-wilks-test"], "evidence_ids": ["hepkg:evidence:0644b290e931ba2c64ed5eaf", "hepkg:evidence:278b026616ea9f43ee61d338", "hepkg:evidence:5031ae4fd39bdc3018dce6f1", "hepkg:evidence:54d2db6f0472fea704474779", "hepkg:evidence:8f5210bd195d0bb5652f6a27"], "seen_values": ["2111.0834", "2111.08340", "based", "beeston-barlow", "binned", "cls", "derivation", "fit", "for", "global", "hepkg:method:beeston-barlow-lite", "hepkg:method:cls-limit", "hepkg:method:global-likelihood-fit", "hepkg:method:llr-wilks-test", "likelihood", "limit", "limited", "lite", "llr", "log-likelihood", "maximum-likelihood", "method", "ratio", "result_uses_statistical_method", "roostats", "sample-size", "statistical", "statistical_method", "technique", "test", "theorem", "uncertainties", "upper", "using", "wilks"], "verification_score": 1.0, "unsupported_claims": [], "llm_calls": 2, "prompt_tokens"