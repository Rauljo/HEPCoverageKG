ulted": 0, "calls": 4, "errors": 0, "tail_keep_rate": 0.0, "dropped": [{"id": "hepkg:observable:sigma-h-fiducial", "why": "This is a fiducial cross section, which is more specific and not the total cross section."}, {"id": "hepkg:observable:sigma-wh-brww-total", "why": "This is a specific process (WH) and includes branching fractions, making it more specific than the total cross section."}, {"id": "hepkg:observable:sigma-vh-brww-total", "why": "This is a specific process (VH) and includes branching fractions, making it more specific than the total cross section."}, {"id": "hepkg:observable:sigma-zh-brww-total", "why": "This is a specific process (ZH) and includes branching fractions, making it more specific than the total cross section."}, {"id": "hepkg:observable:wz-total-xsec", "why": "This is a total cross section for a different process (pp->WZ), not Higgs production."}, {"id": "hepkg:observable:sigma-wc-particle-inclusive", "why": "This is a fiducial cross section for a different process (W+c), not Higgs production."}, {"id": "hepkg:observable:sigma-h-differential", "why": "This is a differential cross section, which is more specific and not the total cross section."}, {"id": "hepkg:observable:ratio_el_tot", "why": "This is a ratio involving the total cross section, but it is not the total cross section itself."}, {"id": "hepkg:observable:sigma-wc-parton-inclusive", "why": "This is a fiducial cross section for a different process (W+c), not Higgs production."}, {"id": "hepkg:observable:hh_incl_signal_strength", "why": "This is a signal strength, which is a ratio of cross sections, not the total cross section itself."}, {"id": "hepkg:observable:diff_xsec_pt_h", "why": "This is a differential fiducial cross section, which is more specific and not the total cross section."}, {"id": "hepkg:observable:tot_xsec_z", "why": "This is a total cross section for a different process (Z) and includes branching fractions, making it more specific than the total cross section."