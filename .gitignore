__pycache__/
*.pyc
.venv/
.env
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
*.db
.DS_Store

# Sync check: laptop -> GitHub -> DIAS (2026-07-28T22:48Z)

# Backups of .env -- the original is ignored, and so must its copies be.
# "git add -A" swept .env.bak into commit 1bf7723 on 2026-07-31 because only
# ".env" was listed here.
.env.*
!.env.example

# Evaluation runs: large, regenerable. Summaries (.summary.json) are kept.
eval/runs/*.jsonl

# Reference-reader output, same reasoning: one record per (question, paper) with
# every verdict and raw reply, so a full sweep is tens of MB. The .meta.json
# summary is small and IS kept — it carries the model, repeats and the
# yes/no/split counts a result has to be read against.
eval/reader/*.jsonl

# Slurm job logs. They live only on DIAS, they are large, and `git add -A`
# there swept 316 of them into a branch -- after which `git checkout main`
# deleted the directory out from under the job scripts, which write into it
# and fail in one second if it is missing (54209-12, 2026-09-05).
/logs/

# Personal project notes and agent instructions: not part of the public code.
vault/
CLAUDE.md
.claude/
